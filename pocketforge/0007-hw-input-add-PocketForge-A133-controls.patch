index 0000000..424c022
--- /dev/null
+++ b/tests/qtest/pocketforge-a133-input-test.c
@@ -0,0 +1,393 @@
+/*
+ * QTest coverage for the PocketForge A133 virtual input device
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/bswap.h"
+#include "libqtest.h"
+#include "libqos/libqos-malloc.h"
+#include "libqos/virtio-mmio.h"
+#include "qapi/qmp/qdict.h"
+
+#include "standard-headers/linux/input.h"
+#include "standard-headers/linux/virtio_config.h"
+#include "standard-headers/linux/virtio_ids.h"
+#include "standard-headers/linux/virtio_input.h"
+
+#define PF_A133_INPUT_MMIO_BASE 0x0a000200
+#define PF_A133_RAM_BASE 0x40000000
+#define PF_A133_RAM_END  0x41000000
+#define PF_A133_INPUT_PATH "/machine/pocketforge-input"
+#define VIRTIO_MMIO_QUEUE_READY     0x044
+#define VIRTIO_MMIO_QUEUE_DESC_LOW  0x080
+#define VIRTIO_MMIO_QUEUE_DESC_HIGH 0x084
+#define VIRTIO_MMIO_QUEUE_AVAIL_LOW 0x090
+#define VIRTIO_MMIO_QUEUE_AVAIL_HIGH 0x094
+#define VIRTIO_MMIO_QUEUE_USED_LOW  0x0a0
+#define VIRTIO_MMIO_QUEUE_USED_HIGH 0x0a4
+typedef struct InputFixture {
+    QTestState *qts;
+    QVirtioMMIODevice mmio;
+    QGuestAllocator alloc;
+    QVirtQueue *vq;
+} InputFixture;
+
+typedef struct EventBuffers {
+    uint64_t addr[2];
+    uint32_t head[2];
+} EventBuffers;
+
+typedef struct ControlCase {
+    const char *name;
+    uint16_t type;
+    uint16_t code;
+    int32_t pressed;
+} ControlCase;
+
+static const ControlCase controls[] = {
+    { "dpad-up", EV_ABS, ABS_HAT0Y, -1 },
+    { "dpad-down", EV_ABS, ABS_HAT0Y, 1 },
+    { "dpad-left", EV_ABS, ABS_HAT0X, -1 },
+    { "dpad-right", EV_ABS, ABS_HAT0X, 1 },
+    { "l1", EV_KEY, BTN_TL, 1 },
+    { "r1", EV_KEY, BTN_TR, 1 },
+    { "menu", EV_KEY, BTN_MODE, 1 },
+};
+
+static QVirtQueue *setup_modern_queue(InputFixture *f, uint16_t index)
+{
+    QVirtQueue *vq = g_new0(QVirtQueue, 1);
+    uint64_t addr;
+
+    vq->vdev = &f->mmio.vdev;
+    vq->index = index;
+    vq->align = 4096;
+    qtest_writel(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 QVIRTIO_MMIO_QUEUE_SEL, index);
+    vq->size = qtest_readl(f->qts, PF_A133_INPUT_MMIO_BASE +
+                           QVIRTIO_MMIO_QUEUE_NUM_MAX);
+    g_assert_cmpuint(vq->size, >, 0);
+    vq->num_free = vq->size;
+    qtest_writel(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 QVIRTIO_MMIO_QUEUE_NUM, vq->size);
+
+    addr = guest_alloc(&f->alloc, qvring_size(vq->size, vq->align));
+    qvring_init(f->qts, &f->alloc, vq, addr);
+    qtest_writel(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 VIRTIO_MMIO_QUEUE_DESC_LOW, vq->desc);
+    qtest_writel(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 VIRTIO_MMIO_QUEUE_DESC_HIGH, vq->desc >> 32);
+    qtest_writel(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 VIRTIO_MMIO_QUEUE_AVAIL_LOW, vq->avail);
+    qtest_writel(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 VIRTIO_MMIO_QUEUE_AVAIL_HIGH, vq->avail >> 32);
+    qtest_writel(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 VIRTIO_MMIO_QUEUE_USED_LOW, vq->used);
+    qtest_writel(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 VIRTIO_MMIO_QUEUE_USED_HIGH, vq->used >> 32);
+    qtest_writel(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 VIRTIO_MMIO_QUEUE_READY, 1);
+    return vq;
+}
+
+static void input_fixture_init(InputFixture *f, bool setup_queue)
+{
+    uint64_t features;
+
+    memset(f, 0, sizeof(*f));
+    f->qts = qtest_init("-machine pocketforge-a133 -nodefaults");
+    g_assert_cmphex(qtest_readl(f->qts, PF_A133_INPUT_MMIO_BASE +
+                               QVIRTIO_MMIO_DEVICE_ID), ==, VIRTIO_ID_INPUT);
+
+    qvirtio_mmio_init_device(&f->mmio, f->qts,
+                             PF_A133_INPUT_MMIO_BASE, 4096);
+    qvirtio_start_device(&f->mmio.vdev);
+    features = qvirtio_get_features(&f->mmio.vdev);
+    features &= ~(QVIRTIO_F_BAD_FEATURE |
+                  BIT_ULL(VIRTIO_RING_F_INDIRECT_DESC) |
+                  BIT_ULL(VIRTIO_RING_F_EVENT_IDX) |
+                  BIT_ULL(VIRTIO_F_RING_PACKED));
+    qvirtio_set_features(&f->mmio.vdev, features);
+
+    if (setup_queue) {
+        alloc_init(&f->alloc, ALLOC_NO_FLAGS, PF_A133_RAM_BASE,
+                   PF_A133_RAM_END, 4096);
+        f->vq = setup_modern_queue(f, 0);
+        qvirtio_set_driver_ok(&f->mmio.vdev);
+    }
+}
+
+static void input_fixture_destroy(InputFixture *f)
+{
+    qvirtio_reset(&f->mmio.vdev);
+    if (f->vq) {
+        qvirtqueue_cleanup(f->mmio.vdev.bus, f->vq, &f->alloc);
+        alloc_destroy(&f->alloc);
+    }
+    qtest_quit(f->qts);
+}
+
+static void select_config(InputFixture *f, uint8_t select, uint8_t subsel)
+{
+    qtest_writeb(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 QVIRTIO_MMIO_DEVICE_SPECIFIC, select);
+    qtest_writeb(f->qts, PF_A133_INPUT_MMIO_BASE +
+                 QVIRTIO_MMIO_DEVICE_SPECIFIC + 1, subsel);
+}
+
+static uint8_t config_readb(InputFixture *f, uint64_t offset)
+{
+    return qtest_readb(f->qts, PF_A133_INPUT_MMIO_BASE +
+                       QVIRTIO_MMIO_DEVICE_SPECIFIC + offset);
+}
+
+static uint16_t config_readw(InputFixture *f, uint64_t offset)
+{
+    return qtest_readw(f->qts, PF_A133_INPUT_MMIO_BASE +
+                       QVIRTIO_MMIO_DEVICE_SPECIFIC + offset);
+}
+
+static uint32_t config_readl(InputFixture *f, uint64_t offset)
+{
+    return qtest_readl(f->qts, PF_A133_INPUT_MMIO_BASE +
+                       QVIRTIO_MMIO_DEVICE_SPECIFIC + offset);
+}
+
+static void assert_capability(InputFixture *f, uint8_t type, uint16_t code)
+{
+    uint8_t byte;
+
+    select_config(f, VIRTIO_INPUT_CFG_EV_BITS, type);
+    g_assert_cmpuint(config_readb(f, 2), >, code / 8);
+    byte = config_readb(f, 8 + code / 8);
+    g_assert_true(byte & BIT(code % 8));
+}
+
+static void assert_abs_range(InputFixture *f, uint8_t code,
+                             int32_t minimum, int32_t maximum)
+{
+    select_config(f, VIRTIO_INPUT_CFG_ABS_INFO, code);
+    g_assert_cmpuint(config_readb(f, 2), ==,
+                     sizeof(struct virtio_input_absinfo));
+    g_assert_cmpint((int32_t)config_readl(f, 8), ==, minimum);
+    g_assert_cmpint((int32_t)config_readl(f, 12), ==, maximum);
+}
+
+static bool inject(InputFixture *f, const char *event)
+{
+    QDict *response;
+    bool success;
+
+    response = qtest_qmp(f->qts,
+                         "{ 'execute': 'qom-set', 'arguments': {"
+                         " 'path': %s, 'property': 'event', 'value': %s } }",
+                         PF_A133_INPUT_PATH, event);
+    success = qdict_haskey(response, "return");
+    g_assert_true(success || qdict_haskey(response, "error"));
+    if (!success) {
+        QDict *error = qdict_get_qdict(response, "error");
+
+        g_test_message("injection '%s' rejected: %s", event,
+                       qdict_get_str(error, "desc"));
+    }
+    qobject_unref(response);
+    return success;
+}
+
+static EventBuffers add_event_buffers(InputFixture *f)
+{
+    EventBuffers buffers;
+    struct virtio_input_event zero = { 0 };
+    int i;
+
+    for (i = 0; i < 2; i++) {
+        buffers.addr[i] = guest_alloc(&f->alloc, sizeof(zero));
+        qtest_memwrite(f->qts, buffers.addr[i], &zero, sizeof(zero));
+        buffers.head[i] = qvirtqueue_add(f->qts, f->vq, buffers.addr[i],
+                                         sizeof(zero), true, false);
+        qvirtqueue_kick(f->qts, &f->mmio.vdev, f->vq, buffers.head[i]);
+    }
+    return buffers;
+}
+
+static void assert_event_pair(InputFixture *f, const EventBuffers *buffers,
+                              uint16_t type, uint16_t code, int32_t value)
+{
+    struct virtio_input_event event;
+    uint32_t head;
+    uint32_t len;
+
+    g_assert_true(qvirtqueue_get_buf(f->qts, f->vq, &head, &len));
+    g_assert_cmpuint(head, ==, buffers->head[0]);
+    g_assert_cmpuint(len, ==, sizeof(event));
+    qtest_memread(f->qts, buffers->addr[0], &event, sizeof(event));
+    g_assert_cmpuint(le16_to_cpu(event.type), ==, type);
+    g_assert_cmpuint(le16_to_cpu(event.code), ==, code);
+    g_assert_cmpint((int32_t)le32_to_cpu(event.value), ==, value);
+
+    g_assert_true(qvirtqueue_get_buf(f->qts, f->vq, &head, &len));
+    g_assert_cmpuint(head, ==, buffers->head[1]);
+    g_assert_cmpuint(len, ==, sizeof(event));
+    qtest_memread(f->qts, buffers->addr[1], &event, sizeof(event));
+    g_assert_cmpuint(le16_to_cpu(event.type), ==, EV_SYN);
+    g_assert_cmpuint(le16_to_cpu(event.code), ==, SYN_REPORT);
+    g_assert_cmpuint(le32_to_cpu(event.value), ==, 0);
+}
+
+static void test_identity_and_capabilities(void)
+{
+    const uint16_t keys[] = {
+        BTN_SOUTH, BTN_EAST, BTN_NORTH, BTN_WEST, BTN_TL, BTN_TR,
+        BTN_SELECT, BTN_START, BTN_MODE,
+    };
+    const uint16_t axes[] = {
+        ABS_X, ABS_Y, ABS_RX, ABS_RY, ABS_Z, ABS_RZ, ABS_HAT0X, ABS_HAT0Y,
+    };
+    InputFixture f;
+    char name[sizeof("TRIMUI Player1")];
+    int i;
+
+    input_fixture_init(&f, false);
+
+    select_config(&f, VIRTIO_INPUT_CFG_ID_NAME, 0);
+    g_assert_cmpuint(config_readb(&f, 2), ==, sizeof(name));
+    for (i = 0; i < sizeof(name); i++) {
+        name[i] = config_readb(&f, 8 + i);
+    }
+    g_assert_cmpstr(name, ==, "TRIMUI Player1");
+
+    select_config(&f, VIRTIO_INPUT_CFG_ID_DEVIDS, 0);
+    g_assert_cmpuint(config_readw(&f, 8), ==, BUS_USB);
+    g_assert_cmphex(config_readw(&f, 10), ==, 0x045e);
+    g_assert_cmphex(config_readw(&f, 12), ==, 0x028e);
+    g_assert_cmphex(config_readw(&f, 14), ==, 0x0110);
+
+    for (i = 0; i < ARRAY_SIZE(keys); i++) {
+        assert_capability(&f, EV_KEY, keys[i]);
+    }
+    for (i = 0; i < ARRAY_SIZE(axes); i++) {
+        assert_capability(&f, EV_ABS, axes[i]);
+    }
+
+    assert_abs_range(&f, ABS_X, 0, 4095);
+    assert_abs_range(&f, ABS_Y, 0, 4095);
+    assert_abs_range(&f, ABS_RX, 0, 4095);
+    assert_abs_range(&f, ABS_RY, 0, 4095);
+    assert_abs_range(&f, ABS_Z, 0, 255);
+    assert_abs_range(&f, ABS_RZ, 0, 255);
+    assert_abs_range(&f, ABS_HAT0X, -1, 1);
+    assert_abs_range(&f, ABS_HAT0Y, -1, 1);
+
+    input_fixture_destroy(&f);
+}
+
+static void test_ordered_injection(void)
+{
+    InputFixture f;
+    EventBuffers buffers;
+    char *event;
+    int i;
+
+    input_fixture_init(&f, true);
+    g_assert_true(qtest_qom_get_bool(f.qts, PF_A133_INPUT_PATH, "ready"));
+    g_assert_false(inject(&f, "dpad-up:press"));
+
+    buffers = add_event_buffers(&f);
+    g_assert_true(qtest_qom_get_bool(f.qts, PF_A133_INPUT_PATH, "ready"));
+    g_assert_false(qvirtqueue_get_buf(f.qts, f.vq, NULL, NULL));
+    g_assert_false(inject(&f, ""));
+    g_assert_false(inject(&f, "south:press"));
+    g_assert_false(inject(&f, "dpad-up:tap"));
+    g_assert_false(qvirtqueue_get_buf(f.qts, f.vq, NULL, NULL));
+
+    g_assert_true(inject(&f, "dpad-left:press"));
+    assert_event_pair(&f, &buffers, EV_ABS, ABS_HAT0X, -1);
+    g_assert_true(qtest_qom_get_bool(f.qts, PF_A133_INPUT_PATH, "held"));
+
+    buffers = add_event_buffers(&f);
+    g_assert_false(inject(&f, "dpad-right:press"));
+    g_assert_false(inject(&f, "dpad-left:press"));
+    g_assert_true(inject(&f, "dpad-left:release"));
+    assert_event_pair(&f, &buffers, EV_ABS, ABS_HAT0X, 0);
+    g_assert_false(qtest_qom_get_bool(f.qts, PF_A133_INPUT_PATH, "held"));
+    g_assert_false(inject(&f, "dpad-left:release"));
+
+    for (i = 0; i < ARRAY_SIZE(controls); i++) {
+        buffers = add_event_buffers(&f);
+        event = g_strdup_printf("%s:press", controls[i].name);
+        g_assert_true(inject(&f, event));
+        g_free(event);
+        assert_event_pair(&f, &buffers, controls[i].type,
+                          controls[i].code, controls[i].pressed);
+        g_assert_true(qtest_qom_get_bool(f.qts, PF_A133_INPUT_PATH, "held"));
+
+        buffers = add_event_buffers(&f);
+        event = g_strdup_printf("%s:release", controls[i].name);
+        g_assert_true(inject(&f, event));
+        g_free(event);
+        assert_event_pair(&f, &buffers, controls[i].type,
+                          controls[i].code, 0);
+        g_assert_false(qtest_qom_get_bool(f.qts, PF_A133_INPUT_PATH, "held"));
+    }
+
+    input_fixture_destroy(&f);
+}
+
+static void test_reset_and_late_injection(void)
+{
+    InputFixture f;
+    EventBuffers buffers;
+
+    input_fixture_init(&f, true);
+    buffers = add_event_buffers(&f);
+    g_assert_true(inject(&f, "menu:press"));
+    assert_event_pair(&f, &buffers, EV_KEY, BTN_MODE, 1);
+    g_assert_true(qtest_qom_get_bool(f.qts, PF_A133_INPUT_PATH, "held"));
+
+    qvirtio_reset(&f.mmio.vdev);
+    g_assert_false(qtest_qom_get_bool(f.qts, PF_A133_INPUT_PATH, "held"));
+    g_assert_false(qtest_qom_get_bool(f.qts, PF_A133_INPUT_PATH, "ready"));
+    g_assert_false(inject(&f, "menu:release"));
+
+    qvirtqueue_cleanup(f.mmio.vdev.bus, f.vq, &f.alloc);
+    f.vq = NULL;
+    alloc_destroy(&f.alloc);
+    qtest_quit(f.qts);
+}
+
+static void test_no_device(void)
+{
+    QTestState *qts;
+    QDict *response;
+
+    qts = qtest_init("-machine pocketforge-a133,pocketforge-input-device=off "
+                     "-nodefaults");
+    g_assert_cmphex(qtest_readl(qts, PF_A133_INPUT_MMIO_BASE +
+                               QVIRTIO_MMIO_DEVICE_ID), ==, 0);
+    response = qtest_qmp(qts,
+                         "{ 'execute': 'qom-set', 'arguments': {"
+                         " 'path': %s, 'property': 'event',"
+                         " 'value': 'menu:press' } }",
+                         PF_A133_INPUT_PATH);
+    g_assert_true(qdict_haskey(response, "error"));
+    qobject_unref(response);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/aarch64/pocketforge-a133-input/identity-capabilities",
+                   test_identity_and_capabilities);
+    qtest_add_func("/aarch64/pocketforge-a133-input/ordered-injection",
+                   test_ordered_injection);
+    qtest_add_func("/aarch64/pocketforge-a133-input/reset-late-injection",
+                   test_reset_and_late_injection);
+    qtest_add_func("/aarch64/pocketforge-a133-input/no-device",
+                   test_no_device);
+
+    return g_test_run();
+}
