new file mode 100644
index 0000000..41ff314
--- /dev/null
+++ b/hw/input/pocketforge_a133_input.c
@@ -0,0 +1,294 @@
+/*
+ * PocketForge A133 deterministic virtual controls
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+
+#include "hw/input/pocketforge_a133_input.h"
+#include "migration/vmstate.h"
+#include "standard-headers/linux/input.h"
+#include "standard-headers/linux/virtio_config.h"
+
+#define PF_A133_INPUT_NAME "TRIMUI Player1"
+#define PF_A133_INPUT_EVENT_MAX 32
+
+struct PocketForgeA133Input {
+    VirtIOInput parent_obj;
+    bool l1;
+    bool r1;
+    bool menu;
+    int8_t hat_x;
+    int8_t hat_y;
+};
+
+#define PF_A133_ABS_CONFIG(_code, _min, _max) { \
+    .select = VIRTIO_INPUT_CFG_ABS_INFO,       \
+    .subsel = (_code),                        \
+    .size = sizeof(virtio_input_absinfo),      \
+    .u.abs = {                                \
+        .min = const_le32((uint32_t)(_min)),   \
+        .max = const_le32((uint32_t)(_max)),   \
+    },                                        \
+}
+
+static virtio_input_config pocketforge_a133_input_config[] = {
+    {
+        .select = VIRTIO_INPUT_CFG_ID_NAME,
+        .size = sizeof(PF_A133_INPUT_NAME),
+        .u.string = PF_A133_INPUT_NAME,
+    }, {
+        .select = VIRTIO_INPUT_CFG_ID_DEVIDS,
+        .size = sizeof(struct virtio_input_devids),
+        .u.ids = {
+            .bustype = const_le16(BUS_USB),
+            .vendor = const_le16(0x045e),
+            .product = const_le16(0x028e),
+            .version = const_le16(0x0110),
+        },
+    }, {
+        .select = VIRTIO_INPUT_CFG_EV_BITS,
+        .subsel = EV_KEY,
+        .size = 40,
+        .u.bitmap = {
+            [BTN_SOUTH / 8] = 0xdb,
+            [BTN_SELECT / 8] = 0x1c,
+        },
+    }, {
+        .select = VIRTIO_INPUT_CFG_EV_BITS,
+        .subsel = EV_ABS,
+        .size = 3,
+        .u.bitmap = {
+            [0] = 0x3f,
+            [2] = 0x03,
+        },
+    },
+    PF_A133_ABS_CONFIG(ABS_X, 0, 4095),
+    PF_A133_ABS_CONFIG(ABS_Y, 0, 4095),
+    PF_A133_ABS_CONFIG(ABS_RX, 0, 4095),
+    PF_A133_ABS_CONFIG(ABS_RY, 0, 4095),
+    PF_A133_ABS_CONFIG(ABS_Z, 0, 255),
+    PF_A133_ABS_CONFIG(ABS_RZ, 0, 255),
+    PF_A133_ABS_CONFIG(ABS_HAT0X, -1, 1),
+    PF_A133_ABS_CONFIG(ABS_HAT0Y, -1, 1),
+    { /* end of list */ },
+};
+
+static void pocketforge_a133_input_clear(PocketForgeA133Input *s)
+{
+    s->l1 = false;
+    s->r1 = false;
+    s->menu = false;
+    s->hat_x = 0;
+    s->hat_y = 0;
+}
+
+static bool pocketforge_a133_input_held(Object *obj, Error **errp)
+{
+    PocketForgeA133Input *s = POCKETFORGE_A133_INPUT(obj);
+
+    return s->l1 || s->r1 || s->menu || s->hat_x || s->hat_y;
+}
+
+static bool pocketforge_a133_input_ready(Object *obj, Error **errp)
+{
+    VirtIOInput *vinput = VIRTIO_INPUT(obj);
+
+    return vinput->active;
+}
+
+static bool pocketforge_a133_input_emit(PocketForgeA133Input *s,
+                                        uint16_t type, uint16_t code,
+                                        int32_t value, Error **errp)
+{
+    VirtIOInput *vinput = VIRTIO_INPUT(s);
+    virtio_input_event event = {
+        .type = cpu_to_le16(type),
+        .code = cpu_to_le16(code),
+        .value = cpu_to_le32(value),
+    };
+    virtio_input_event sync = {
+        .type = cpu_to_le16(EV_SYN),
+        .code = cpu_to_le16(SYN_REPORT),
+    };
+
+    if (!pocketforge_a133_input_ready(OBJECT(s), NULL)) {
+        error_setg(errp, "PocketForge input driver is not ready");
+        return false;
+    }
+    if (!virtio_input_send(vinput, &event) ||
+        !virtio_input_send(vinput, &sync)) {
+        error_setg(errp, "PocketForge input event queue is unavailable");
+        return false;
+    }
+    return true;
+}
+
+static void pocketforge_a133_input_set_event(Object *obj, const char *value,
+                                             Error **errp)
+{
+    PocketForgeA133Input *s = POCKETFORGE_A133_INPUT(obj);
+    const char *separator;
+    const char *action;
+    char *control;
+    bool press;
+    bool *key_state = NULL;
+    int8_t *axis_state = NULL;
+    int8_t axis_value = 0;
+    uint16_t type;
+    uint16_t code;
+    int32_t event_value;
+
+    if (!value || strlen(value) > PF_A133_INPUT_EVENT_MAX) {
+        error_setg(errp, "PocketForge input event is empty or too long");
+        return;
+    }
+    separator = strchr(value, ':');
+    if (!separator || separator == value || separator[1] == '\0' ||
+        strchr(separator + 1, ':')) {
+        error_setg(errp, "PocketForge input event must be control:action");
+        return;
+    }
+
+    control = g_strndup(value, separator - value);
+    action = separator + 1;
+    if (!strcmp(action, "press")) {
+        press = true;
+    } else if (!strcmp(action, "release")) {
+        press = false;
+    } else {
+        error_setg(errp, "PocketForge input action must be press or release");
+        g_free(control);
+        return;
+    }
+
+    type = EV_KEY;
+    if (!strcmp(control, "l1")) {
+        key_state = &s->l1;
+        code = BTN_TL;
+    } else if (!strcmp(control, "r1")) {
+        key_state = &s->r1;
+        code = BTN_TR;
+    } else if (!strcmp(control, "menu")) {
+        key_state = &s->menu;
+        code = BTN_MODE;
+    } else if (!strcmp(control, "dpad-left")) {
+        axis_state = &s->hat_x;
+        axis_value = -1;
+        type = EV_ABS;
+        code = ABS_HAT0X;
+    } else if (!strcmp(control, "dpad-right")) {
+        axis_state = &s->hat_x;
+        axis_value = 1;
+        type = EV_ABS;
+        code = ABS_HAT0X;
+    } else if (!strcmp(control, "dpad-up")) {
+        axis_state = &s->hat_y;
+        axis_value = -1;
+        type = EV_ABS;
+        code = ABS_HAT0Y;
+    } else if (!strcmp(control, "dpad-down")) {
+        axis_state = &s->hat_y;
+        axis_value = 1;
+        type = EV_ABS;
+        code = ABS_HAT0Y;
+    } else {
+        error_setg(errp, "Unsupported PocketForge input control '%s'", control);
+        g_free(control);
+        return;
+    }
+
+    if ((key_state && *key_state == press) ||
+        (axis_state && ((press && *axis_state != 0) ||
+                        (!press && *axis_state != axis_value)))) {
+        error_setg(errp, "PocketForge input event is out of order: %s",
+                   value);
+        g_free(control);
+        return;
+    }
+
+    event_value = axis_state ? (press ? axis_value : 0) : press;
+    if (pocketforge_a133_input_emit(s, type, code, event_value, errp)) {
+        if (key_state) {
+            *key_state = press;
+        } else {
+            *axis_state = press ? axis_value : 0;
+        }
+    }
+    g_free(control);
+}
+
+static void pocketforge_a133_input_change_active(VirtIOInput *vinput)
+{
+    if (!vinput->active) {
+        pocketforge_a133_input_clear(POCKETFORGE_A133_INPUT(vinput));
+    }
+}
+
+static int pocketforge_a133_input_post_load(void *opaque, int version_id)
+{
+    PocketForgeA133Input *s = opaque;
+    VirtIOInput *vinput = VIRTIO_INPUT(s);
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+
+    vinput->active = vdev->status & VIRTIO_CONFIG_S_DRIVER_OK;
+    if (!vinput->active) {
+        pocketforge_a133_input_clear(s);
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_pocketforge_a133_input = {
+    .name = "virtio-input/pocketforge-a133",
+    .minimum_version_id = 1,
+    .version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_VIRTIO_DEVICE,
+        VMSTATE_BOOL(l1, PocketForgeA133Input),
+        VMSTATE_BOOL(r1, PocketForgeA133Input),
+        VMSTATE_BOOL(menu, PocketForgeA133Input),
+        VMSTATE_INT8(hat_x, PocketForgeA133Input),
+        VMSTATE_INT8(hat_y, PocketForgeA133Input),
+        VMSTATE_END_OF_LIST()
+    },
+    .post_load = pocketforge_a133_input_post_load,
+};
+
+static void pocketforge_a133_input_init(Object *obj)
+{
+    VirtIOInput *vinput = VIRTIO_INPUT(obj);
+
+    virtio_input_init_config(vinput, pocketforge_a133_input_config);
+    object_property_add_str(obj, "event", NULL,
+                            pocketforge_a133_input_set_event);
+    object_property_add_bool(obj, "ready", pocketforge_a133_input_ready, NULL);
+    object_property_add_bool(obj, "held", pocketforge_a133_input_held, NULL);
+}
+
+static void pocketforge_a133_input_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    VirtIOInputClass *vic = VIRTIO_INPUT_CLASS(klass);
+
+    dc->desc = "PocketForge A133 deterministic controls";
+    dc->vmsd = &vmstate_pocketforge_a133_input;
+    vic->change_active = pocketforge_a133_input_change_active;
+}
+
+static const TypeInfo pocketforge_a133_input_info = {
+    .name = TYPE_POCKETFORGE_A133_INPUT,
+    .parent = TYPE_VIRTIO_INPUT,
+    .instance_size = sizeof(PocketForgeA133Input),
+    .instance_init = pocketforge_a133_input_init,
+    .class_init = pocketforge_a133_input_class_init,
+};
+
+static void pocketforge_a133_input_register_types(void)
+{
+    type_register_static(&pocketforge_a133_input_info);
+}
+
+type_init(pocketforge_a133_input_register_types)
