 OBJECT_DECLARE_SIMPLE_TYPE(PocketForgeA133DisplayState,
                            POCKETFORGE_A133_DISPLAY)
 
-PocketForgeA133DisplayState *pocketforge_a133_display_create(bool enabled);
+PocketForgeA133DisplayState *pocketforge_a133_display_create(bool enabled,
+                                                             qemu_irq irq);
 QemuConsole *pocketforge_a133_display_console(
     PocketForgeA133DisplayState *s);
 bool pocketforge_a133_display_iova_read(PocketForgeA133DisplayState *s,
