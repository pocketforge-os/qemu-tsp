+    /* These controller nodes are disabled in the pinned effective DT. */
+    g_assert_null(strstr(map, "0000000005101000-"));
+    g_assert_null(strstr(map, "0000000005101400-"));
+    g_assert_null(strstr(map, "pocketforge-a133.de2_clk"));
+    g_assert_null(strstr(map, "pocketforge-a133.mixer0"));
+
+    qtest_quit(qts);
+}
+
+static void test_stub_storage_and_reset(void)
+{
+    QTestState *qts = mmio_start();
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(stub_regions); i++) {
+        const ExpectedRegion *region = &stub_regions[i];
+        uint64_t last = region->base + region->size - 1;
+
+        g_assert_cmphex(qtest_readb(qts, region->base), ==, 0);
+        g_assert_cmphex(qtest_readb(qts, last), ==, 0);
+        qtest_writeb(qts, region->base, 0xa5);
+        qtest_writeb(qts, last, 0x5a);
+        g_assert_cmphex(qtest_readb(qts, region->base), ==, 0xa5);
+        g_assert_cmphex(qtest_readb(qts, last), ==, 0x5a);
+    }
+
+    qtest_qmp_assert_success(qts, "{ 'execute': 'system_reset' }");
+    qtest_qmp_eventwait(qts, "RESET");
+
+    for (i = 0; i < ARRAY_SIZE(stub_regions); i++) {
+        const ExpectedRegion *region = &stub_regions[i];
+
+        g_assert_cmphex(qtest_readb(qts, region->base), ==, 0);
+        g_assert_cmphex(qtest_readb(qts, region->base + region->size - 1),
+                        ==, 0);
+    }
+
+    qtest_quit(qts);
+}
+
+static void test_uart_model_contract(void)
+{
+    static const uint64_t uart_bases[] = {
+        0x05000000, 0x05000400, 0x05000c00, 0x05001000,
+    };
+    QTestState *qts = mmio_start();
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(uart_bases); i++) {
+        /* USR: TX FIFO not full and empty; controller is not busy. */
+        g_assert_cmphex(qtest_readl(qts, uart_bases[i] + 0x7c), ==, 0x6);
+    }
+
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/pocketforge-a133-mmio/exact-live-map",
+                   test_exact_live_map);
+    qtest_add_func("/pocketforge-a133-mmio/stub-storage-and-reset",
+                   test_stub_storage_and_reset);
+    qtest_add_func("/pocketforge-a133-mmio/uart-model-contract",
+                   test_uart_model_contract);
+
+    return g_test_run();
+}
