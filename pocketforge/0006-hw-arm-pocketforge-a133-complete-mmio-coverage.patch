+static void assert_region_line(const char *map, const ExpectedRegion *region)
+{
+    g_autofree char *line = g_strdup_printf(
+        "  %016" PRIx64 "-%016" PRIx64 " (prio 0, i/o): %s",
+        region->base, region->base + region->size - 1, region->name);
+
+    g_assert_nonnull(strstr(map, line));
+}
