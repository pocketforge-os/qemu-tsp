From: "pocketforge-agent[bot]"
 <299760760+pocketforge-agent[bot]@users.noreply.github.com>
Date: Sun, 25 Oct 2026 09:20:00 -0400
Subject: [PATCH] tests: require A133 release MMC2 host

The release Odyssey DT enables its non-removable eMMC controller at
0x04022000.  Require the machine to expose that aperture as an Allwinner
SD host, and require its default no-media command path to complete with a
no-response interrupt rather than leaving an unmapped hole.

Assisted-by: LLM
---
 tests/qtest/pocketforge-a133-mmio-map-test.c |  1 +
 tests/qtest/pocketforge-a133-mmc-test.c      | 23 +++++++++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/tests/qtest/pocketforge-a133-mmio-map-test.c b/tests/qtest/pocketforge-a133-mmio-map-test.c
--- a/tests/qtest/pocketforge-a133-mmio-map-test.c
+++ b/tests/qtest/pocketforge-a133-mmio-map-test.c
@@ -50,6 +50,7 @@ static const ExpectedRegion expected_regions[] = {
     { "pocketforge-a133.iommu",            0x030f0000, 0x10000 },
     { "allwinner-sdhost",                  0x04020000, 0x1000 },
     { "pocketforge-a133.mmc1",             0x04021000, 0x1000 },
+    { "allwinner-sdhost",                  0x04022000, 0x1000 },
     { "dw-apb-uart",                       0x05000000, 0x400 },
     { "dw-apb-uart",                       0x05000400, 0x400 },
     { "dw-apb-uart",                       0x05000c00, 0x400 },
diff --git a/tests/qtest/pocketforge-a133-mmc-test.c b/tests/qtest/pocketforge-a133-mmc-test.c
--- a/tests/qtest/pocketforge-a133-mmc-test.c
+++ b/tests/qtest/pocketforge-a133-mmc-test.c
@@ -10,6 +10,7 @@
 #include "libqtest.h"
 
 #define MMC0_BASE       0x04020000
+#define MMC2_BASE       0x04022000
 #define RAM_DESC        0x40010000
 #define RAM_DATA        0x40012000
 #define TEST_IMAGE_SIZE (1 * MiB)
@@ -174,10 +175,33 @@ static void test_real_media_and_controls(void)
     g_assert_cmpint(unlink(corrupt_path), ==, 0);
 }
 
+static void test_release_emmc_no_media(void)
+{
+    QTestState *qts = qtest_init("-M pocketforge-a133 -m 64M");
+    uint32_t irq;
+
+    /*
+     * The release DT's non-removable eMMC controller is a real A100 host,
+     * but the machine must never attach a host block device to it.  A
+     * command therefore completes deterministically with NO_RESP.
+     */
+    qtest_writel(qts, MMC2_BASE + REG_RINTR, UINT32_MAX);
+    qtest_writel(qts, MMC2_BASE + REG_CARG, 0x1aa);
+    qtest_writel(qts, MMC2_BASE + REG_CMDR, CMD_START | CMD_RESP | 8);
+    g_assert_cmphex(qtest_readl(qts, MMC2_BASE + REG_CMDR) & CMD_START,
+                    ==, 0);
+    irq = qtest_readl(qts, MMC2_BASE + REG_RINTR);
+    g_assert_cmphex(irq & RINTR_NO_RESP, !=, 0);
+
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
     qtest_add_func("pocketforge-a133/mmc/real-media-and-controls",
                    test_real_media_and_controls);
+    qtest_add_func("pocketforge-a133/mmc/release-emmc-no-media",
+                   test_release_emmc_no_media);
     return g_test_run();
 }
