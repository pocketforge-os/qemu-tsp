@@ -0,0 +1,16 @@
+/* PocketForge A133 native display pipeline. */
+#ifndef HW_DISPLAY_POCKETFORGE_A133_DISPLAY_H
+#define HW_DISPLAY_POCKETFORGE_A133_DISPLAY_H
+
+#include "hw/core/sysbus.h"
+
+#define TYPE_POCKETFORGE_A133_DISPLAY "pocketforge-a133-display"
+OBJECT_DECLARE_SIMPLE_TYPE(PocketForgeA133DisplayState,
+                           POCKETFORGE_A133_DISPLAY)
+
+PocketForgeA133DisplayState *pocketforge_a133_display_create(void);
+bool pocketforge_a133_display_iova_read(PocketForgeA133DisplayState *s,
+                                        uint32_t iova, void *buf,
+                                        size_t len);
+
+#endif
