new file mode 100644
index 0000000000000000000000000000000000000000..c90638b9174559349505932dbcd66be79a734a6a
--- /dev/null
+++ b/hw/input/pocketforge_a133_lradc.c
@@ -0,0 +1,253 @@
+/*
+ * PocketForge A133 LRADC volume-rocker model.
+ *
+ * The sun4i-lradc-keys driver uses channel 0 KEYDOWN/DATA/KEYUP interrupts.
+ * The A100-compatible filter needs two equal conversion samples, so a press
+ * reports KEYDOWN plus the first DATA sample immediately and schedules the
+ * second DATA sample after one eight-sample averaging interval.  Holding is
+ * otherwise quiet; the guest input core owns repeat policy.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/input/pocketforge_a133_lradc.h"
+#include "hw/core/irq.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "standard-headers/linux/input.h"
+
+#define LRADC_CTRL          0x00
+#define LRADC_INTC          0x04
+#define LRADC_INTS          0x08
+#define LRADC_DATA0         0x0c
+
+#define LRADC_CTRL_ENABLE   BIT(0)
+#define LRADC_IRQ_DATA      BIT(0)
+#define LRADC_IRQ_KEYDOWN   BIT(1)
+#define LRADC_IRQ_KEYUP     BIT(4)
+#define LRADC_DRIVER_IRQS   (LRADC_IRQ_DATA | LRADC_IRQ_KEYDOWN | \
+                             LRADC_IRQ_KEYUP)
+
+#define LRADC_CODE_VOLUMEUP    31
+#define LRADC_CODE_VOLUMEDOWN  43
+#define LRADC_SECOND_SAMPLE_NS (32 * SCALE_MS)
+
+struct PocketForgeA133Lradc {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    QEMUTimer *sample_timer;
+    uint32_t ctrl;
+    uint32_t intc;
+    uint32_t ints;
+    uint32_t data0;
+    int32_t held_code;
+};
+
+static void pocketforge_a133_lradc_update_irq(PocketForgeA133Lradc *s)
+{
+    qemu_set_irq(s->irq, (s->ints & s->intc) != 0);
+}
+
+bool pocketforge_a133_lradc_is_ready(PocketForgeA133Lradc *s)
+{
+    return s && (s->ctrl & LRADC_CTRL_ENABLE) &&
+           (s->intc & LRADC_DRIVER_IRQS) == LRADC_DRIVER_IRQS;
+}
+
+int pocketforge_a133_lradc_held_code(PocketForgeA133Lradc *s)
+{
+    return s ? s->held_code : 0;
+}
+
+static uint32_t pocketforge_a133_lradc_data_code(int code)
+{
+    return code == KEY_VOLUMEUP ? LRADC_CODE_VOLUMEUP :
+                                  LRADC_CODE_VOLUMEDOWN;
+}
+
+static void pocketforge_a133_lradc_second_sample(void *opaque)
+{
+    PocketForgeA133Lradc *s = opaque;
+
+    if (s->held_code && pocketforge_a133_lradc_is_ready(s)) {
+        s->ints |= LRADC_IRQ_DATA;
+        pocketforge_a133_lradc_update_irq(s);
+    }
+}
+
+void pocketforge_a133_lradc_set_key(PocketForgeA133Lradc *s,
+                                    int code, bool pressed)
+{
+    if (pressed) {
+        s->held_code = code;
+        s->data0 = pocketforge_a133_lradc_data_code(code);
+        s->ints |= LRADC_IRQ_KEYDOWN | LRADC_IRQ_DATA;
+        timer_mod(s->sample_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  LRADC_SECOND_SAMPLE_NS);
+    } else {
+        timer_del(s->sample_timer);
+        s->held_code = 0;
+        s->ints |= LRADC_IRQ_KEYUP;
+    }
+    pocketforge_a133_lradc_update_irq(s);
+}
+
+static uint64_t pocketforge_a133_lradc_read(void *opaque, hwaddr offset,
+                                            unsigned size)
+{
+    PocketForgeA133Lradc *s = opaque;
+
+    switch (offset) {
+    case LRADC_CTRL:
+        return s->ctrl;
+    case LRADC_INTC:
+        return s->intc;
+    case LRADC_INTS:
+        return s->ints;
+    case LRADC_DATA0:
+        return s->data0 & 0x3f;
+    default:
+        return 0;
+    }
+}
+
+static void pocketforge_a133_lradc_write(void *opaque, hwaddr offset,
+                                         uint64_t value, unsigned size)
+{
+    PocketForgeA133Lradc *s = opaque;
+
+    switch (offset) {
+    case LRADC_CTRL:
+        s->ctrl = value;
+        if (!(s->ctrl & LRADC_CTRL_ENABLE)) {
+            timer_del(s->sample_timer);
+            s->held_code = 0;
+            s->ints = 0;
+        }
+        break;
+    case LRADC_INTC:
+        s->intc = value & 0x1fff;
+        if (!s->intc) {
+            timer_del(s->sample_timer);
+            s->held_code = 0;
+            s->ints = 0;
+        }
+        break;
+    case LRADC_INTS:
+        s->ints &= ~(value & 0x1fff);
+        break;
+    case LRADC_DATA0:
+        break;
+    default:
+        break;
+    }
+    pocketforge_a133_lradc_update_irq(s);
+}
+
+static const MemoryRegionOps pocketforge_a133_lradc_ops = {
+    .read = pocketforge_a133_lradc_read,
+    .write = pocketforge_a133_lradc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void pocketforge_a133_lradc_reset(DeviceState *dev)
+{
+    PocketForgeA133Lradc *s = POCKETFORGE_A133_LRADC(dev);
+
+    timer_del(s->sample_timer);
+    s->ctrl = 0;
+    s->intc = 0;
+    s->ints = 0;
+    s->data0 = 0;
+    s->held_code = 0;
+    qemu_set_irq(s->irq, 0);
+}
+
+static int pocketforge_a133_lradc_post_load(void *opaque, int version_id)
+{
+    PocketForgeA133Lradc *s = opaque;
+
+    pocketforge_a133_lradc_update_irq(s);
+    return 0;
+}
+
+static const VMStateDescription vmstate_pocketforge_a133_lradc = {
+    .name = TYPE_POCKETFORGE_A133_LRADC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = pocketforge_a133_lradc_post_load,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32(ctrl, PocketForgeA133Lradc),
+        VMSTATE_UINT32(intc, PocketForgeA133Lradc),
+        VMSTATE_UINT32(ints, PocketForgeA133Lradc),
+        VMSTATE_UINT32(data0, PocketForgeA133Lradc),
+        VMSTATE_INT32(held_code, PocketForgeA133Lradc),
+        VMSTATE_TIMER_PTR(sample_timer, PocketForgeA133Lradc),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void pocketforge_a133_lradc_init(Object *obj)
+{
+    PocketForgeA133Lradc *s = POCKETFORGE_A133_LRADC(obj);
+
+    memory_region_init_io(&s->iomem, obj, &pocketforge_a133_lradc_ops, s,
+                          "pocketforge-a133.lradc", PF_A133_LRADC_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    s->sample_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                   pocketforge_a133_lradc_second_sample, s);
+}
+
+static void pocketforge_a133_lradc_finalize(Object *obj)
+{
+    PocketForgeA133Lradc *s = POCKETFORGE_A133_LRADC(obj);
+
+    timer_free(s->sample_timer);
+}
+
+static void pocketforge_a133_lradc_class_init(ObjectClass *klass,
+                                              const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "PocketForge A133 LRADC volume rocker";
+    device_class_set_legacy_reset(dc, pocketforge_a133_lradc_reset);
+    dc->vmsd = &vmstate_pocketforge_a133_lradc;
+}
+
+static const TypeInfo pocketforge_a133_lradc_info = {
+    .name = TYPE_POCKETFORGE_A133_LRADC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(PocketForgeA133Lradc),
+    .instance_init = pocketforge_a133_lradc_init,
+    .instance_finalize = pocketforge_a133_lradc_finalize,
+    .class_init = pocketforge_a133_lradc_class_init,
+};
+
+static void pocketforge_a133_lradc_register_types(void)
+{
+    type_register_static(&pocketforge_a133_lradc_info);
+}
+
+type_init(pocketforge_a133_lradc_register_types)
+
+PocketForgeA133Lradc *pocketforge_a133_lradc_create(hwaddr addr,
+                                                    qemu_irq irq)
+{
+    DeviceState *dev = qdev_new(TYPE_POCKETFORGE_A133_LRADC);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, addr);
+    sysbus_connect_irq(sbd, 0, irq);
+    return POCKETFORGE_A133_LRADC(dev);
+}
