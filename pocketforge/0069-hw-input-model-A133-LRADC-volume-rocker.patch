+static void pocketforge_a133_volume_send(
+    PocketForgeA133MachineState *s, PocketForgeInputEventList *events,
+    Error **errp)
+{
+    PocketForgeInputEventList *second;
+    PocketForgeInputEvent *event;
+    int held;
+
+    if (!events || !(second = events->next) || second->next ||
+        second->value->type != EV_SYN ||
+        second->value->code != SYN_REPORT || second->value->value != 0 ||
+        events->value->type != EV_KEY) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter: "
+                   "volume-rocker batch must contain one EV_KEY transition "
+                   "followed by SYN_REPORT");
+        return;
+    }
+
+    event = events->value;
+    if (event->code != KEY_VOLUMEUP && event->code != KEY_VOLUMEDOWN) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                   "index=0: key code=%" PRId64 " is not advertised by "
+                   "volume-rocker", event->code);
+        return;
+    }
+    if (event->value != 0 && event->value != 1) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                   "index=0: unsupported value=%" PRId64 " code=%" PRId64,
+                   event->value, event->code);
+        return;
+    }
+    if (!pocketforge_a133_lradc_is_ready(s->lradc)) {
+        error_set(errp, ERROR_CLASS_DEVICE_NOT_ACTIVE,
+                  "PocketForge input device 'volume-rocker' is not active");
+        return;
+    }
+
+    held = pocketforge_a133_lradc_held_code(s->lradc);
+    if (event->value && held == event->code) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                   "index=0: duplicate press code=%" PRId64, event->code);
+        return;
+    }
+    if (event->value && held) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                   "index=0: cross-button press code=%" PRId64 " held=%d",
+                   event->code, held);
+        return;
+    }
+    if (!event->value && !held) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                   "index=0: release before press code=%" PRId64,
+                   event->code);
+        return;
+    }
+    if (!event->value && held != event->code) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                   "index=0: cross-button release code=%" PRId64 " held=%d",
+                   event->code, held);
+        return;
+    }
+
+    pocketforge_a133_lradc_set_key(s->lradc, event->code, event->value);
+}
