+static void test_analog_frames_and_negative_control(void)
+{
+    static const uint8_t left_x_min[] = {
+        0xff, 0x01, 0x00, 0x00, 0x00, 0x08, 0x00, 0xfe,
+    };
+    static const uint8_t left_x_mid[] = {
+        0xff, 0x01, 0x00, 0x08, 0x00, 0x08, 0x00, 0xfe,
+    };
+    static const uint8_t left_y_max[] = {
+        0xff, 0x01, 0x00, 0x08, 0x00, 0x0f, 0xff, 0xfe,
+    };
+    static const uint8_t right_xy[] = {
+        0xff, 0x01, 0x00, 0x0f, 0xff, 0x00, 0x00, 0xfe,
+    };
+    static const uint8_t left_l2_pressed[] = {
+        0xff, 0x01, 0x02, 0x08, 0x00, 0x0f, 0xff, 0xfe,
+    };
+    static const uint8_t left_l2_released[] = {
+        0xff, 0x01, 0x00, 0x08, 0x00, 0x0f, 0xff, 0xfe,
+    };
+    static const uint8_t right_r2_pressed[] = {
+        0xff, 0x01, 0x02, 0x0f, 0xff, 0x00, 0x00, 0xfe,
+    };
+    static const uint8_t right_r2_released[] = {
+        0xff, 0x01, 0x00, 0x0f, 0xff, 0x00, 0x00, 0xfe,
+    };
+    QTestState *qts = qtest_init("-machine pocketforge-a133 -nodefaults");
+    QDict *response;
+
+    uart_configure(qts, PF_UART3_BASE);
+    uart_configure(qts, PF_UART4_BASE);
+    uart_assert_frame(qts, PF_UART3_BASE, centered);
+    uart_assert_frame(qts, PF_UART4_BASE, centered);
+
+    /* A later invalid triple rejects the whole report and emits no prefix. */
+    response = raw_send_two(qts, EV_ABS, ABS_X, 0,
+                            EV_ABS, ABS_Y, 4096);
+    assert_error_prefix(response,
+        "pocketforge-input: reason=invalid-parameter index=1:");
+    qobject_unref(response);
+    uart_assert_empty(qts, PF_UART3_BASE);
+    uart_assert_empty(qts, PF_UART4_BASE);
+
+    response = raw_send(qts, EV_ABS, ABS_X, 0);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    uart_assert_frame(qts, PF_UART4_BASE, left_x_min);
+
+    response = raw_send(qts, EV_ABS, ABS_X, 2048);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    uart_assert_frame(qts, PF_UART4_BASE, left_x_mid);
+
+    response = raw_send(qts, EV_ABS, ABS_Y, 4095);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    uart_assert_frame(qts, PF_UART4_BASE, left_y_max);
+
+    response = raw_send_two(qts, EV_ABS, ABS_RX, 4095,
+                            EV_ABS, ABS_RY, 0);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    uart_assert_frame(qts, PF_UART3_BASE, right_xy);
+
+    response = raw_send(qts, EV_ABS, ABS_Z, 255);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    uart_assert_frame(qts, PF_UART4_BASE, left_l2_pressed);
+    response = raw_send(qts, EV_ABS, ABS_Z, 0);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    uart_assert_frame(qts, PF_UART4_BASE, left_l2_released);
+
+    response = raw_send(qts, EV_ABS, ABS_RZ, 255);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    uart_assert_frame(qts, PF_UART3_BASE, right_r2_pressed);
+    response = raw_send(qts, EV_ABS, ABS_RZ, 0);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    uart_assert_frame(qts, PF_UART3_BASE, right_r2_released);
+
+    /* The real binary actuator cannot produce an intermediate trigger sample. */
+    response = raw_send(qts, EV_ABS, ABS_Z, 127);
+    assert_error_prefix(response,
+        "pocketforge-input: reason=invalid-parameter index=0:");
+    qobject_unref(response);
+    uart_assert_empty(qts, PF_UART3_BASE);
+    uart_assert_empty(qts, PF_UART4_BASE);
+    qtest_quit(qts);
+}
+
 static void test_uart_component_parameters(void)
 {
     QTestState *qts = qtest_init("-machine pocketforge-a133 -nodefaults");
