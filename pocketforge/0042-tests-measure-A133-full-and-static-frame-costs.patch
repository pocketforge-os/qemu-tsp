From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PocketForge Maintainers <maintainers@pocketforge.invalid>
Date: Tue, 13 Oct 2026 19:16:16 +0000
Subject: [PATCH] tests: measure A133 full and static frame costs

---
 tests/qtest/pocketforge-a133-display-test.c | 47 +++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/tests/qtest/pocketforge-a133-display-test.c b/tests/qtest/pocketforge-a133-display-test.c
index 77dfc9d..584b297 100644
--- a/tests/qtest/pocketforge-a133-display-test.c
+++ b/tests/qtest/pocketforge-a133-display-test.c
@@ -56,6 +56,52 @@ typedef struct DisplayTest {
     uint8_t update_pixel[4];
 } DisplayTest;
 
+enum {
+    FRAME_WARMUP_COUNT = 30,
+    FRAME_SAMPLE_COUNT = 300,
+};
+
+static int compare_frame_time(const void *a, const void *b)
+{
+    const int64_t left = *(const int64_t *)a;
+    const int64_t right = *(const int64_t *)b;
+
+    return (left > right) - (left < right);
+}
+
+static void report_frame_cost(QTestState *qts)
+{
+    int64_t full[FRAME_SAMPLE_COUNT];
+    int64_t idle[FRAME_SAMPLE_COUNT];
+    int64_t before;
+    unsigned int i;
+
+    for (i = 0; i < FRAME_WARMUP_COUNT; i++) {
+        qtest_writel(qts, PF_MIXER_BASE + PF_MIXER_DBUFF, BIT(0));
+    }
+    for (i = 0; i < FRAME_SAMPLE_COUNT; i++) {
+        before = g_get_monotonic_time();
+        qtest_writel(qts, PF_MIXER_BASE + PF_MIXER_DBUFF, BIT(0));
+        full[i] = g_get_monotonic_time() - before;
+    }
+    for (i = 0; i < FRAME_WARMUP_COUNT; i++) {
+        qtest_clock_step(qts, 17 * 1000 * 1000);
+    }
+    for (i = 0; i < FRAME_SAMPLE_COUNT; i++) {
+        before = g_get_monotonic_time();
+        qtest_clock_step(qts, 17 * 1000 * 1000);
+        idle[i] = g_get_monotonic_time() - before;
+    }
+    qsort(full, G_N_ELEMENTS(full), sizeof(full[0]), compare_frame_time);
+    qsort(idle, G_N_ELEMENTS(idle), sizeof(idle[0]), compare_frame_time);
+    g_test_message("FRAME_COST path=full-copy frames=300 bytes=3686400 "
+                   "p50_us=%" PRId64 " p95_us=%" PRId64 " max_us=%" PRId64,
+                   full[149], full[284], full[299]);
+    g_test_message("FRAME_COST path=static-vblank frames=300 bytes=0 "
+                   "p50_us=%" PRId64 " p95_us=%" PRId64 " max_us=%" PRId64,
+                   idle[149], idle[284], idle[299]);
+}
+
 static void native_map_framebuffer(QTestState *qts)
 {
     const size_t framebuffer_size = PF_WIDTH * PF_HEIGHT * 4;
@@ -211,6 +257,7 @@ static void test_native_scanout(void)
     qts = qtest_init("-machine pocketforge-a133 -nodefaults "
                      "-display dbus,p2p=yes");
     native_map_framebuffer(qts);
+    report_frame_cost(qts);
     g_assert_cmpint(qemu_socketpair(AF_UNIX, SOCK_STREAM, 0, dbus_pair), ==, 0);
     qtest_qmp_add_client(qts, "@dbus-display", dbus_pair[1]);
     conn = p2p_from_fd(dbus_pair[0]);
