diff --git a/tests/qtest/pocketforge-a133-r-i2c-test.c b/tests/qtest/pocketforge-a133-r-i2c-test.c
new file mode 100644
index 0000000000..282152e794
--- /dev/null
+++ b/tests/qtest/pocketforge-a133-r-i2c-test.c
@@ -0,0 +1,41 @@
+/*
+ * PocketForge A133 R-I2C0 controller qtest
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest-single.h"
+
+#define R_I2C0_BASE 0x07081400
+#define TWI_STAT    0x10
+#define TWI_SRST    0x18
+
+static void test_r_i2c0_registers(void)
+{
+    g_assert_cmphex(qtest_readl(global_qtest, R_I2C0_BASE + TWI_STAT),
+                    ==, 0xf8);
+
+    qtest_writel(global_qtest, R_I2C0_BASE + TWI_SRST, 1);
+    g_assert_cmphex(qtest_readl(global_qtest, R_I2C0_BASE + TWI_SRST),
+                    ==, 1);
+    qtest_writel(global_qtest, R_I2C0_BASE + TWI_SRST, 0);
+    g_assert_cmphex(qtest_readl(global_qtest, R_I2C0_BASE + TWI_SRST),
+                    ==, 0);
+    g_assert_cmphex(qtest_readl(global_qtest, R_I2C0_BASE + TWI_STAT),
+                    ==, 0xf8);
+}
+
+int main(int argc, char **argv)
+{
+    int ret;
+
+    g_test_init(&argc, &argv, NULL);
+    qtest_start("-machine pocketforge-a133 -display none");
+    qtest_add_func("/pocketforge-a133/r-i2c0/registers",
+                   test_r_i2c0_registers);
+    ret = g_test_run();
+    qtest_end();
+
+    return ret;
+}
