From 57470cca36d5a1c9bcc7a60ffcc0fe175e175dbc Mon Sep 17 00:00:00 2001
From: PocketForge Worker <worker@pocketforge.invalid>
Date: Fri, 9 Oct 2026 18:42:32 -0400
Subject: [PATCH] hw/arm: model A133 R-I2C0 controller

Replace the register-file stub with the upstream sun6i Allwinner I2C controller at the board DT address and SPI 113. Preserve the full DT aperture as a parent container and cover reset/status semantics in qtest.

Assisted-by: LLM
---
 hw/arm/Kconfig                               |  1 +
 hw/arm/pocketforge_a133.c                    | 23 ++++++++++-
 tests/qtest/meson.build                      |  2 +-
 tests/qtest/pocketforge-a133-mmio-map-test.c |  3 +-
 tests/qtest/pocketforge-a133-r-i2c-test.c    | 41 ++++++++++++++++++++
 5 files changed, 66 insertions(+), 4 deletions(-)
 create mode 100644 tests/qtest/pocketforge-a133-r-i2c-test.c

diff --git a/hw/arm/Kconfig b/hw/arm/Kconfig
index 78c500f..3d7c408 100644
--- a/hw/arm/Kconfig
+++ b/hw/arm/Kconfig
@@ -274,6 +274,7 @@ config POCKETFORGE_A133
     bool
     default y
     depends on TCG && AARCH64
+    select ALLWINNER_I2C
     select ARM_GIC
     select DW_APB_UART
     select POCKETFORGE_A100_RTC
diff --git a/hw/arm/pocketforge_a133.c b/hw/arm/pocketforge_a133.c
index 1694550..d656230 100644
--- a/hw/arm/pocketforge_a133.c
+++ b/hw/arm/pocketforge_a133.c
@@ -91,6 +91,7 @@
 #include "hw/arm/bsa.h"
 #include "hw/boards.h"
 #include "hw/char/dw_apb_uart.h"
+#include "hw/i2c/allwinner-i2c.h"
 #include "hw/input/pocketforge_a133_input.h"
 #include "hw/misc/pocketforge_a133_mmio_stub.h"
 #include "hw/intc/arm_gic.h"
@@ -112,6 +113,8 @@ OBJECT_DECLARE_SIMPLE_TYPE(PocketForgeA133MachineState,
 
 struct PocketForgeA133MachineState {
     MachineState parent_obj;
+    MemoryRegion r_i2c0_container;
+    I2CBus *r_i2c0_bus;
     bool input;
 };
 
@@ -460,7 +463,6 @@ static const PfA133StubRegion pf_a133_stub_regions[] = {
     { "pocketforge-a133.r_intc",           0x07010320, 0xc },
     { "pocketforge-a133.r_pio",            0x07022000, 0x400 },
     { "pocketforge-a133.ir",               0x07040000, 0x400 },
-    { "pocketforge-a133.r_i2c0",           0x07081400, 0x400 },
 };
 
 typedef struct PfA133UartRegion {
@@ -488,6 +490,23 @@ static void pocketforge_a133_create_mmio_stubs(void)
     }
 }
 
+static void pocketforge_a133_create_r_i2c0(PocketForgeA133MachineState *s,
+                                            qemu_irq irq)
+{
+    DeviceState *dev = qdev_new(TYPE_AW_I2C_SUN6I);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    memory_region_init(&s->r_i2c0_container, OBJECT(s),
+                       "pocketforge-a133.r_i2c0", PF_A133_R_I2C0_SIZE);
+    memory_region_add_subregion(&s->r_i2c0_container, 0,
+                                sysbus_mmio_get_region(sbd, 0));
+    memory_region_add_subregion(get_system_memory(), PF_A133_R_I2C0_BASE,
+                                &s->r_i2c0_container);
+    sysbus_connect_irq(sbd, 0, irq);
+    s->r_i2c0_bus = AW_I2C(dev)->bus;
+}
+
 static void pocketforge_a133_create_gic(MachineState *machine, qemu_irq *pic)
 {
     DeviceState *gicdev;
@@ -617,6 +636,7 @@ static void pocketforge_a133_modify_dtb(const struct arm_boot_info *binfo,
 
 static void pocketforge_a133_init(MachineState *machine)
 {
+    PocketForgeA133MachineState *s = POCKETFORGE_A133_MACHINE(machine);
     MemoryRegion *sysmem = get_system_memory();
     qemu_irq pic[PF_A133_NUM_SPI];
     struct arm_boot_info *binfo = g_new0(struct arm_boot_info, 1);
@@ -657,6 +677,7 @@ static void pocketforge_a133_init(MachineState *machine)
     pocketforge_a100_rtc_create(PF_A133_RTC_BASE);
 
     pocketforge_a133_create_mmio_stubs();
+    pocketforge_a133_create_r_i2c0(s, pic[113]);
 
     pocketforge_a133_create_virtio_mmio(machine, pic);
 
