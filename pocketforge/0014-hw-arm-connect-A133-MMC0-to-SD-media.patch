 }
 
+static void pocketforge_a133_create_mmc0(qemu_irq irq)
+{
+    DriveInfo *di = drive_get(IF_SD, 0, 0);
+    BlockBackend *blk = di ? blk_by_legacy_dinfo(di) : NULL;
+    DeviceState *host = qdev_new(TYPE_AW_SDHOST_SUN50I_A100);
+    DeviceState *card;
+    BusState *bus;
+
+    object_property_set_link(OBJECT(host), "dma-memory",
+                             OBJECT(get_system_memory()), &error_fatal);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(host), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(host), 0, PF_A133_MMC0_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(host), 0, irq);
+
+    bus = qdev_get_child_bus(host, "sd-bus");
+    if (!bus) {
+        error_report("No SD bus found on A133 MMC0");
+        exit(1);
+    }
+    if (!di) {
+        return;
+    }
+
+    card = qdev_new(TYPE_SD_CARD);
+    qdev_prop_set_drive_err(card, "drive", blk, &error_fatal);
+    qdev_realize_and_unref(card, bus, &error_fatal);
+}
+
 static void pocketforge_a133_create_gic(MachineState *machine, qemu_irq *pic)
 {
     DeviceState *gicdev;
