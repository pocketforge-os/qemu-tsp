diff --git a/tests/qtest/pocketforge-a133-mmc-test.c b/tests/qtest/pocketforge-a133-mmc-test.c
new file mode 100644
index 0000000..8411e74
--- /dev/null
+++ b/tests/qtest/pocketforge-a133-mmc-test.c
@@ -0,0 +1,171 @@
+/*
+ * PocketForge A133 MMC0 qtest
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/bswap.h"
+#include "qemu/units.h"
+#include "libqtest.h"
+
+#define MMC0_BASE       0x04020000
+#define RAM_DESC        0x40010000
+#define RAM_DATA        0x40012000
+#define TEST_IMAGE_SIZE (1 * MiB)
+
+#define REG_GCTRL 0x00
+#define REG_BLKSZ 0x10
+#define REG_BCNTR 0x14
+#define REG_CMDR  0x18
+#define REG_CARG  0x1c
+#define REG_RESP0 0x20
+#define REG_RINTR 0x38
+#define REG_STAS  0x3c
+#define REG_DLBA  0x84
+
+#define GCTRL_DMA_ENABLE BIT(5)
+#define CMD_START        BIT(31)
+#define CMD_DATA         BIT(9)
+#define CMD_LONG_RESP    BIT(7)
+#define CMD_RESP         BIT(6)
+#define RINTR_NO_RESP    BIT(1)
+#define RINTR_CMD_DONE   BIT(2)
+#define RINTR_DATA_OVER  BIT(3)
+#define STAS_CARD_PRESENT BIT(8)
+
+#define DESC_OWN   BIT(31)
+#define DESC_FIRST BIT(3)
+#define DESC_LAST  BIT(2)
+
+static void write_image_marker(const char *path, const char marker[8])
+{
+    int fd = open(path, O_WRONLY);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(pwrite(fd, marker, 8, 512), ==, 8);
+    g_assert_cmpint(close(fd), ==, 0);
+}
+
+static char *create_image(const char marker[8])
+{
+    GError *error = NULL;
+    char *path = NULL;
+    int fd = g_file_open_tmp("pocketforge-a133-mmc-XXXXXX", &path, &error);
+
+    g_assert_no_error(error);
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(ftruncate(fd, TEST_IMAGE_SIZE), ==, 0);
+    g_assert_cmpint(close(fd), ==, 0);
+    write_image_marker(path, marker);
+    return path;
+}
+
+static uint32_t send_command(QTestState *qts, uint32_t cmd, uint32_t arg)
+{
+    qtest_writel(qts, MMC0_BASE + REG_RINTR, UINT32_MAX);
+    qtest_writel(qts, MMC0_BASE + REG_CARG, arg);
+    qtest_writel(qts, MMC0_BASE + REG_CMDR, CMD_START | cmd);
+    g_assert_cmphex(qtest_readl(qts, MMC0_BASE + REG_CMDR) & CMD_START, ==, 0);
+    return qtest_readl(qts, MMC0_BASE + REG_RINTR);
+}
+
+static void initialize_sd(QTestState *qts)
+{
+    uint32_t irq;
+
+    irq = send_command(qts, 0, 0);
+    g_assert_cmphex(irq & RINTR_CMD_DONE, !=, 0);
+    irq = send_command(qts, CMD_RESP | 55, 0);
+    g_assert_cmphex(irq & RINTR_CMD_DONE, !=, 0);
+    irq = send_command(qts, CMD_RESP | 41, 0x40300000);
+    g_assert_cmphex(irq & RINTR_CMD_DONE, !=, 0);
+    irq = send_command(qts, CMD_RESP | CMD_LONG_RESP | 2, 0);
+    g_assert_cmphex(irq & RINTR_CMD_DONE, !=, 0);
+    irq = send_command(qts, CMD_RESP | 3, 0);
+    g_assert_cmphex(irq & RINTR_CMD_DONE, !=, 0);
+    g_assert_cmphex(qtest_readl(qts, MMC0_BASE + REG_RESP0) >> 16, ==, 0x4567);
+    irq = send_command(qts, CMD_RESP | 7, 0x45670000);
+    g_assert_cmphex(irq & RINTR_CMD_DONE, !=, 0);
+    irq = send_command(qts, CMD_RESP | 16, 512);
+    g_assert_cmphex(irq & RINTR_CMD_DONE, !=, 0);
+}
+
+static void read_gpt_marker(QTestState *qts, char marker[8])
+{
+    uint32_t desc[4] = {
+        cpu_to_le32(DESC_OWN | DESC_FIRST | DESC_LAST),
+        cpu_to_le32(512),
+        cpu_to_le32(RAM_DATA >> 2),
+        0,
+    };
+    uint32_t irq;
+
+    memset(marker, 0, 8);
+    qtest_memwrite(qts, RAM_DESC, desc, sizeof(desc));
+    qtest_memwrite(qts, RAM_DATA, marker, 8);
+    qtest_writel(qts, MMC0_BASE + REG_GCTRL, GCTRL_DMA_ENABLE);
+    qtest_writel(qts, MMC0_BASE + REG_BLKSZ, 512);
+    qtest_writel(qts, MMC0_BASE + REG_BCNTR, 512);
+    qtest_writel(qts, MMC0_BASE + REG_DLBA, RAM_DESC >> 2);
+    irq = send_command(qts, CMD_RESP | CMD_DATA | 17, 512);
+    g_assert_cmphex(irq & (RINTR_CMD_DONE | RINTR_DATA_OVER), ==,
+                    RINTR_CMD_DONE | RINTR_DATA_OVER);
+    qtest_memread(qts, RAM_DATA, marker, 8);
+    qtest_memread(qts, RAM_DESC, desc, sizeof(desc));
+    g_assert_cmphex(le32_to_cpu(desc[0]) & DESC_OWN, ==, 0);
+}
+
+static QTestState *start_with_image(const char *path)
+{
+    g_autofree char *quoted = g_shell_quote(path);
+
+    return qtest_initf("-M pocketforge-a133 -m 64M "
+                       "-drive if=sd,format=raw,file=%s", quoted);
+}
+
+static void test_real_media_and_controls(void)
+{
+    static const char valid_gpt[8] = "EFI PART";
+    static const char corrupt_gpt[8] = "BAD GPT!";
+    g_autofree char *valid_path = create_image(valid_gpt);
+    g_autofree char *corrupt_path = create_image(corrupt_gpt);
+    QTestState *qts;
+    char marker[8];
+    uint32_t irq;
+
+    /* Positive: shifted A100 DMA addresses fetch the raw GPT signature. */
+    qts = start_with_image(valid_path);
+    g_assert_cmphex(qtest_readl(qts, MMC0_BASE + REG_STAS) &
+                    STAS_CARD_PRESENT, !=, 0);
+    initialize_sd(qts);
+    read_gpt_marker(qts, marker);
+    g_assert_cmpmem(marker, sizeof(marker), valid_gpt, sizeof(valid_gpt));
+    qtest_quit(qts);
+
+    /* Negative control: bytes come from media; a corrupt GPT stays corrupt. */
+    qts = start_with_image(corrupt_path);
+    initialize_sd(qts);
+    read_gpt_marker(qts, marker);
+    g_assert_cmpmem(marker, sizeof(marker), corrupt_gpt, sizeof(corrupt_gpt));
+    g_assert_cmpint(memcmp(marker, valid_gpt, sizeof(marker)), !=, 0);
+    qtest_quit(qts);
+
+    /* Negative control: without media, commands receive no response. */
+    qts = qtest_init("-M pocketforge-a133 -m 64M");
+    irq = send_command(qts, CMD_RESP | 8, 0x1aa);
+    g_assert_cmphex(irq & RINTR_NO_RESP, !=, 0);
+    qtest_quit(qts);
+
+    g_assert_cmpint(unlink(valid_path), ==, 0);
+    g_assert_cmpint(unlink(corrupt_path), ==, 0);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pocketforge-a133/mmc/real-media-and-controls",
+                   test_real_media_and_controls);
+    return g_test_run();
+}
