-    { "pocketforge-a133.mmc0",             0x04020000, 0x1000 },
     { "pocketforge-a133.mmc1",             0x04021000, 0x1000 },
     { "pocketforge-a133.ledc",             0x05018000, 0x400 },
     { "pocketforge-a133.ths",              0x05070400, 0x100 },
@@ -513,6 +523,34 @@ static void pocketforge_a133_create_r_i2c0(PocketForgeA133MachineState *s,
