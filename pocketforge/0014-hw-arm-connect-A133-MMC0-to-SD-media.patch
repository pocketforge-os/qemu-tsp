     pocketforge_a133_create_mmio_stubs();
     pocketforge_a133_create_r_i2c0(s, pic[113]);
+    pocketforge_a133_create_mmc0(pic[PF_A133_MMC0_IRQ]);
 
     pocketforge_a133_create_virtio_mmio(machine, pic);
 
@@ -713,6 +752,8 @@ static void pocketforge_a133_machine_init(MachineClass *mc)
     mc->default_cpu_type = ARM_CPU_TYPE_NAME("cortex-a53");
     mc->default_ram_size = 1 * GiB;
     mc->default_ram_id = "pocketforge-a133.ram";
+    mc->block_default_type = IF_SD;
+    mc->units_per_default_bus = 1;
     mc->no_cdrom = true;
     mc->no_floppy = true;
     mc->no_parallel = true;
