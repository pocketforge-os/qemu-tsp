 /* rtc@7000000, exact reg range from sun50i-a100.dtsi. */
 #define PF_A133_RTC_BASE        0x07000000
 
+/* mmc@4020000 (MMC0), exact base and GIC SPI from sun50i-a100.dtsi. */
+#define PF_A133_MMC0_BASE       0x04020000
