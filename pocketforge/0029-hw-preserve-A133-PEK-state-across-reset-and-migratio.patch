From ca18baae7cbccb5157bc7b915e58b1f107ad80e0 Mon Sep 17 00:00:00 2001
From: PocketForge CI <ci@pocketforge.local>
Date: Sat, 10 Oct 2026 07:38:45 -0400
Subject: [PATCH 29/29] hw: preserve A133 PEK state across reset and migration

Assisted-by: LLM
---
 hw/arm/pocketforge_a133.c | 49 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 48 insertions(+), 1 deletion(-)

diff --git a/hw/arm/pocketforge_a133.c b/hw/arm/pocketforge_a133.c
index bb46cb3..983e4f1 100644
--- a/hw/arm/pocketforge_a133.c
+++ b/hw/arm/pocketforge_a133.c
@@ -116,8 +116,10 @@
 #include "hw/virtio/virtio-mmio.h"
 #include "hw/virtio/virtio-gpu.h"
 #include "exec/address-spaces.h"
+#include "migration/vmstate.h"
 #include "sysemu/device_tree.h"
 #include "sysemu/blockdev.h"
+#include "sysemu/reset.h"
 #include "hw/arm/fdt.h"
 #include "sysemu/sysemu.h"
 #include "qemu/module.h"
@@ -147,6 +149,7 @@ struct PocketForgeA133MachineState {
     uint32_t r_intc_pending;
     bool r_intc_source;
     bool power_key_held;
+    bool power_state_registered;
 };
 
 #define PF_A133_NATIVE_WIDTH 720
@@ -551,6 +554,41 @@ static void pocketforge_a133_r_intc_update(PocketForgeA133MachineState *s)
                  (s->r_intc_enable & s->r_intc_pending & 1) != 0);
 }
 
+static void pocketforge_a133_power_reset(void *opaque)
+{
+    PocketForgeA133MachineState *s = opaque;
+
+    s->r_intc_ctrl = 0;
+    s->r_intc_enable = 0;
+    s->r_intc_pending = 0;
+    s->r_intc_source = false;
+    s->power_key_held = false;
+    qemu_set_irq(s->r_intc_parent_irq, 0);
+}
+
+static int pocketforge_a133_power_post_load(void *opaque, int version_id)
+{
+    PocketForgeA133MachineState *s = opaque;
+
+    pocketforge_a133_r_intc_update(s);
+    return 0;
+}
+
+static const VMStateDescription vmstate_pocketforge_a133_power = {
+    .name = "pocketforge-a133/power",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = pocketforge_a133_power_post_load,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32(r_intc_ctrl, PocketForgeA133MachineState),
+        VMSTATE_UINT32(r_intc_enable, PocketForgeA133MachineState),
+        VMSTATE_UINT32(r_intc_pending, PocketForgeA133MachineState),
+        VMSTATE_BOOL(r_intc_source, PocketForgeA133MachineState),
+        VMSTATE_BOOL(power_key_held, PocketForgeA133MachineState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
 static uint64_t pocketforge_a133_r_intc_read(void *opaque, hwaddr offset,
                                              unsigned size)
 {
@@ -877,6 +915,9 @@ static void pocketforge_a133_init(MachineState *machine)
     pocketforge_a133_create_mmio_stubs();
     pocketforge_a133_create_r_i2c0(
         s, pic[113], pocketforge_a133_create_r_intc(s, pic[103]));
+    qemu_register_reset(pocketforge_a133_power_reset, s);
+    vmstate_register(NULL, 0, &vmstate_pocketforge_a133_power, s);
+    s->power_state_registered = true;
     pocketforge_a133_create_mmc0(pic[PF_A133_MMC0_IRQ]);
 
     pocketforge_a133_create_virtio_mmio(machine, pic);
@@ -1269,7 +1310,13 @@ static void pocketforge_a133_instance_init(Object *obj)
 
 static void pocketforge_a133_instance_finalize(Object *obj)
 {
-    g_free(POCKETFORGE_A133_MACHINE(obj)->display);
+    PocketForgeA133MachineState *s = POCKETFORGE_A133_MACHINE(obj);
+
+    if (s->power_state_registered) {
+        vmstate_unregister(NULL, &vmstate_pocketforge_a133_power, s);
+        qemu_unregister_reset(pocketforge_a133_power_reset, s);
+    }
+    g_free(s->display);
 }
 
 static const TypeInfo pocketforge_a133_machine_info = {
-- 
2.43.0
