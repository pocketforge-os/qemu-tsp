diff --git a/hw/misc/pocketforge_a133_ccu.c b/hw/misc/pocketforge_a133_ccu.c
new file mode 100644
index 0000000..22ebef0
--- /dev/null
+++ b/hw/misc/pocketforge_a133_ccu.c
@@ -0,0 +1,216 @@
+/*
+ * PocketForge OS -M pocketforge-a133 CCU (clock control unit) model
+ *
+ * Replaces the RAM-backed stub aperture at 0x03001000 with a stateful
+ * model of the register behavior the pinned A133 SPL relies on
+ * (clock_sun50i_h6.c:45-114): retained storage across the whole window,
+ * hardware-synthesized PLL LOCK (bit 28) once software sets ENABLE
+ * (bit 31) at the twelve PLL control words, and gate/reset-release state
+ * at UART +0x90c and MMC0 +0x84c exported to the machine, which enables
+ * the gated peripherals' MMIO windows only while both gate bit 0 and
+ * reset-release bit 16 are set.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/pocketforge_a133_ccu.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+
+#define PF_A133_CCU_PLL_ENABLE (UINT32_C(1) << 31)
+#define PF_A133_CCU_PLL_LOCK   (UINT32_C(1) << 28)
+
+static bool pf_a133_ccu_pll_reg(hwaddr offset)
+{
+    static const hwaddr pll_offsets[] = {
+        0x000, 0x010, 0x020, 0x028, 0x030, 0x040,
+        0x048, 0x050, 0x058, 0x060, 0x068, 0x078,
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(pll_offsets); i++) {
+        if (offset == pll_offsets[i]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool pf_a133_ccu_gate_reg(hwaddr offset, unsigned size)
+{
+    return (offset < PF_A133_CCU_UART0_GATE_REG + 4 &&
+            offset + size > PF_A133_CCU_UART0_GATE_REG) ||
+           (offset < PF_A133_CCU_MMC0_GATE_REG + 4 &&
+            offset + size > PF_A133_CCU_MMC0_GATE_REG);
+}
+
+static void pf_a133_ccu_pulse_notify(PfA133CcuState *s)
+{
+    if (s->gate_notify) {
+        qemu_irq_pulse(s->gate_notify);
+    }
+}
+
+static bool pf_a133_ccu_gate_open(PfA133CcuState *s, hwaddr reg)
+{
+    return (s->regs[reg / sizeof(uint32_t)] &
+            PF_A133_CCU_GATE_MASK) ==
+           PF_A133_CCU_GATE_MASK;
+}
+
+bool pf_a133_ccu_uart0_clocked(PfA133CcuState *s)
+{
+    return pf_a133_ccu_gate_open(s, PF_A133_CCU_UART0_GATE_REG);
+}
+
+bool pf_a133_ccu_mmc0_clocked(PfA133CcuState *s)
+{
+    return pf_a133_ccu_gate_open(s, PF_A133_CCU_MMC0_GATE_REG);
+}
+
+static uint64_t pf_a133_ccu_read(void *opaque, hwaddr offset, unsigned size)
+{
+    PfA133CcuState *s = opaque;
+    uint64_t val = 0;
+    unsigned int i;
+
+    if (offset + size > PF_A133_CCU_SIZE) {
+        return 0;
+    }
+    if (size == sizeof(uint32_t) && (offset & 3) == 0 &&
+        pf_a133_ccu_pll_reg(offset)) {
+        val = s->regs[offset / sizeof(uint32_t)];
+        /*
+         * A100 PLLs assert LOCK once software sets ENABLE.  The pinned SPL
+         * programs each PLL then synchronously polls this hardware-owned
+         * bit (bit 28) before dependent clocks may run.
+         */
+        if (val & PF_A133_CCU_PLL_ENABLE) {
+            val |= PF_A133_CCU_PLL_LOCK;
+        }
+        return val;
+    }
+    for (i = 0; i < size; i++) {
+        val |= (uint64_t)((s->regs[(offset + i) >> 2] >>
+                           (8 * ((offset + i) & 3))) & 0xff) << (8 * i);
+    }
+    return val;
+}
+
+static void pf_a133_ccu_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size)
+{
+    PfA133CcuState *s = opaque;
+    unsigned int i;
+
+    if (offset + size > PF_A133_CCU_SIZE) {
+        return;
+    }
+    for (i = 0; i < size; i++) {
+        uint32_t *word = &s->regs[(offset + i) >> 2];
+        unsigned int shift = 8 * ((offset + i) & 3);
+
+        *word = deposit32(*word, shift, 8, (value >> (8 * i)) & 0xff);
+    }
+    if (pf_a133_ccu_gate_reg(offset, size)) {
+        pf_a133_ccu_pulse_notify(s);
+    }
+}
+
+static const MemoryRegionOps pf_a133_ccu_ops = {
+    .read = pf_a133_ccu_read,
+    .write = pf_a133_ccu_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 8,
+    .impl.min_access_size = 1,
+    .impl.max_access_size = 8,
+};
+
+static void pf_a133_ccu_reset(DeviceState *dev)
+{
+    PfA133CcuState *s = POCKETFORGE_A133_CCU(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    if (s->preboot) {
+        /* Firmware left the UART0 and MMC0 bus gates on and resets released. */
+        s->regs[PF_A133_CCU_UART0_GATE_REG / 4] = PF_A133_CCU_GATE_MASK;
+        s->regs[PF_A133_CCU_MMC0_GATE_REG / 4] = PF_A133_CCU_GATE_MASK;
+    }
+    pf_a133_ccu_pulse_notify(s);
+}
+
+static int pf_a133_ccu_post_load(void *opaque, int version_id)
+{
+    pf_a133_ccu_pulse_notify(opaque);
+    return 0;
+}
+
+static const VMStateDescription vmstate_pocketforge_a133_ccu = {
+    .name = "pocketforge_a133_ccu",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = pf_a133_ccu_post_load,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, PfA133CcuState, PF_A133_CCU_NUM_REGS),
+        VMSTATE_BOOL(preboot, PfA133CcuState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void pf_a133_ccu_realize(DeviceState *dev, Error **errp)
+{
+    PfA133CcuState *s = POCKETFORGE_A133_CCU(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(s), &pf_a133_ccu_ops, s,
+                          "pocketforge-a133.ccu", PF_A133_CCU_SIZE);
+    sysbus_init_mmio(sbd, &s->iomem);
+    qdev_init_gpio_out_named(dev, &s->gate_notify, "gate-notify", 1);
+}
+
+static Property pf_a133_ccu_properties[] = {
+    DEFINE_PROP_BOOL("preboot", PfA133CcuState, preboot, false),
+};
+
+static void pf_a133_ccu_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = pf_a133_ccu_realize;
+    dc->reset = pf_a133_ccu_reset;
+    dc->vmsd = &vmstate_pocketforge_a133_ccu;
+    device_class_set_props(dc, pf_a133_ccu_properties);
+    /* Internal wiring only (machine-instantiated); no user-creatable bus. */
+    dc->user_creatable = false;
+}
+
+static const TypeInfo pf_a133_ccu_info = {
+    .name          = TYPE_POCKETFORGE_A133_CCU,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(PfA133CcuState),
+    .class_init    = pf_a133_ccu_class_init,
+};
+
+DeviceState *pocketforge_a133_ccu_create(hwaddr addr, bool preboot)
+{
+    DeviceState *dev = qdev_new(TYPE_POCKETFORGE_A133_CCU);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    qdev_prop_set_bit(dev, "preboot", preboot);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, addr);
+
+    return dev;
+}
+
+static void pf_a133_ccu_register_types(void)
+{
+    type_register_static(&pf_a133_ccu_info);
+}
+
+type_init(pf_a133_ccu_register_types)
diff --git a/hw/misc/pocketforge_a133_pio.c b/hw/misc/pocketforge_a133_pio.c
new file mode 100644
index 0000000..fbde5b0
--- /dev/null
+++ b/hw/misc/pocketforge_a133_pio.c
@@ -0,0 +1,180 @@
+/*
+ * PocketForge OS -M pocketforge-a133 PIO (main pinctrl) model
+ *
+ * Replaces the RAM-backed stub aperture at 0x0300b000 with a stateful
+ * model of the legacy-stride pinmux cells the pinned A133 SPL
+ * read-modify-writes (sunxi_gpio.c:74-158 with this SPL's 0x24 bank
+ * stride): 0x028 must carry function 2 in the PB9/PB10 nibbles before
+ * UART0 pins reach the DW-APB UART, and 0x0b4 must carry function 2 in
+ * all six PF0..PF5 nibbles before MMC0 pins reach the SD host.  The
+ * companion pull/drive cells (0x040, 0x0c8, 0x0d0) are retained storage.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/pocketforge_a133_pio.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+
+static bool pf_a133_pio_mux_reg(hwaddr offset, unsigned size)
+{
+    return (offset < PF_A133_PIO_PB_CFG1_REG + 4 &&
+            offset + size > PF_A133_PIO_PB_CFG1_REG) ||
+           (offset < PF_A133_PIO_PF_CFG0_REG + 4 &&
+            offset + size > PF_A133_PIO_PF_CFG0_REG);
+}
+
+static void pf_a133_pio_pulse_notify(PfA133PioState *s)
+{
+    if (s->mux_notify) {
+        qemu_irq_pulse(s->mux_notify);
+    }
+}
+
+bool pf_a133_pio_uart0_pins(PfA133PioState *s)
+{
+    return (s->regs[PF_A133_PIO_PB_CFG1_REG / 4] &
+            PF_A133_PIO_PB_UART0_MASK) ==
+           PF_A133_PIO_PB_UART0_FUNC2;
+}
+
+bool pf_a133_pio_mmc0_pins(PfA133PioState *s)
+{
+    return (s->regs[PF_A133_PIO_PF_CFG0_REG / 4] &
+            PF_A133_PIO_PF_MMC0_MASK) ==
+           PF_A133_PIO_PF_MMC0_FUNC2;
+}
+
+static uint64_t pf_a133_pio_read(void *opaque, hwaddr offset, unsigned size)
+{
+    PfA133PioState *s = opaque;
+    uint64_t val = 0;
+    unsigned int i;
+
+    if (offset + size > PF_A133_PIO_SIZE) {
+        return 0;
+    }
+    for (i = 0; i < size; i++) {
+        val |= (uint64_t)((s->regs[(offset + i) >> 2] >>
+                           (8 * ((offset + i) & 3))) & 0xff) << (8 * i);
+    }
+    return val;
+}
+
+static void pf_a133_pio_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size)
+{
+    PfA133PioState *s = opaque;
+    unsigned int i;
+
+    if (offset + size > PF_A133_PIO_SIZE) {
+        return;
+    }
+    for (i = 0; i < size; i++) {
+        uint32_t *word = &s->regs[(offset + i) >> 2];
+        unsigned int shift = 8 * ((offset + i) & 3);
+
+        *word = deposit32(*word, shift, 8, (value >> (8 * i)) & 0xff);
+    }
+    if (pf_a133_pio_mux_reg(offset, size)) {
+        pf_a133_pio_pulse_notify(s);
+    }
+}
+
+static const MemoryRegionOps pf_a133_pio_ops = {
+    .read = pf_a133_pio_read,
+    .write = pf_a133_pio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 8,
+    .impl.min_access_size = 1,
+    .impl.max_access_size = 8,
+};
+
+static void pf_a133_pio_reset(DeviceState *dev)
+{
+    PfA133PioState *s = POCKETFORGE_A133_PIO(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    if (s->preboot) {
+        /* Firmware left UART0 on PB9/PB10 and MMC0 on PF0..PF5 muxed. */
+        s->regs[PF_A133_PIO_PB_CFG1_REG / 4] = PF_A133_PIO_PB_UART0_FUNC2;
+        s->regs[PF_A133_PIO_PF_CFG0_REG / 4] = PF_A133_PIO_PF_MMC0_FUNC2;
+    }
+    pf_a133_pio_pulse_notify(s);
+}
+
+static int pf_a133_pio_post_load(void *opaque, int version_id)
+{
+    pf_a133_pio_pulse_notify(opaque);
+    return 0;
+}
+
+static const VMStateDescription vmstate_pocketforge_a133_pio = {
+    .name = "pocketforge_a133_pio",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = pf_a133_pio_post_load,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, PfA133PioState, PF_A133_PIO_NUM_REGS),
+        VMSTATE_BOOL(preboot, PfA133PioState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void pf_a133_pio_realize(DeviceState *dev, Error **errp)
+{
+    PfA133PioState *s = POCKETFORGE_A133_PIO(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(s), &pf_a133_pio_ops, s,
+                          "pocketforge-a133.pio", PF_A133_PIO_SIZE);
+    sysbus_init_mmio(sbd, &s->iomem);
+    qdev_init_gpio_out_named(dev, &s->mux_notify, "mux-notify", 1);
+}
+
+static Property pf_a133_pio_properties[] = {
+    DEFINE_PROP_BOOL("preboot", PfA133PioState, preboot, false),
+};
+
+static void pf_a133_pio_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = pf_a133_pio_realize;
+    dc->reset = pf_a133_pio_reset;
+    dc->vmsd = &vmstate_pocketforge_a133_pio;
+    device_class_set_props(dc, pf_a133_pio_properties);
+    /* Internal wiring only (machine-instantiated); no user-creatable bus. */
+    dc->user_creatable = false;
+}
+
+static const TypeInfo pf_a133_pio_info = {
+    .name          = TYPE_POCKETFORGE_A133_PIO,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(PfA133PioState),
+    .class_init    = pf_a133_pio_class_init,
+};
+
+DeviceState *pocketforge_a133_pio_create(hwaddr addr, bool preboot)
+{
+    DeviceState *dev = qdev_new(TYPE_POCKETFORGE_A133_PIO);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    qdev_prop_set_bit(dev, "preboot", preboot);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, addr);
+
+    return dev;
+}
+
+static void pf_a133_pio_register_types(void)
+{
+    type_register_static(&pf_a133_pio_info);
+}
+
+type_init(pf_a133_pio_register_types)
diff --git a/include/hw/misc/pocketforge_a133_ccu.h b/include/hw/misc/pocketforge_a133_ccu.h
new file mode 100644
index 0000000..de3e1bf
--- /dev/null
+++ b/include/hw/misc/pocketforge_a133_ccu.h
@@ -0,0 +1,49 @@
+/*
+ * PocketForge OS -M pocketforge-a133 CCU (clock control unit) model
+ *
+ * Stateful model of the exact early-boot CCU window the pinned A133 SPL
+ * (U-Boot SPL 2025.10-gdb70249c8b25, pocketforge-os/u-boot-tsp-a133
+ * db70249c8b25, tg5040_defconfig) programs: PLL lock synthesis at the
+ * twelve PLL control words, ordinary retained storage for the bus factor
+ * words, and gate/reset-release state at UART +0x90c and MMC0 +0x84c that
+ * the machine wires to the gated peripherals' MMIO windows.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#ifndef HW_MISC_POCKETFORGE_A133_CCU_H
+#define HW_MISC_POCKETFORGE_A133_CCU_H
+
+#include "hw/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_POCKETFORGE_A133_CCU "pocketforge-a133-ccu"
+OBJECT_DECLARE_SIMPLE_TYPE(PfA133CcuState, POCKETFORGE_A133_CCU)
+
+#define PF_A133_CCU_SIZE      0x1000
+#define PF_A133_CCU_NUM_REGS  (PF_A133_CCU_SIZE / sizeof(uint32_t))
+
+/* SPL-touched bus gate/reset words (CCU +0x90c UART, +0x84c MMC0). */
+#define PF_A133_CCU_MMC0_GATE_REG   0x84c
+#define PF_A133_CCU_UART0_GATE_REG  0x90c
+#define PF_A133_CCU_GATE_MASK       0x00010001u /* bit0 gate | bit16 reset */
+
+struct PfA133CcuState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq gate_notify;
+    uint32_t regs[PF_A133_CCU_NUM_REGS];
+    /*
+     * Direct-kernel boots skip the firmware that programs these gates; the
+     * machine sets "preboot" so reset restores the firmware-left state and
+     * the gate getters report open regardless of later register traffic.
+     */
+    bool preboot;
+};
+
+DeviceState *pocketforge_a133_ccu_create(hwaddr addr, bool preboot);
+bool pf_a133_ccu_uart0_clocked(PfA133CcuState *s);
+bool pf_a133_ccu_mmc0_clocked(PfA133CcuState *s);
+
+#endif
diff --git a/include/hw/misc/pocketforge_a133_pio.h b/include/hw/misc/pocketforge_a133_pio.h
new file mode 100644
index 0000000..214e5f3
--- /dev/null
+++ b/include/hw/misc/pocketforge_a133_pio.h
@@ -0,0 +1,47 @@
+/*
+ * PocketForge OS -M pocketforge-a133 PIO (main pinctrl) model
+ *
+ * Stateful model of the exact legacy-stride (0x24 per bank) pinmux cells
+ * the pinned A133 SPL read-modify-writes: 0x028 (PB9/PB10 function 2,
+ * UART0) and 0x0b4 (PF0..PF5 function 2, MMC0), with the companion pull
+ * and drive cells retained as storage.  Function-select state is exported
+ * so the machine can wire the muxed peripherals' MMIO windows.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#ifndef HW_MISC_POCKETFORGE_A133_PIO_H
+#define HW_MISC_POCKETFORGE_A133_PIO_H
+
+#include "hw/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_POCKETFORGE_A133_PIO "pocketforge-a133-pio"
+OBJECT_DECLARE_SIMPLE_TYPE(PfA133PioState, POCKETFORGE_A133_PIO)
+
+#define PF_A133_PIO_SIZE      0x400
+#define PF_A133_PIO_NUM_REGS  (PF_A133_PIO_SIZE / sizeof(uint32_t))
+
+/* SPL-touched legacy-stride function-select cells. */
+#define PF_A133_PIO_PB_CFG1_REG 0x028 /* PB9/PB10 nibbles -> UART0 func 2 */
+#define PF_A133_PIO_PF_CFG0_REG 0x0b4 /* PF0..PF5 nibbles -> MMC0 func 2 */
+#define PF_A133_PIO_PB_UART0_MASK  0x00000ff0u /* nibbles 1 and 2 (PB9/10) */
+#define PF_A133_PIO_PB_UART0_FUNC2 0x00000220u
+#define PF_A133_PIO_PF_MMC0_MASK   0x00ffffffu /* nibbles 0..5 (PF0..PF5) */
+#define PF_A133_PIO_PF_MMC0_FUNC2  0x00222222u
+
+struct PfA133PioState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq mux_notify;
+    uint32_t regs[PF_A133_PIO_NUM_REGS];
+    /* See PfA133CcuState.preboot: firmware-left pinmux for direct boots. */
+    bool preboot;
+};
+
+DeviceState *pocketforge_a133_pio_create(hwaddr addr, bool preboot);
+bool pf_a133_pio_uart0_pins(PfA133PioState *s);
+bool pf_a133_pio_mmc0_pins(PfA133PioState *s);
+
+#endif
