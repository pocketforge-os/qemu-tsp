 }
 
+/*
+ * The pinned SPL opens each muxed peripheral exactly twice: the CCU bus
+ * gate/reset word (+0x90c UART0, +0x84c MMC0, gate bit 0 then release
+ * bit 16, the MMC one explicitly read back before a settle delay) and the
+ * legacy-stride PIO function cells (0x028 PB9/PB10 func 2, 0x0b4 PF0..PF5
+ * func 2).  Until both are programmed the peripheral window stays disabled:
+ * reads decode as 0 and writes are dropped, matching an unclocked/unmuxed
+ * bus on real silicon.  The CCU and PIO devices pulse this handler on every
+ * gate/mux write and on reset.
+ */
+static void pocketforge_a133_gate_update(void *opaque, int n, int level)
+{
+    PocketForgeA133MachineState *s = opaque;
+
+    memory_region_set_enabled(s->uart0_mmio,
+                              pf_a133_ccu_uart0_clocked(s->ccu) &&
+                              pf_a133_pio_uart0_pins(s->pio));
+    memory_region_set_enabled(s->mmc0_mmio,
+                              pf_a133_ccu_mmc0_clocked(s->ccu) &&
+                              pf_a133_pio_mmc0_pins(s->pio));
+}
+
+static void pocketforge_a133_create_ccu_pio(PocketForgeA133MachineState *s,
+                                            MachineState *machine)
+{
+    qemu_irq gate_irq;
+    /*
+     * Direct-kernel boots (-kernel) skip the firmware that programs these
+     * gates, so model its left-behind state: reset restores open gates and
+     * muxed pins.  BootROM and qtest boots start closed and must program
+     * the SPL sequence themselves.
+     */
+    bool preboot = machine->kernel_filename != NULL;
+
+    s->ccu = POCKETFORGE_A133_CCU(pocketforge_a133_ccu_create(
+        PF_A133_CCU_BASE, preboot));
+    s->pio = POCKETFORGE_A133_PIO(pocketforge_a133_pio_create(
+        PF_A133_PIO_BASE, preboot));
+
+    gate_irq = qemu_allocate_irq(pocketforge_a133_gate_update, s, 0);
+    qdev_connect_gpio_out_named(DEVICE(s->ccu), "gate-notify", 0, gate_irq);
+    qdev_connect_gpio_out_named(DEVICE(s->pio), "mux-notify", 0, gate_irq);
+    pocketforge_a133_gate_update(s, 0, 0);
+}
+
 static void pocketforge_a133_create_gic(MachineState *machine, qemu_irq *pic)
 {
     DeviceState *gicdev;
@@ -1084,6 +1135,11 @@ static void pocketforge_a133_init(MachineState *machine)
         DeviceState *uart_dev = dw_apb_uart_create(
