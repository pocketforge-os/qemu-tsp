+            s->uart0_mmio = sysbus_mmio_get_region(SYS_BUS_DEVICE(uart_dev),
+                                                   0);
+        }
         if (uart->serial_index == 2) {
             s->gamepad_uart[0] = DW_APB_UART(uart_dev);
         } else if (uart->serial_index == 3) {
@@ -1114,6 +1170,7 @@ static void pocketforge_a133_init(MachineState *machine)
     vmstate_register(NULL, 0, &vmstate_pocketforge_a133_power, s);
     s->power_state_registered = true;
     pocketforge_a133_create_mmc0(s, pic[PF_A133_MMC0_IRQ]);
+    pocketforge_a133_create_ccu_pio(s, machine);
 
     pocketforge_a133_create_virtio_mmio(machine, pic);
 
