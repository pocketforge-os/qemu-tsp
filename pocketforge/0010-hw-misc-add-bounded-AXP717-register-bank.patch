diff --git a/tests/qtest/pocketforge-a133-axp717-test.c b/tests/qtest/pocketforge-a133-axp717-test.c
new file mode 100644
index 0000000..4fd051c
--- /dev/null
+++ b/tests/qtest/pocketforge-a133-axp717-test.c
@@ -0,0 +1,108 @@
+/*
+ * PocketForge A133 AXP717 PMIC qtest
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest-single.h"
+
+#define R_I2C0_BASE 0x07081400
+#define TWI_DATA    0x08
+#define TWI_CNTR    0x0c
+#define TWI_STAT    0x10
+
+#define CNTR_BUS_ENABLE 0x40
+#define CNTR_START      0x20
+#define CNTR_STOP       0x10
+
+#define STAT_START          0x08
+#define STAT_ADDR_WR_ACK    0x18
+#define STAT_ADDR_WR_NACK   0x20
+#define STAT_DATA_TX_ACK    0x28
+#define STAT_ADDR_RD_ACK    0x40
+
+static uint32_t i2c_status(void)
+{
+    return qtest_readl(global_qtest, R_I2C0_BASE + TWI_STAT);
+}
+
+static void i2c_start(void)
+{
+    qtest_writel(global_qtest, R_I2C0_BASE + TWI_CNTR,
+                 CNTR_BUS_ENABLE | CNTR_START);
+    g_assert_cmphex(i2c_status(), ==, STAT_START);
+}
+
+static void i2c_stop(void)
+{
+    qtest_writel(global_qtest, R_I2C0_BASE + TWI_CNTR,
+                 CNTR_BUS_ENABLE | CNTR_STOP);
+}
+
+static void i2c_send(uint8_t value, uint32_t expected_status)
+{
+    qtest_writel(global_qtest, R_I2C0_BASE + TWI_DATA, value);
+    g_assert_cmphex(i2c_status(), ==, expected_status);
+}
+
+static void axp717_write(uint8_t reg, uint8_t value)
+{
+    i2c_start();
+    i2c_send(0x34 << 1, STAT_ADDR_WR_ACK);
+    i2c_send(reg, STAT_DATA_TX_ACK);
+    i2c_send(value, STAT_DATA_TX_ACK);
+    i2c_stop();
+}
+
+static uint8_t axp717_read(uint8_t reg)
+{
+    uint8_t value;
+
+    i2c_start();
+    i2c_send(0x34 << 1, STAT_ADDR_WR_ACK);
+    i2c_send(reg, STAT_DATA_TX_ACK);
+    i2c_stop();
+
+    i2c_start();
+    i2c_send((0x34 << 1) | 1, STAT_ADDR_RD_ACK);
+    value = qtest_readl(global_qtest, R_I2C0_BASE + TWI_DATA);
+    i2c_stop();
+
+    return value;
+}
+
+static void test_register_bank_and_unpopulated_nack(void)
+{
+    /* Positive paths: IRQ enable and regulator control registers persist. */
+    axp717_write(0x40, 0xa5);
+    g_assert_cmphex(axp717_read(0x40), ==, 0xa5);
+    axp717_write(0x90, 0x12);
+    axp717_write(0x91, 0x34);
+    g_assert_cmphex(axp717_read(0x90), ==, 0x12);
+    g_assert_cmphex(axp717_read(0x91), ==, 0x34);
+
+    /* IRQ status is W1C and starts clear; unmodelled registers read zero. */
+    axp717_write(0x48, 0xff);
+    g_assert_cmphex(axp717_read(0x48), ==, 0);
+    g_assert_cmphex(axp717_read(0x20), ==, 0);
+
+    /* Negative control: no device is populated at the adjacent address. */
+    i2c_start();
+    i2c_send(0x35 << 1, STAT_ADDR_WR_NACK);
+    i2c_stop();
+}
+
+int main(int argc, char **argv)
+{
+    int ret;
+
+    g_test_init(&argc, &argv, NULL);
+    qtest_start("-machine pocketforge-a133 -display none");
+    qtest_add_func("/pocketforge-a133/axp717/register-bank-and-nack",
+                   test_register_bank_and_unpopulated_nack);
+    ret = g_test_run();
+    qtest_end();
+
+    return ret;
+}
