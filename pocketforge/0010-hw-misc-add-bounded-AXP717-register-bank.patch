@@ -505,6 +506,7 @@ static void pocketforge_a133_create_r_i2c0(PocketForgeA133MachineState *s,
                                 &s->r_i2c0_container);
     sysbus_connect_irq(sbd, 0, irq);
     s->r_i2c0_bus = AW_I2C(dev)->bus;
+    i2c_slave_create_simple(s->r_i2c0_bus, "axp717_pmu", 0x34);
 }
 
 static void pocketforge_a133_create_gic(MachineState *machine, qemu_irq *pic)
diff --git a/hw/misc/axp2xx.c b/hw/misc/axp2xx.c
index 41538c1..d0fd6d5 100644
--- a/hw/misc/axp2xx.c
+++ b/hw/misc/axp2xx.c
@@ -2,6 +2,7 @@
  * AXP-2XX PMU Emulation, supported lists:
  *   AXP209
  *   AXP221
+ *   AXP717 (bounded register bank for regulator discovery)
  *
  * Copyright (C) 2022 Strahinja Jankovic <strahinja.p.jankovic@gmail.com>
  * Copyright (C) 2023 qianfan Zhao <qianfanguijin@163.com>
@@ -37,6 +38,7 @@
 #define TYPE_AXP2XX     "axp2xx_pmu"
 #define TYPE_AXP209_PMU "axp209_pmu"
 #define TYPE_AXP221_PMU "axp221_pmu"
+#define TYPE_AXP717_PMU "axp717_pmu"
 
 OBJECT_DECLARE_TYPE(AXP2xxI2CState, AXP2xxClass, AXP2XX)
 
@@ -57,6 +59,8 @@ typedef struct AXP2xxClass {
     I2CSlaveClass parent_class;
     /*< public >*/
     void (*reset_enter)(AXP2xxI2CState *s, ResetType type);
+    uint8_t (*read)(AXP2xxI2CState *s, uint8_t reg);
+    void (*write)(AXP2xxI2CState *s, uint8_t reg, uint8_t value);
 } AXP2xxClass;
 
 #define AXP209_CHIP_VERSION_ID             (0x01)
@@ -160,6 +164,42 @@ static void axp221_reset_enter(AXP2xxI2CState *s, ResetType type)
     s->regs[0xe6] = 0xa0;
 }
 
+/*
+ * The AXP717 subtype is deliberately only a software-visible register bank.
+ * It models IRQ enable 0x40..0x44, W1C IRQ status 0x48..0x4c, regulator
+ * enable 0x80, and regulator voltage/enable controls 0x83..0x9f.  Those
+ * values only report prior guest writes: they are not hardware measurements.
+ * Unmodelled registers read as zero and ignore writes.  The model generates
+ * no PMIC events and has no interrupt output.
+ */
+static bool axp717_reg_is_modelled(uint8_t reg)
+{
+    return (reg >= 0x40 && reg <= 0x44) ||
+           (reg >= 0x48 && reg <= 0x4c) || reg == 0x80 ||
+           (reg >= 0x83 && reg <= 0x9f);
+}
+
+static uint8_t axp717_read(AXP2xxI2CState *s, uint8_t reg)
+{
+    return axp717_reg_is_modelled(reg) ? s->regs[reg] : 0;
+}
+
+static void axp717_write(AXP2xxI2CState *s, uint8_t reg, uint8_t value)
+{
+    if (reg >= 0x48 && reg <= 0x4c) {
+        s->regs[reg] &= ~value;
+    } else if (axp717_reg_is_modelled(reg)) {
+        s->regs[reg] = value;
+    }
+}
+
+static void axp717_reset_enter(AXP2xxI2CState *s, ResetType type)
+{
+    memset(s->regs, 0, NR_REGS);
+    s->ptr = 0;
+    s->count = 0;
+}
+
 static void axp2xx_reset_enter(Object *obj, ResetType type)
 {
     AXP2xxI2CState *s = AXP2XX(obj);
@@ -182,10 +222,12 @@ static int axp2xx_event(I2CSlave *i2c, enum i2c_event event)
 static uint8_t axp2xx_rx(I2CSlave *i2c)
 {
     AXP2xxI2CState *s = AXP2XX(i2c);
+    AXP2xxClass *sc = AXP2XX_GET_CLASS(s);
     uint8_t ret = 0xff;
 
     if (s->ptr < NR_REGS) {
-        ret = s->regs[s->ptr++];
+        ret = sc->read ? sc->read(s, s->ptr) : s->regs[s->ptr];
+        s->ptr++;
     }
 
     trace_axp2xx_rx(s->ptr - 1, ret);
@@ -200,6 +242,7 @@ static uint8_t axp2xx_rx(I2CSlave *i2c)
 static int axp2xx_tx(I2CSlave *i2c, uint8_t data)
 {
     AXP2xxI2CState *s = AXP2XX(i2c);
+    AXP2xxClass *sc = AXP2XX_GET_CLASS(s);
 
     if (s->count == 0) {
         /* Store register address */
@@ -208,7 +251,12 @@ static int axp2xx_tx(I2CSlave *i2c, uint8_t data)
         trace_axp2xx_select(data);
     } else {
         trace_axp2xx_tx(s->ptr, data);
-        s->regs[s->ptr++] = data;
+        if (sc->write) {
+            sc->write(s, s->ptr, data);
+        } else {
+            s->regs[s->ptr] = data;
+        }
+        s->ptr++;
     }
 
     return 0;
@@ -273,11 +321,27 @@ static const TypeInfo axp221_info = {
     .class_init = axp221_class_init,
 };
 
+static void axp717_class_init(ObjectClass *oc, void *data)
+{
+    AXP2xxClass *sc = AXP2XX_CLASS(oc);
+
+    sc->reset_enter = axp717_reset_enter;
+    sc->read = axp717_read;
+    sc->write = axp717_write;
+}
+
+static const TypeInfo axp717_info = {
+    .name = TYPE_AXP717_PMU,
+    .parent = TYPE_AXP2XX,
+    .class_init = axp717_class_init,
+};
+
 static void axp2xx_register_devices(void)
 {
     type_register_static(&axp2xx_info);
     type_register_static(&axp209_info);
     type_register_static(&axp221_info);
+    type_register_static(&axp717_info);
 }
 
 type_init(axp2xx_register_devices);
