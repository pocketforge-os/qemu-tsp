+bool virtio_input_send_batch(VirtIOInput *vinput,
+                             const virtio_input_event *events,
+                             size_t count)
+{
+    VirtQueueElement **elems;
+    size_t i;
+    int len;
+
+    if (!vinput->active || !count ||
+        !virtqueue_avail_bytes(vinput->evt,
+                               count * sizeof(virtio_input_event), 0)) {
+        trace_virtio_input_queue_full();
+        return false;
+    }
+
+    elems = g_new0(VirtQueueElement *, count);
+    for (i = 0; i < count; i++) {
+        elems[i] = virtqueue_pop(vinput->evt, sizeof(VirtQueueElement));
+        if (!elems[i]) {
+            while (i > 0) {
+                i--;
+                virtqueue_unpop(vinput->evt, elems[i], 0);
+                g_free(elems[i]);
+            }
+            g_free(elems);
+            trace_virtio_input_queue_full();
+            return false;
+        }
+    }
+
+    for (i = 0; i < count; i++) {
+        if (iov_size(elems[i]->in_sg, elems[i]->in_num) <
+            sizeof(events[i])) {
+            size_t rollback = count;
+
+            while (rollback > 0) {
+                rollback--;
+                virtqueue_unpop(vinput->evt, elems[rollback], 0);
+                g_free(elems[rollback]);
+            }
+            g_free(elems);
+            trace_virtio_input_queue_full();
+            return false;
+        }
+    }
+
+    for (i = 0; i < count; i++) {
+        len = iov_from_buf(elems[i]->in_sg, elems[i]->in_num, 0,
+                           &events[i], sizeof(events[i]));
+        virtqueue_push(vinput->evt, elems[i], len);
+        g_free(elems[i]);
+    }
+    g_free(elems);
+    virtio_notify(VIRTIO_DEVICE(vinput), vinput->evt);
+    return true;
+}
