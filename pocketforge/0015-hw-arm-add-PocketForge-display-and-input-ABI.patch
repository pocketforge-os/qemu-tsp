+static void test_raw_qmp_abi(void)
+{
+    static const ControlCase keys[] = {
+        { NULL, EV_KEY, BTN_SOUTH, 1 }, { NULL, EV_KEY, BTN_EAST, 1 },
+        { NULL, EV_KEY, BTN_NORTH, 1 }, { NULL, EV_KEY, BTN_WEST, 1 },
+        { NULL, EV_KEY, BTN_TL, 1 }, { NULL, EV_KEY, BTN_TR, 1 },
+        { NULL, EV_KEY, BTN_SELECT, 1 }, { NULL, EV_KEY, BTN_START, 1 },
+        { NULL, EV_KEY, BTN_MODE, 1 },
+    };
+    static const ControlCase axes[] = {
+        { NULL, EV_ABS, ABS_X, 4095 }, { NULL, EV_ABS, ABS_Y, 0 },
+        { NULL, EV_ABS, ABS_RX, 2048 }, { NULL, EV_ABS, ABS_RY, 1024 },
+        { NULL, EV_ABS, ABS_Z, 255 }, { NULL, EV_ABS, ABS_RZ, 0 },
+    };
+    InputFixture f;
+    EventBuffers buffers;
+    QDict *response;
+    QDict *result;
+    QDict *version;
+    GString *oversize;
+    int i;
+
+    input_fixture_init(&f, true);
+    g_assert_cmpuint(f.vq->size, ==, 1024);
+    response = qtest_qmp(f.qts,
+                         "{ 'execute': 'query-pocketforge-input' }");
+    result = qdict_get_qdict(response, "return");
+    version = qdict_get_qdict(result, "abi_version");
+    g_assert_cmpint(qdict_get_int(version, "major"), ==, 1);
+    g_assert_cmpint(qdict_get_int(version, "minor"), ==, 0);
+    g_assert_cmpint(qdict_get_int(result, "max_batch_events"), ==, 256);
+    qobject_unref(response);
+
+    for (i = 0; i < ARRAY_SIZE(keys); i++) {
+        buffers = add_event_buffers(&f);
+        response = raw_send(&f, keys[i].type, keys[i].code, 1);
+        g_assert_true(qdict_haskey(response, "return"));
+        qobject_unref(response);
+        assert_event_pair(&f, &buffers, EV_KEY, keys[i].code, 1);
+
+        buffers = add_event_buffers(&f);
+        response = raw_send(&f, keys[i].type, keys[i].code, 0);
+        g_assert_true(qdict_haskey(response, "return"));
+        qobject_unref(response);
+        assert_event_pair(&f, &buffers, EV_KEY, keys[i].code, 0);
+    }
+    for (i = 0; i < ARRAY_SIZE(axes); i++) {
+        buffers = add_event_buffers(&f);
+        response = raw_send(&f, axes[i].type, axes[i].code, axes[i].pressed);
+        g_assert_true(qdict_haskey(response, "return"));
+        qobject_unref(response);
+        assert_event_pair(&f, &buffers, EV_ABS, axes[i].code, axes[i].pressed);
+    }
+    buffers = add_event_buffers(&f);
+    response = raw_send(&f, EV_ABS, ABS_HAT0X, -1);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    assert_event_pair(&f, &buffers, EV_ABS, ABS_HAT0X, -1);
+    buffers = add_event_buffers(&f);
+    response = raw_send(&f, EV_ABS, ABS_HAT0X, 0);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    assert_event_pair(&f, &buffers, EV_ABS, ABS_HAT0X, 0);
+
+    assert_raw_error(&f, EV_MSC, 0, 0,
+                     "pocketforge-input: reason=invalid-parameter index=0:");
+    assert_raw_error(&f, EV_KEY, KEY_POWER, 1,
+                     "pocketforge-input: reason=invalid-parameter index=0:");
+    assert_raw_error(&f, EV_ABS, ABS_X, 4096,
+                     "pocketforge-input: reason=invalid-parameter index=0:");
+
+    response = qtest_qmp(f.qts,
+                         "{ 'execute': 'pocketforge-input-send',"
+                         " 'arguments': { 'device': 'gamepad', 'events': ["
+                         " { 'type': 1, 'code': 304, 'value': 1 } ] } }");
+    g_assert_true(g_str_has_prefix(
+        qdict_get_str(qdict_get_qdict(response, "error"), "desc"),
+        "pocketforge-input: reason=invalid-parameter index=0:"));
+    qobject_unref(response);
+
+    response = qtest_qmp(f.qts,
+                         "{ 'execute': 'pocketforge-input-send',"
+                         " 'arguments': { 'device': 'gamepad', 'events': ["
+                         " { 'type': 0, 'code': 0, 'value': 0 } ] } }");
+    g_assert_true(g_str_has_prefix(
+        qdict_get_str(qdict_get_qdict(response, "error"), "desc"),
+        "pocketforge-input: reason=invalid-parameter index=0:"));
+    qobject_unref(response);
+
+    oversize = g_string_new(
+        "{ 'execute': 'pocketforge-input-send', 'arguments': {"
+        " 'device': 'gamepad', 'events': [");
+    for (i = 0; i < 257; i++) {
+        g_string_append_printf(oversize, "%s{ 'type': 0, 'code': 0, "
+                               "'value': 0 }", i ? "," : "");
+    }
+    g_string_append(oversize, "] } }");
+    qtest_qmp_send_raw(f.qts, "%s\n", oversize->str);
+    response = qtest_qmp_receive(f.qts);
+    g_string_free(oversize, TRUE);
+    g_test_message("oversize rejection: %s",
+                   qdict_get_str(qdict_get_qdict(response, "error"), "desc"));
+    g_assert_true(g_str_has_prefix(
