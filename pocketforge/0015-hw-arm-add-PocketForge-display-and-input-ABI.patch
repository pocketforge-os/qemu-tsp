+#define PF_RAM_BASE 0x40000000
+#define PF_RAM_END  0x41000000
+#define VIRTIO_MMIO_QUEUE_READY     0x044
+#define VIRTIO_MMIO_QUEUE_DESC_LOW  0x080
+#define VIRTIO_MMIO_QUEUE_DESC_HIGH 0x084
+#define VIRTIO_MMIO_QUEUE_AVAIL_LOW 0x090
+#define VIRTIO_MMIO_QUEUE_AVAIL_HIGH 0x094
+#define VIRTIO_MMIO_QUEUE_USED_LOW  0x0a0
+#define VIRTIO_MMIO_QUEUE_USED_HIGH 0x0a4
+
+typedef struct GpuFixture {
+    QTestState *qts;
+    QVirtioMMIODevice mmio;
+    QGuestAllocator alloc;
+    QVirtQueue *vq;
+    uint64_t framebuffer_addr;
+} GpuFixture;
+
+typedef struct DisplayTest {
+    GMainLoop *loop;
+    GThread *thread;
+    GDBusConnection *listener_conn;
+    GDBusObjectManagerServer *server;
+    guint width;
+    guint height;
+    guint stride;
+    guint format;
+    gsize bytes;
+    uint8_t first[4];
+    uint8_t last[4];
+    bool got_update;
+    int update_x;
+    int update_y;
+    int update_width;
+    int update_height;
+    guint update_stride;
+    guint update_format;
+    gsize update_bytes;
+    uint8_t update_pixel[4];
+} DisplayTest;
+
+static QVirtQueue *setup_modern_queue(GpuFixture *f, uint16_t index)
+{
+    QVirtQueue *vq = g_new0(QVirtQueue, 1);
+    uint64_t addr;
+
+    vq->vdev = &f->mmio.vdev;
+    vq->index = index;
+    vq->align = 4096;
+    qtest_writel(f->qts, PF_GPU_MMIO_BASE + QVIRTIO_MMIO_QUEUE_SEL, index);
+    vq->size = qtest_readl(f->qts, PF_GPU_MMIO_BASE +
+                           QVIRTIO_MMIO_QUEUE_NUM_MAX);
+    g_assert_cmpuint(vq->size, >, 0);
+    vq->num_free = vq->size;
+    qtest_writel(f->qts, PF_GPU_MMIO_BASE + QVIRTIO_MMIO_QUEUE_NUM,
+                 vq->size);
+    addr = guest_alloc(&f->alloc, qvring_size(vq->size, vq->align));
+    qvring_init(f->qts, &f->alloc, vq, addr);
+    qtest_writel(f->qts, PF_GPU_MMIO_BASE + VIRTIO_MMIO_QUEUE_DESC_LOW,
+                 vq->desc);
+    qtest_writel(f->qts, PF_GPU_MMIO_BASE + VIRTIO_MMIO_QUEUE_DESC_HIGH,
+                 vq->desc >> 32);
+    qtest_writel(f->qts, PF_GPU_MMIO_BASE + VIRTIO_MMIO_QUEUE_AVAIL_LOW,
+                 vq->avail);
+    qtest_writel(f->qts, PF_GPU_MMIO_BASE + VIRTIO_MMIO_QUEUE_AVAIL_HIGH,
+                 vq->avail >> 32);
+    qtest_writel(f->qts, PF_GPU_MMIO_BASE + VIRTIO_MMIO_QUEUE_USED_LOW,
+                 vq->used);
+    qtest_writel(f->qts, PF_GPU_MMIO_BASE + VIRTIO_MMIO_QUEUE_USED_HIGH,
+                 vq->used >> 32);
+    qtest_writel(f->qts, PF_GPU_MMIO_BASE + VIRTIO_MMIO_QUEUE_READY, 1);
+    return vq;
+}
+
+static void gpu_fixture_init(GpuFixture *f, QTestState *qts)
+{
+    uint64_t features;
+
+    memset(f, 0, sizeof(*f));
+    f->qts = qts;
+    g_assert_cmphex(qtest_readl(qts, PF_GPU_MMIO_BASE +
+                               QVIRTIO_MMIO_DEVICE_ID), ==, VIRTIO_ID_GPU);
+    qvirtio_mmio_init_device(&f->mmio, qts, PF_GPU_MMIO_BASE, 4096);
+    qvirtio_start_device(&f->mmio.vdev);
+    features = qvirtio_get_features(&f->mmio.vdev);
+    features &= ~(QVIRTIO_F_BAD_FEATURE |
+                  BIT_ULL(VIRTIO_RING_F_INDIRECT_DESC) |
+                  BIT_ULL(VIRTIO_RING_F_EVENT_IDX) |
+                  BIT_ULL(VIRTIO_F_RING_PACKED));
+    qvirtio_set_features(&f->mmio.vdev, features);
+    alloc_init(&f->alloc, ALLOC_NO_FLAGS, PF_RAM_BASE, PF_RAM_END, 4096);
+    f->vq = setup_modern_queue(f, 0);
+    qvirtio_set_driver_ok(&f->mmio.vdev);
+}
+
+static void gpu_command(GpuFixture *f, const void *command, size_t size)
+{
+    struct virtio_gpu_ctrl_hdr response = { 0 };
+    uint64_t command_addr = guest_alloc(&f->alloc, size);
+    uint64_t response_addr = guest_alloc(&f->alloc, sizeof(response));
+    uint32_t head;
+
+    qtest_memwrite(f->qts, command_addr, command, size);
+    qtest_memwrite(f->qts, response_addr, &response, sizeof(response));
+    head = qvirtqueue_add(f->qts, f->vq, command_addr, size, false, true);
+    qvirtqueue_add(f->qts, f->vq, response_addr, sizeof(response), true,
+                   false);
+    qvirtqueue_kick(f->qts, &f->mmio.vdev, f->vq, head);
+    qvirtio_wait_used_elem(f->qts, &f->mmio.vdev, f->vq, head, NULL,
+                           10 * 1000 * 1000);
+    qtest_memread(f->qts, response_addr, &response, sizeof(response));
+    g_assert_cmphex(le32_to_cpu(response.type), ==,
+                    VIRTIO_GPU_RESP_OK_NODATA);
+}
+
+static void gpu_draw_asymmetric_pattern(GpuFixture *f)
+{
+    const uint32_t resource_id = 1;
+    const size_t framebuffer_size = PF_WIDTH * PF_HEIGHT * 4;
+    g_autofree uint8_t *pixels = g_malloc0(framebuffer_size);
+    struct virtio_gpu_resource_create_2d create = {
+        .hdr.type = cpu_to_le32(VIRTIO_GPU_CMD_RESOURCE_CREATE_2D),
+        .resource_id = cpu_to_le32(resource_id),
+        .format = cpu_to_le32(VIRTIO_GPU_FORMAT_B8G8R8X8_UNORM),
+        .width = cpu_to_le32(PF_WIDTH),
+        .height = cpu_to_le32(PF_HEIGHT),
+    };
+    struct {
+        struct virtio_gpu_resource_attach_backing command;
+        struct virtio_gpu_mem_entry entry;
+    } attach = {
+        .command = {
+            .hdr.type = cpu_to_le32(VIRTIO_GPU_CMD_RESOURCE_ATTACH_BACKING),
+            .resource_id = cpu_to_le32(resource_id),
+            .nr_entries = cpu_to_le32(1),
+        },
+        .entry = {
+            .addr = cpu_to_le64(f->framebuffer_addr),
+            .length = cpu_to_le32(framebuffer_size),
+        },
+    };
+    struct virtio_gpu_transfer_to_host_2d transfer = {
+        .hdr.type = cpu_to_le32(VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D),
+        .r = {
+            .width = cpu_to_le32(PF_WIDTH),
+            .height = cpu_to_le32(PF_HEIGHT),
+        },
+        .resource_id = cpu_to_le32(resource_id),
+    };
+    struct virtio_gpu_set_scanout scanout = {
+        .hdr.type = cpu_to_le32(VIRTIO_GPU_CMD_SET_SCANOUT),
+        .r = {
+            .width = cpu_to_le32(PF_WIDTH),
+            .height = cpu_to_le32(PF_HEIGHT),
+        },
+        .resource_id = cpu_to_le32(resource_id),
+    };
+    struct virtio_gpu_resource_flush flush = {
+        .hdr.type = cpu_to_le32(VIRTIO_GPU_CMD_RESOURCE_FLUSH),
+        .r = {
+            .width = cpu_to_le32(PF_WIDTH),
+            .height = cpu_to_le32(PF_HEIGHT),
+        },
+        .resource_id = cpu_to_le32(resource_id),
+    };
+
+    /* Magenta at native top-left; native bottom-right remains black. */
+    pixels[0] = 0xff;
+    pixels[1] = 0x00;
+    pixels[2] = 0xff;
+    f->framebuffer_addr = guest_alloc(&f->alloc, framebuffer_size);
+    attach.entry.addr = cpu_to_le64(f->framebuffer_addr);
+    qtest_memwrite(f->qts, f->framebuffer_addr, pixels, framebuffer_size);
+    gpu_command(f, &create, sizeof(create));
+    gpu_command(f, &attach, sizeof(attach));
+    gpu_command(f, &transfer, sizeof(transfer));
+    gpu_command(f, &scanout, sizeof(scanout));
+    gpu_command(f, &flush, sizeof(flush));
+}
+
+static void gpu_draw_damage(GpuFixture *f, uint32_t x, uint32_t y)
+{
+    const uint64_t offset = ((uint64_t)y * PF_WIDTH + x) * 4;
+    const uint8_t cyan[4] = { 0xff, 0xff, 0x00, 0x00 };
+    struct virtio_gpu_transfer_to_host_2d transfer = {
+        .hdr.type = cpu_to_le32(VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D),
+        .r = {
+            .x = cpu_to_le32(x),
+            .y = cpu_to_le32(y),
+            .width = cpu_to_le32(1),
+            .height = cpu_to_le32(1),
+        },
+        .offset = cpu_to_le64(offset),
+        .resource_id = cpu_to_le32(1),
+    };
+    struct virtio_gpu_resource_flush flush = {
+        .hdr.type = cpu_to_le32(VIRTIO_GPU_CMD_RESOURCE_FLUSH),
+        .r = {
+            .x = cpu_to_le32(x),
+            .y = cpu_to_le32(y),
+            .width = cpu_to_le32(1),
+            .height = cpu_to_le32(1),
+        },
+        .resource_id = cpu_to_le32(1),
+    };
+
+    qtest_memwrite(f->qts, f->framebuffer_addr + offset, cyan, sizeof(cyan));
+    gpu_command(f, &transfer, sizeof(transfer));
+    gpu_command(f, &flush, sizeof(flush));
+}
+
+static GDBusConnection *p2p_from_fd(int fd)
+{
+    g_autoptr(GError) err = NULL;
+    g_autoptr(GSocket) socket = g_socket_new_from_fd(fd, &err);
+    g_autoptr(GSocketConnection) socketc = NULL;
+    GDBusConnection *conn;
+
+    g_assert_no_error(err);
+    socketc = g_socket_connection_factory_create_connection(socket);
+    conn = g_dbus_connection_new_sync(
+        G_IO_STREAM(socketc), NULL,
+        G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+        G_DBUS_CONNECTION_FLAGS_DELAY_MESSAGE_PROCESSING,
+        NULL, NULL, &err);
+    g_assert_no_error(err);
+    return conn;
+}
+
+static gboolean handle_scanout(QemuDBusDisplay1Listener *object,
+                               GDBusMethodInvocation *invocation,
+                               guint width, guint height, guint stride,
+                               guint pixman_format, GVariant *data,
+                               DisplayTest *test)
+{
+    const uint8_t *pixels;
+
+    pixels = g_variant_get_fixed_array(data, &test->bytes, 1);
+    test->width = width;
+    test->height = height;
+    test->stride = stride;
+    test->format = pixman_format;
+    g_assert_cmpuint(test->bytes, ==, (gsize)stride * height);
+    memcpy(test->first, pixels, sizeof(test->first));
+    memcpy(test->last, pixels + test->bytes - sizeof(test->last),
+           sizeof(test->last));
+    g_main_loop_quit(test->loop);
+    return DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+static gboolean handle_update(QemuDBusDisplay1Listener *object,
+                              GDBusMethodInvocation *invocation,
+                              gint x, gint y, gint width, gint height,
+                              guint stride, guint pixman_format, GVariant *data,
+                              DisplayTest *test)
+{
+    const uint8_t *pixels;
+
+    pixels = g_variant_get_fixed_array(data, &test->update_bytes, 1);
+    test->got_update = true;
+    test->update_x = x;
+    test->update_y = y;
+    test->update_width = width;
+    test->update_height = height;
+    test->update_stride = stride;
+    test->update_format = pixman_format;
+    g_assert_cmpuint(test->update_bytes, ==, (gsize)stride * height);
+    memcpy(test->update_pixel, pixels, sizeof(test->update_pixel));
+    g_main_loop_quit(test->loop);
+    return DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+static void setup_listener(DisplayTest *test)
+{
+    g_autoptr(GDBusObjectSkeleton) listener = NULL;
+    g_autoptr(QemuDBusDisplay1ListenerSkeleton) iface = NULL;
+
+    test->server = g_dbus_object_manager_server_new(DBUS_DISPLAY1_ROOT);
+    listener = g_dbus_object_skeleton_new(DBUS_DISPLAY1_ROOT "/Listener");
+    iface = QEMU_DBUS_DISPLAY1_LISTENER_SKELETON(
+        qemu_dbus_display1_listener_skeleton_new());
+    g_object_connect(iface, "signal::handle-scanout", handle_scanout, test,
+                     "signal::handle-update", handle_update, test,
+                     NULL);
+    g_dbus_object_skeleton_add_interface(listener,
+                                         G_DBUS_INTERFACE_SKELETON(iface));
+    g_dbus_object_manager_server_export(test->server, listener);
+    g_dbus_object_manager_server_set_connection(test->server,
+                                                test->listener_conn);
+    g_dbus_connection_start_message_processing(test->listener_conn);
+}
+
+static void registered(GObject *source, GAsyncResult *res, gpointer opaque)
+{
+    DisplayTest *test = opaque;
+    g_autoptr(GError) err = NULL;
+
+    qemu_dbus_display1_console_call_register_listener_finish(
+        QEMU_DBUS_DISPLAY1_CONSOLE(source), NULL, res, &err);
+    g_assert_no_error(err);
+    test->listener_conn = g_thread_join(test->thread);
+    setup_listener(test);
+}
+
+static gpointer server_thread(gpointer data)
+{
+    return p2p_from_fd(GPOINTER_TO_INT(data));
+}
+
+static void test_native_scanout(void)
+{
+    g_autoptr(GError) err = NULL;
+    g_autoptr(GDBusConnection) conn = NULL;
+    g_autoptr(QemuDBusDisplay1ConsoleProxy) console = NULL;
+    g_autoptr(GUnixFDList) fd_list = NULL;
+    g_autoptr(GMainLoop) loop = NULL;
+    QTestState *qts;
+    QDict *response;
+    QDict *info;
+    QDict *scanout;
+    DisplayTest test = { 0 };
+    GpuFixture gpu;
+    int dbus_pair[2];
+    int listener_pair[2];
+    int presentation_rotation;
+    int presented_x;
+    int presented_y;
+    int idx;
+
+    qts = qtest_init("-machine pocketforge-a133 -nodefaults "
+                     "-display dbus,p2p=yes");
+    gpu_fixture_init(&gpu, qts);
+    gpu_draw_asymmetric_pattern(&gpu);
+    g_assert_cmpint(qemu_socketpair(AF_UNIX, SOCK_STREAM, 0, dbus_pair), ==, 0);
+    qtest_qmp_add_client(qts, "@dbus-display", dbus_pair[1]);
+    conn = p2p_from_fd(dbus_pair[0]);
+    g_dbus_connection_start_message_processing(conn);
+
+    response = qtest_qmp(qts,
+                         "{ 'execute': 'query-pocketforge-display' }");
+    info = qdict_get_qdict(response, "return");
+    g_assert_cmpint(qdict_get_int(info, "native_width"), ==, PF_WIDTH);
+    g_assert_cmpint(qdict_get_int(info, "native_height"), ==, PF_HEIGHT);
+    g_assert_cmpint(qdict_get_int(info, "plane_rotation"), ==, 0);
+    presentation_rotation = qdict_get_int(info, "presentation_rotation");
+    g_assert_cmpint(presentation_rotation, ==, 90);
+    scanout = qdict_get_qdict(info, "active_scanout");
+    g_assert_nonnull(scanout);
+
+    g_assert_cmpint(qemu_socketpair(AF_UNIX, SOCK_STREAM, 0, listener_pair),
+                    ==, 0);
+    fd_list = g_unix_fd_list_new();
+    idx = g_unix_fd_list_append(fd_list, listener_pair[1], &err);
+    g_assert_no_error(err);
+    console = QEMU_DBUS_DISPLAY1_CONSOLE_PROXY(
+        qemu_dbus_display1_console_proxy_new_sync(
+            conn, G_DBUS_PROXY_FLAGS_NONE, NULL,
+            DBUS_DISPLAY1_ROOT "/Console_0", NULL, &err));
+    g_assert_no_error(err);
+    test.loop = loop = g_main_loop_new(NULL, FALSE);
+    test.thread = g_thread_new(NULL, server_thread,
+                               GINT_TO_POINTER(listener_pair[0]));
+    qemu_dbus_display1_console_call_register_listener(
+        QEMU_DBUS_DISPLAY1_CONSOLE(console), g_variant_new_handle(idx),
+        G_DBUS_CALL_FLAGS_NONE, -1, fd_list, NULL, registered, &test);
+    g_main_loop_run(loop);
+
+    g_assert_cmpuint(test.width, ==, PF_WIDTH);
+    g_assert_cmpuint(test.height, ==, PF_HEIGHT);
+    g_assert_cmpuint(test.stride, ==, PF_WIDTH * 4);
+    g_assert_cmpint(qdict_get_int(scanout, "width"), ==, test.width);
+    g_assert_cmpint(qdict_get_int(scanout, "height"), ==, test.height);
+    g_assert_cmpint(qdict_get_int(scanout, "stride"), ==, test.stride);
+    g_assert_cmpstr(qdict_get_str(scanout, "fourcc"), ==, "XR24");
+    g_assert_cmpuint(test.first[0], ==, 0xff);
+    g_assert_cmpuint(test.first[1], ==, 0x00);
+    g_assert_cmpuint(test.first[2], ==, 0xff);
+    g_assert_cmpuint(test.first[3], ==, 0x00);
+    g_assert_cmpint(memcmp(test.first, test.last, sizeof(test.first)), !=, 0);
+
+    gpu_draw_damage(&gpu, 3, 5);
+    g_main_loop_run(loop);
+    g_assert_true(test.got_update);
+    g_assert_cmpint(test.update_x, ==, 3);
+    g_assert_cmpint(test.update_y, ==, 5);
+    g_assert_cmpint(test.update_width, ==, 1);
+    g_assert_cmpint(test.update_height, ==, 1);
+    g_assert_cmpuint(test.update_stride, ==, 4);
+    g_assert_cmpuint(test.update_format, ==, test.format);
+    g_assert_cmpuint(test.update_bytes, ==, 4);
+    g_assert_cmpuint(test.update_pixel[0], ==, 0xff);
+    g_assert_cmpuint(test.update_pixel[1], ==, 0xff);
+    g_assert_cmpuint(test.update_pixel[2], ==, 0x00);
+    g_assert_cmpuint(test.update_pixel[3], ==, 0x00);
+
+    /* Map the observed native marker using the queried clockwise direction. */
+    if (presentation_rotation == 90) {
+        presented_x = PF_HEIGHT - 1;
+        presented_y = 0;
+    } else if (presentation_rotation == 270) {
+        presented_x = 0;
+        presented_y = PF_WIDTH - 1;
+    } else {
+        g_assert_not_reached();
+    }
+    g_assert_cmpint(presented_x, ==, 1279);
+    g_assert_cmpint(presented_y, ==, 0);
+    g_assert_false(presented_x == 0 && presented_y == 719);
+
+    qobject_unref(response);
+    g_clear_object(&test.server);
+    g_clear_object(&test.listener_conn);
+    qvirtio_reset(&gpu.mmio.vdev);
+    qvirtqueue_cleanup(gpu.mmio.vdev.bus, gpu.vq, &gpu.alloc);
+    alloc_destroy(&gpu.alloc);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/aarch64/pocketforge-a133-display/native-scanout",
+                   test_native_scanout);
+    return g_test_run();
+}
