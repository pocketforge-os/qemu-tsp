+static const PocketForgeA133InputAbsCap *pocketforge_abs_cap(uint16_t code)
+{
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(pocketforge_a133_input_axes); i++) {
+        if (pocketforge_a133_input_axes[i].code == code) {
+            return &pocketforge_a133_input_axes[i];
+        }
+    }
+    return NULL;
+}
