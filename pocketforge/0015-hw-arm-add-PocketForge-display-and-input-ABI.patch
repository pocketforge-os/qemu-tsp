 #define TYPE_POCKETFORGE_A133_MACHINE MACHINE_TYPE_NAME("pocketforge-a133")
 OBJECT_DECLARE_SIMPLE_TYPE(PocketForgeA133MachineState,
@@ -122,8 +131,29 @@ struct PocketForgeA133MachineState {
     MachineState parent_obj;
     I2CBus *r_i2c0_bus;
     bool input;
+    bool initialized;
+    char *display;
+    VirtIOGPUBase *gpu;
+    PocketForgeA133Input *input_device;
 };
 
+#define PF_A133_NATIVE_WIDTH 720
+#define PF_A133_NATIVE_HEIGHT 1280
+#define PF_A133_PRESENTATION_ROTATION 90
+
+static int pocketforge_a133_reject_extra_gpu(void *opaque, QemuOpts *opts,
+                                             Error **errp)
+{
+    const char *driver = qemu_opt_get(opts, "driver");
+
+    if (driver && g_str_has_prefix(driver, "virtio-gpu")) {
+        error_setg(errp, "pocketforge-display: reason=duplicate-gpu: "
+                   "the hardware profile already owns its virtio GPU");
+        return -1;
+    }
+    return 0;
+}
+
 /*
  * Addresses/IRQ taken verbatim from the real device tree
  * (arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi, kernel-sunxi-6.x
@@ -635,12 +665,32 @@ static void pocketforge_a133_create_virtio_mmio(MachineState *machine,
         sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
         sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, pic[irq]);
 
+        if (i == 0 && !strcmp(s->display, "hardware")) {
+            DeviceState *gpu = qdev_new(TYPE_VIRTIO_GPU);
+
+            object_property_set_uint(OBJECT(gpu), "xres",
+                                     PF_A133_NATIVE_WIDTH, &error_fatal);
+            object_property_set_uint(OBJECT(gpu), "yres",
+                                     PF_A133_NATIVE_HEIGHT, &error_fatal);
+            object_property_set_bool(OBJECT(gpu), "edid", true,
+                                     &error_fatal);
+            object_property_add_child(OBJECT(machine), "pocketforge-gpu",
+                                      OBJECT(gpu));
+            qdev_realize(gpu, BUS(&VIRTIO_MMIO(dev)->bus), &error_fatal);
+            s->gpu = VIRTIO_GPU_BASE(gpu);
+            qemu_console_resize(s->gpu->scanout[0].con,
+                                PF_A133_NATIVE_WIDTH,
+                                PF_A133_NATIVE_HEIGHT);
+            object_unref(OBJECT(gpu));
+        }
+
         if (i == 1 && s->input) {
             DeviceState *input = qdev_new(TYPE_POCKETFORGE_A133_INPUT);
 
             object_property_add_child(OBJECT(machine), "pocketforge-input",
                                       OBJECT(input));
             qdev_realize(input, BUS(&VIRTIO_MMIO(dev)->bus), &error_fatal);
+            s->input_device = POCKETFORGE_A133_INPUT(input);
             object_unref(OBJECT(input));
         }
     }
@@ -687,6 +737,14 @@ static void pocketforge_a133_init(MachineState *machine)
     int n;
     unsigned int i;
 
+    s->initialized = true;
+
+    if (!strcmp(s->display, "hardware")) {
+        qemu_opts_foreach(qemu_find_opts("device"),
+                          pocketforge_a133_reject_extra_gpu,
+                          NULL, &error_fatal);
+    }
+
     for (n = 0; n < PF_A133_NUM_CPUS; n++) {
         Object *cpuobj = object_new(machine->cpu_type);
 
@@ -774,16 +832,234 @@ static void pocketforge_a133_set_input(Object *obj, bool value, Error **errp)
     POCKETFORGE_A133_MACHINE(obj)->input = value;
 }
 
+static char *pocketforge_a133_get_display(Object *obj, Error **errp)
+{
+    return g_strdup(POCKETFORGE_A133_MACHINE(obj)->display);
+}
+
+static void pocketforge_a133_set_display(Object *obj, const char *value,
+                                         Error **errp)
+{
+    PocketForgeA133MachineState *s = POCKETFORGE_A133_MACHINE(obj);
+
+    if (strcmp(value, "hardware") && strcmp(value, "off")) {
+        error_setg(errp, "pocketforge-display: reason=invalid-parameter: "
+                   "expected hardware or off, got '%s'", value);
+        return;
+    }
+    if (s->initialized) {
+        error_setg(errp, "pocketforge-display: reason=resource-busy: "
+                   "profile is immutable after machine realization");
+        return;
+    }
+    g_free(s->display);
+    s->display = g_strdup(value);
+}
+
+static const char *pocketforge_surface_fourcc(DisplaySurface *surface)
+{
+    switch (surface_format(surface)) {
+    case PIXMAN_x8r8g8b8:
+        return "XR24";
+    case PIXMAN_x8b8g8r8:
+        return "XB24";
+    case PIXMAN_a8r8g8b8:
+        return "AR24";
+    default:
+        return NULL;
+    }
+}
+
+PocketForgeInputInfo *pocketforge_a133_query_input(Error **errp)
+{
+    PocketForgeInputInfo *info;
+    PocketForgeA133MachineState *s;
+    PocketForgeInputDeviceInfo *device;
+    PocketForgeInputCaps *cap;
+    PocketForgeInputCapsList **caps_tail;
+    PocketForgeInputCodeList **code_tail;
+    PocketForgeInputAbsInfoList **abs_tail;
+    PocketForgeInputDeviceInfoList **device_tail;
+    size_t i;
+
+    if (!object_dynamic_cast(OBJECT(current_machine),
+                             TYPE_POCKETFORGE_A133_MACHINE)) {
+        error_set(errp, ERROR_CLASS_DEVICE_NOT_FOUND,
+                  "PocketForge A133 input is not present");
+        return NULL;
+    }
+    info = g_new0(PocketForgeInputInfo, 1);
+    device_tail = &info->devices;
+    info->abi_version = g_new0(PocketForgeAbiVersion, 1);
+    info->abi_version->major = 1;
+    info->abi_version->minor = 0;
+    info->max_batch_events = PF_A133_INPUT_BATCH_MAX;
+    s = POCKETFORGE_A133_MACHINE(current_machine);
+    if (!s->input_device) {
+        return info;
+    }
+
+    device = g_new0(PocketForgeInputDeviceInfo, 1);
+    device->id = g_strdup("gamepad");
+    device->name = g_strdup(PF_A133_INPUT_NAME);
+    device->bustype = BUS_USB;
+    device->vendor = 0x045e;
+    device->product = 0x028e;
+    device->version = 0x0110;
+    device->ready = VIRTIO_INPUT(s->input_device)->active;
+    caps_tail = &device->caps;
+
+    cap = g_new0(PocketForgeInputCaps, 1);
+    cap->type = EV_SYN;
+    cap->has_codes = true;
+    code_tail = &cap->codes;
+    {
+        PocketForgeInputCode *code = g_new0(PocketForgeInputCode, 1);
+        code->code = SYN_REPORT;
+        code->name = g_strdup("SYN_REPORT");
+        QAPI_LIST_APPEND(code_tail, code);
+    }
+    QAPI_LIST_APPEND(caps_tail, cap);
+
+    cap = g_new0(PocketForgeInputCaps, 1);
+    cap->type = EV_KEY;
+    cap->has_codes = true;
+    code_tail = &cap->codes;
+    for (i = 0; i < pocketforge_a133_input_key_count; i++) {
+        PocketForgeInputCode *code = g_new0(PocketForgeInputCode, 1);
+        code->code = pocketforge_a133_input_keys[i].code;
+        code->name = g_strdup(pocketforge_a133_input_keys[i].name);
+        QAPI_LIST_APPEND(code_tail, code);
+    }
+    QAPI_LIST_APPEND(caps_tail, cap);
+
+    cap = g_new0(PocketForgeInputCaps, 1);
+    cap->type = EV_ABS;
+    cap->has_abs = true;
+    abs_tail = &cap->abs;
+    for (i = 0; i < pocketforge_a133_input_axis_count; i++) {
+        PocketForgeInputAbsInfo *axis =
+            g_new0(PocketForgeInputAbsInfo, 1);
+        axis->code = pocketforge_a133_input_axes[i].code;
+        axis->name = g_strdup(pocketforge_a133_input_axes[i].name);
+        axis->min = pocketforge_a133_input_axes[i].minimum;
+        axis->max = pocketforge_a133_input_axes[i].maximum;
+        QAPI_LIST_APPEND(abs_tail, axis);
+    }
+    QAPI_LIST_APPEND(caps_tail, cap);
+    QAPI_LIST_APPEND(device_tail, device);
+    return info;
+}
+
+void pocketforge_a133_input_send_qmp(const char *device,
+                                     PocketForgeInputEventList *events,
+                                     Error **errp)
+{
+    PocketForgeA133MachineState *s;
+    PocketForgeInputEventList *item;
+    PocketForgeA133InputEvent *raw;
+    size_t count = 0;
+    size_t i = 0;
+
+    if (strcmp(device, "gamepad")) {
+        error_set(errp, ERROR_CLASS_DEVICE_NOT_FOUND,
+                         "PocketForge input device '%s' was not found", device);
+        return;
+    }
+    if (!object_dynamic_cast(OBJECT(current_machine),
+                             TYPE_POCKETFORGE_A133_MACHINE) ||
+        !(s = POCKETFORGE_A133_MACHINE(current_machine))->input_device) {
+        error_set(errp, ERROR_CLASS_DEVICE_NOT_FOUND,
+                         "PocketForge input device 'gamepad' is disabled");
+        return;
+    }
+    for (item = events; item; item = item->next) {
+        count++;
+    }
+    raw = g_new(PocketForgeA133InputEvent, count);
+    for (item = events; item; item = item->next) {
+        raw[i].type = item->value->type;
+        raw[i].code = item->value->code;
+        raw[i].value = item->value->value;
+        i++;
+    }
+    pocketforge_a133_input_send(s->input_device, raw, count, errp);
+    g_free(raw);
+}
+
+PocketForgeDisplayInfo *pocketforge_a133_query_display(Error **errp)
+{
+    PocketForgeA133MachineState *s;
+    PocketForgeDisplayInfo *info;
+    strList **format_tail;
+    DisplaySurface *surface;
+    const char *fourcc;
+
+    if (!object_dynamic_cast(OBJECT(current_machine),
+                             TYPE_POCKETFORGE_A133_MACHINE)) {
+        error_set(errp, ERROR_CLASS_DEVICE_NOT_FOUND,
+                         "PocketForge A133 display is not present");
+        return NULL;
+    }
+    s = POCKETFORGE_A133_MACHINE(current_machine);
+    info = g_new0(PocketForgeDisplayInfo, 1);
+    info->abi_version = g_new0(PocketForgeAbiVersion, 1);
+    info->abi_version->major = 1;
+    info->abi_version->minor = 0;
+    info->profile = g_strdup(s->display);
+    info->native_width = PF_A133_NATIVE_WIDTH;
+    info->native_height = PF_A133_NATIVE_HEIGHT;
+    info->plane_rotation = 0;
+    info->presentation_rotation = PF_A133_PRESENTATION_ROTATION;
+    info->preferred_fourcc = g_strdup("XR24");
+    format_tail = &info->supported_fourcc;
+    QAPI_LIST_APPEND(format_tail, g_strdup("XR24"));
+    QAPI_LIST_APPEND(format_tail, g_strdup("XB24"));
+    QAPI_LIST_APPEND(format_tail, g_strdup("AR24"));
+
+    if (!s->gpu || !s->gpu->scanout[0].con) {
+        return info;
+    }
+    surface = qemu_console_surface(s->gpu->scanout[0].con);
+    if (!surface) {
+        return info;
+    }
+    fourcc = pocketforge_surface_fourcc(surface);
+    if (!fourcc) {
+        error_setg(errp, "pocketforge-display: reason=unsupported-format: "
+                   "active scanout pixman format is not in the ABI");
+        qapi_free_PocketForgeDisplayInfo(info);
+        return NULL;
+    }
+    info->active_scanout = g_new0(PocketForgeDisplayScanout, 1);
+    info->active_scanout->width = surface_width(surface);
+    info->active_scanout->height = surface_height(surface);
+    info->active_scanout->stride = surface_stride(surface);
+    info->active_scanout->fourcc = g_strdup(fourcc);
+    return info;
+}
+
 static void pocketforge_a133_instance_init(Object *obj)
 {
     PocketForgeA133MachineState *s = POCKETFORGE_A133_MACHINE(obj);
 
     s->input = true;
+    s->display = g_strdup("hardware");
     object_property_add_bool(obj, "pocketforge-input-device",
                              pocketforge_a133_get_input,
                              pocketforge_a133_set_input);
     object_property_set_description(obj, "pocketforge-input-device",
                                     "Enable deterministic PocketForge controls");
+    object_property_add_str(obj, "pocketforge-display",
+                            pocketforge_a133_get_display,
+                            pocketforge_a133_set_display);
+    object_property_set_description(obj, "pocketforge-display",
+                                    "Display profile: hardware or off");
+}
+
+static void pocketforge_a133_instance_finalize(Object *obj)
+{
+    g_free(POCKETFORGE_A133_MACHINE(obj)->display);
 }
 
 static const TypeInfo pocketforge_a133_machine_info = {
@@ -791,6 +1067,7 @@ static const TypeInfo pocketforge_a133_machine_info = {
     .parent = TYPE_MACHINE,
     .instance_size = sizeof(PocketForgeA133MachineState),
     .instance_init = pocketforge_a133_instance_init,
+    .instance_finalize = pocketforge_a133_instance_finalize,
     .class_init = pocketforge_a133_machine_class_init,
 };
 
