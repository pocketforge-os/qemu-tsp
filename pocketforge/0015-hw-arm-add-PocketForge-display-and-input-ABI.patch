+static bool pocketforge_validate_event(PocketForgeA133Input *state,
+                                       const PocketForgeA133InputEvent *event,
+                                       size_t index, Error **errp)
+{
+    bool *key;
+    const PocketForgeA133InputAbsCap *axis;
+    int8_t *hat;
+
+    if (event->type < 0 || event->type > UINT16_MAX ||
+        event->code < 0 || event->code > UINT16_MAX ||
+        event->value < INT32_MIN || event->value > INT32_MAX) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                   "index=%zu: evdev field is outside its wire range", index);
+        return false;
+    }
+    if (event->type == EV_SYN) {
+        if (event->code != SYN_REPORT || event->value != 0) {
+            error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                       "index=%zu: only SYN_REPORT value 0 is declared", index);
+            return false;
+        }
+        return true;
+    }
+    if (event->type == EV_KEY) {
+        key = pocketforge_key_state(state, event->code);
+        if (!key) {
+            error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                       "index=%zu: undeclared EV_KEY code", index);
+            return false;
+        }
+        if ((event->value != 0 && event->value != 1) ||
+            *key == (bool)event->value) {
+            error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                       "index=%zu: key transition is out of order", index);
+            return false;
+        }
+        *key = event->value;
+        return true;
+    }
+    if (event->type == EV_ABS) {
+        axis = pocketforge_abs_cap(event->code);
+        if (!axis) {
+            error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                       "index=%zu: undeclared EV_ABS code", index);
+            return false;
+        }
+        if (event->value < axis->minimum || event->value > axis->maximum) {
+            error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                       "index=%zu: ABS value outside advertised range", index);
+            return false;
+        }
+        if (event->code == ABS_HAT0X || event->code == ABS_HAT0Y) {
+            hat = event->code == ABS_HAT0X ? &state->hat_x : &state->hat_y;
+            if ((event->value == 0 && *hat == 0) ||
+                (event->value != 0 && *hat != 0)) {
+                error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                           "index=%zu: hat transition is out of order", index);
+                return false;
+            }
+            *hat = event->value;
+        }
+        return true;
+    }
+
+    error_setg(errp, "pocketforge-input: reason=invalid-parameter index=%zu: "
+               "undeclared evdev type", index);
+    return false;
+}
+
+bool pocketforge_a133_input_send(PocketForgeA133Input *s,
+                                 const PocketForgeA133InputEvent *raw,
+                                 size_t count, Error **errp)
+{
+    PocketForgeA133Input next = *s;
+    virtio_input_event *wire;
+    size_t i;
+    size_t report_events = 0;
+
+    if (!count || count > PF_A133_INPUT_BATCH_MAX) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter index=0: "
+                   "batch must contain 1..%u events", PF_A133_INPUT_BATCH_MAX);
+        return false;
+    }
+    for (i = 0; i < count; i++) {
+        if (!pocketforge_validate_event(&next, &raw[i], i, errp)) {
+            return false;
+        }
+        if (raw[i].type == EV_SYN) {
+            if (!report_events) {
+                error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                           "index=%zu: empty report", i);
+                return false;
+            }
+            report_events = 0;
+        } else {
+            report_events++;
+        }
+    }
+    if (raw[count - 1].type != EV_SYN || report_events) {
+        error_setg(errp, "pocketforge-input: reason=invalid-parameter "
+                   "index=%zu: batch must end with SYN_REPORT", count - 1);
+        return false;
+    }
     if (!pocketforge_a133_input_ready(OBJECT(s), NULL)) {
-        error_setg(errp, "PocketForge input driver is not ready");
+        error_set(errp, ERROR_CLASS_DEVICE_NOT_ACTIVE,
+                         "PocketForge input guest driver is not ready");
         return false;
     }
-    if (!virtio_input_send(vinput, &event) ||
-        !virtio_input_send(vinput, &sync)) {
-        error_setg(errp, "PocketForge input event queue is unavailable");
+
+    wire = g_new(virtio_input_event, count);
+    for (i = 0; i < count; i++) {
+        wire[i].type = cpu_to_le16(raw[i].type);
+        wire[i].code = cpu_to_le16(raw[i].code);
+        wire[i].value = cpu_to_le32(raw[i].value);
+    }
+    if (!virtio_input_send_batch(VIRTIO_INPUT(s), wire, count)) {
+        error_setg(errp, "pocketforge-input: reason=resource-busy: guest "
+                   "event queue has insufficient capacity");
+        g_free(wire);
         return false;
     }
+    g_free(wire);
+
+    s->l1 = next.l1;
+    s->r1 = next.r1;
+    s->menu = next.menu;
+    s->south = next.south;
+    s->east = next.east;
+    s->north = next.north;
+    s->west = next.west;
+    s->select = next.select;
+    s->start = next.start;
+    s->hat_x = next.hat_x;
+    s->hat_y = next.hat_y;
     return true;
 }
 
+static bool pocketforge_a133_input_emit(PocketForgeA133Input *s,
+                                        uint16_t type, uint16_t code,
+                                        int32_t value, Error **errp)
+{
+    PocketForgeA133InputEvent events[] = {
+        { type, code, value }, { EV_SYN, SYN_REPORT, 0 },
+    };
+
+    return pocketforge_a133_input_send(s, events, ARRAY_SIZE(events), errp);
+}
