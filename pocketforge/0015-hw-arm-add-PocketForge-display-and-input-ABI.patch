+
+const PocketForgeA133InputAbsCap pocketforge_a133_input_axes[] = {
+    { ABS_X, "ABS_X", 0, 4095 }, { ABS_Y, "ABS_Y", 0, 4095 },
+    { ABS_RX, "ABS_RX", 0, 4095 }, { ABS_RY, "ABS_RY", 0, 4095 },
+    { ABS_Z, "ABS_Z", 0, 255 }, { ABS_RZ, "ABS_RZ", 0, 255 },
