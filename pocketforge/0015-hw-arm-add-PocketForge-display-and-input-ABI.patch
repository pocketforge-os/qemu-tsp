+/*
+ * PocketForge A133 QMP command dispatch
+ *
+ * This code is licensed under the GPL.
+ */
+
+#include "qemu/osdep.h"
+#include CONFIG_DEVICES
+
+#if defined(TARGET_AARCH64) && defined(CONFIG_TCG)
+
+#include "qapi/error.h"
+#include "qapi/qapi-commands-misc-target.h"
+#include "qapi/qapi-types-misc-target.h"
+
+#ifdef CONFIG_POCKETFORGE_A133
+#include "hw/arm/pocketforge_a133.h"
+#endif
+
+PocketForgeInputInfo *qmp_query_pocketforge_input(Error **errp)
+{
+#ifdef CONFIG_POCKETFORGE_A133
+    return pocketforge_a133_query_input(errp);
+#else
+    error_set(errp, ERROR_CLASS_DEVICE_NOT_FOUND,
+              "PocketForge A133 input is not present");
+    return NULL;
+#endif
+}
+
+void qmp_pocketforge_input_send(const char *device,
+                                PocketForgeInputEventList *events,
+                                Error **errp)
+{
+#ifdef CONFIG_POCKETFORGE_A133
+    pocketforge_a133_input_send_qmp(device, events, errp);
+#else
+    error_set(errp, ERROR_CLASS_DEVICE_NOT_FOUND,
+              "PocketForge A133 input is not present");
+#endif
+}
+
+PocketForgeDisplayInfo *qmp_query_pocketforge_display(Error **errp)
+{
+#ifdef CONFIG_POCKETFORGE_A133
+    return pocketforge_a133_query_display(errp);
+#else
+    error_set(errp, ERROR_CLASS_DEVICE_NOT_FOUND,
+              "PocketForge A133 display is not present");
+    return NULL;
+#endif
+}
+
+#endif
