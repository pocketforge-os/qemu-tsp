@@ -126,20 +126,28 @@ static uint8_t *build_egon(const char *magic, uint32_t length, bool corrupt_body
     return img;
 }
 
+/*
+ * Write an eGON image at img_offset into a file of exactly file_size bytes.
+ * The SD model only accepts power-of-two sizes, so callers size files to a
+ * power of two; an image whose declared length runs past EOF models
+ * truncated media (only the bytes that fit are actually written).
+ */
 static char *create_image_file(uint64_t img_offset, uint64_t file_size,
                                const char *magic, uint32_t length,
                                bool corrupt_body)
 {
     uint8_t *img = build_egon(magic, length, corrupt_body);
+    uint64_t avail = file_size > img_offset ? file_size - img_offset : 0;
+    uint64_t bytes = MIN((uint64_t)length, avail);
     GError *error = NULL;
     char *path = NULL;
     int fd = g_file_open_tmp("pocketforge-a133-bootrom-XXXXXX", &path, &error);
 
     g_assert_no_error(error);
     g_assert_cmpint(fd, >=, 0);
-    g_assert_cmpuint(file_size, >=, img_offset + length);
+    g_assert_cmpuint(file_size, >=, img_offset);
     g_assert_cmpint(ftruncate(fd, file_size), ==, 0);
-    g_assert_cmpuint(pwrite(fd, img, length, img_offset), ==, length);
+    g_assert_cmpuint(pwrite(fd, img, bytes, img_offset), ==, bytes);
     g_assert_cmpint(close(fd), ==, 0);
     g_free(img);
     return path;
@@ -154,7 +162,9 @@ static void destroy_image_file(char *path)
 static QTestState *boot_with_image(const char *path)
 {
     char *quoted = g_shell_quote(path);
-    QTestState *qts = qtest_initf("-M pocketforge-a133 -m 64M "
+    /* -accel tcg: the SPL payload must really execute on CPU0; libqtest
+     * appends "-accel qtest" as the fallback for register access. */
