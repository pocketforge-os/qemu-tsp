+static void pocketforge_a133_create_sram(PocketForgeA133MachineState *s,
+                                         MemoryRegion *sysmem)
+{
+    /*
+     * SRAM A1/C/A2 are plain RAM (not register stubs): they keep storage
+     * semantics across machine reset and are executable so the BootROM
+     * can hand CPU0 into an SPL loaded at 0x00020000.
+     */
+    memory_region_init_ram(&s->sram_a1, NULL, "pocketforge-a133.sram_a1",
+                           PF_A133_SRAM_A1_SIZE, &error_fatal);
+    memory_region_add_subregion(sysmem, PF_A133_SRAM_A1_BASE, &s->sram_a1);
+    memory_region_init_ram(&s->sram_c, NULL, "pocketforge-a133.sram_c",
+                           PF_A133_SRAM_C_SIZE, &error_fatal);
+    memory_region_add_subregion(sysmem, PF_A133_SRAM_C_BASE, &s->sram_c);
+    memory_region_init_ram(&s->sram_a2, NULL, "pocketforge-a133.sram_a2",
+                           PF_A133_SRAM_A2_SIZE, &error_fatal);
+    memory_region_add_subregion(sysmem, PF_A133_SRAM_A2_BASE, &s->sram_a2);
+}
+
+static bool pocketforge_a133_egon_header_valid(const uint8_t *header,
+                                               uint32_t *length)
+{
+    uint32_t len;
+
+    if (memcmp(header + 4, PF_A133_EGON_MAGIC, 8) != 0) {
+        return false;
+    }
+    len = ldl_le_p(header + PF_A133_EGON_LENGTH_OFF);
+    /*
+     * The loader copies exactly the declared length into the A1+C window:
+     * it must cover the header, be word aligned (mksunxiboot refuses
+     * anything else) and fit the mapped load capacity.
+     */
+    if (len < PF_A133_EGON_HEADER_SIZE ||
+        (len & 3) != 0 ||
+        len > PF_A133_BOOTROM_LOAD_SIZE) {
+        return false;
+    }
+    *length = len;
+    return true;
+}
+
+static bool pocketforge_a133_egon_checksum_ok(const uint8_t *img,
+                                              uint32_t length)
+{
+    uint32_t stored = ldl_le_p(img + PF_A133_EGON_CHECKSUM_OFF);
+    uint32_t sum = 0;
+    uint32_t off;
+
+    for (off = 0; off < length; off += 4) {
+        sum += off == PF_A133_EGON_CHECKSUM_OFF ? PF_A133_EGON_STAMP :
+                                                  ldl_le_p(img + off);
+    }
+    return sum == stored;
+}
+
+/*
+ * Pre-CPU BootROM eGON load, re-run on every machine reset so the load is
+ * deterministic.  Searches MMC0 at the 8 KiB low location and then the
+ * 128 KiB high location, validates the eGON.BT0 header (magic, aligned and
+ * bounded length, additive checksum), copies exactly the declared length to
+ * SRAM 0x00020000, stamps the boot media word the SPL later reads back
+ * (U-Boot arch/arm/mach-sunxi/board.c sunxi_get_boot_source), and hands
+ * CPU0 to 0x00020000 in AArch32.  A read error, truncated media, stale
+ * checksum or bad magic rejects the location; nothing is ever partially
+ * copied or executed.  Secondaries stay held (start-powered-off).
+ */
+static void pocketforge_a133_bootrom_reset(void *opaque)
+{
+    static const struct {
+        uint64_t offset;
+        uint32_t media;
+    } locations[] = {
+        { PF_A133_EGON_OFFSET_LOW,  PF_A133_EGON_MEDIA_MMC0 },
+        { PF_A133_EGON_OFFSET_HIGH, PF_A133_EGON_MEDIA_MMC0_HIGH },
+    };
+    PocketForgeA133MachineState *s = opaque;
+    MachineState *machine = MACHINE(s);
+    uint8_t header[512];
+    g_autofree uint8_t *img = NULL;
+    CPUState *cs;
+    ARMCPU *cpu;
+    CPUARMState *env;
+    unsigned int i;
+
+    if (machine->kernel_filename) {
+        /* Direct kernel boot bypasses the BootROM entirely. */
+        return;
+    }
+    if (!s->bootrom_blk || !blk_is_available(s->bootrom_blk)) {
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(locations); i++) {
+        uint32_t length;
+        int ret;
+
+        ret = blk_pread(s->bootrom_blk, locations[i].offset, sizeof(header),
+                        header, 0);
+        if (ret < 0) {
+            continue;
+        }
+        if (!pocketforge_a133_egon_header_valid(header, &length)) {
+            continue;
+        }
+        img = g_malloc(length);
+        memcpy(img, header, MIN(sizeof(header), length));
+        if (length > sizeof(header)) {
+            ret = blk_pread(s->bootrom_blk,
+                            locations[i].offset + sizeof(header),
+                            length - sizeof(header),
+                            img + sizeof(header), 0);
+            if (ret < 0) {
+                g_clear_pointer(&img, g_free);
+                continue;
+            }
+        }
+        if (!pocketforge_a133_egon_checksum_ok(img, length)) {
+            g_clear_pointer(&img, g_free);
+            continue;
+        }
+
+        stl_le_p(img + PF_A133_EGON_MEDIA_OFF, locations[i].media);
+        address_space_write(&address_space_memory, PF_A133_SRAM_A1_BASE,
+                            MEMTXATTRS_UNSPECIFIED, img, length);
+        g_clear_pointer(&img, g_free);
+
+        cpu = ARM_CPU(first_cpu);
+        cs = CPU(cpu);
+        env = &cpu->env;
+        env->aarch64 = false;
+        cpsr_write(env, ARM_CPU_MODE_SVC | CPSR_A | CPSR_I | CPSR_F,
+                   CPSR_M | CPSR_A | CPSR_I | CPSR_F | CPSR_T, CPSRWriteRaw);
+        cpu_set_pc(cs, PF_A133_SRAM_A1_BASE);
+        if (tcg_enabled()) {
+            arm_rebuild_hflags(env);
+        }
+        return;
+    }
+}
+
 static void pocketforge_a133_r_intc_update(PocketForgeA133MachineState *s)
 {
     qemu_set_irq(s->r_intc_parent_irq,
@@ -677,7 +858,8 @@ static void pocketforge_a133_create_r_i2c0(PocketForgeA133MachineState *s,
         PF_A133_R_I2C0_SIZE - AW_I2C_MEM_SIZE);
