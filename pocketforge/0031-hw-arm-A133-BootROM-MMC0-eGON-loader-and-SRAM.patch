         qdev_realize(DEVICE(cpuobj), NULL, &error_fatal);
         object_unref(cpuobj);
     }
@@ -912,13 +1106,14 @@ static void pocketforge_a133_init(MachineState *machine)
 
     pocketforge_a100_rtc_create(PF_A133_RTC_BASE);
 
+    pocketforge_a133_create_sram(s, sysmem);
     pocketforge_a133_create_mmio_stubs();
     pocketforge_a133_create_r_i2c0(
         s, pic[113], pocketforge_a133_create_r_intc(s, pic[103]));
     qemu_register_reset(pocketforge_a133_power_reset, s);
     vmstate_register(NULL, 0, &vmstate_pocketforge_a133_power, s);
     s->power_state_registered = true;
-    pocketforge_a133_create_mmc0(pic[PF_A133_MMC0_IRQ]);
+    pocketforge_a133_create_mmc0(s, pic[PF_A133_MMC0_IRQ]);
 
     pocketforge_a133_create_virtio_mmio(machine, pic);
 
@@ -929,6 +1124,15 @@ static void pocketforge_a133_init(MachineState *machine)
     binfo->psci_conduit = QEMU_PSCI_CONDUIT_SMC;
     binfo->modify_dtb = pocketforge_a133_modify_dtb;
     arm_load_kernel(ARM_CPU(first_cpu), machine, binfo);
+
+    /*
+     * Register the BootROM reset handler last: arm_load_kernel queues a
+     * do_cpu_reset handler per CPU (hw/arm/boot.c:1219) that re-resets
+     * every CPU on every machine reset, and reset handlers run in
+     * registration order.  The BootROM copy and CPU0 hand-off must
+     * happen after those per-CPU resets to survive.
+     */
+    qemu_register_reset(pocketforge_a133_bootrom_reset, s);
 }
 
 static void pocketforge_a133_machine_init(MachineClass *mc)
