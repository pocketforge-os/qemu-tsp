+/*
+ * SRAM blocks at their pinned sun50i-a100 DTS addresses and sizes
+ * (sun50i-a100.dtsi:116-137).  A1 and C are contiguous and form the
+ * BootROM eGON load window; A1/C/A2 are RAM-backed and executable so
+ * CPU0 can run the loaded SPL in place.
+ */
+#define PF_A133_SRAM_A1_BASE 0x00020000
+#define PF_A133_SRAM_A1_SIZE 0x00004000
+#define PF_A133_SRAM_C_BASE  0x00024000
+#define PF_A133_SRAM_C_SIZE  0x00021000
+#define PF_A133_SRAM_A2_BASE 0x00100000
+#define PF_A133_SRAM_A2_SIZE 0x00014000
+#define PF_A133_BOOTROM_LOAD_SIZE \
+    (PF_A133_SRAM_A1_SIZE + PF_A133_SRAM_C_SIZE)
+
+/*
+ * eGON.BT0 boot header (U-Boot include/sunxi_image.h struct boot_file_head):
+ * branch instruction at 0x00, magic at 0x04, additive checksum at 0x0c,
+ * image length at 0x10, boot media stamp at 0x28 written by the BootROM.
+ * The checksum sums the image as LE32 words with the checksum word itself
+ * replaced by BROM_STAMP_VALUE (U-Boot tools/mksunxiboot.c gen_check_sum).
+ */
+#define PF_A133_EGON_MAGIC         "eGON.BT0"
+#define PF_A133_EGON_CHECKSUM_OFF  0x0c
+#define PF_A133_EGON_LENGTH_OFF    0x10
+#define PF_A133_EGON_MEDIA_OFF     0x28
+#define PF_A133_EGON_HEADER_SIZE   0x60
+#define PF_A133_EGON_STAMP         0x5f0a6c39
+/* U-Boot arch/arm/include/asm/arch-sunxi/spl.h boot media ids. */
+#define PF_A133_EGON_MEDIA_MMC0      0x00
+#define PF_A133_EGON_MEDIA_MMC0_HIGH 0x10
+/* MMC0 raw eGON search locations: 8 KiB low first, then 128 KiB high. */
+#define PF_A133_EGON_OFFSET_LOW    0x00002000
+#define PF_A133_EGON_OFFSET_HIGH   0x00020000
+
