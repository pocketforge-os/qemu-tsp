@@ -181,8 +191,9 @@ static void assert_spl_executed(QTestState *qts)
 {
     g_assert_cmphex(poll_readl(qts, MARKER_ADDR, MARKER_VALUE, 2000),
                     ==, MARKER_VALUE);
-    /* CPU0 is aff0 of the primary cluster: MPIDR low byte 0. */
-    g_assert_cmphex(qtest_readl(qts, MARKER_MPIDR_ADDR), ==, 0);
+    /* CPU0 is aff0 0 of the primary cluster; QEMU also sets the
+     * MP-extensions bit 31 (mpidr_read_val, target/arm/helper.c). */
