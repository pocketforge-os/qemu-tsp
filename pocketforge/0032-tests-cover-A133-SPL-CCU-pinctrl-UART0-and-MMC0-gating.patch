+/*
+ * UART0 and MMC0 sit behind their CCU bus-gating/reset-release words and
+ * the legacy-stride PB/PF pinmux cells the pinned SPL programs: UART0 gate
+ * + reset at CCU +0x90c with PB9/PB10 function 2 at PIO +0x28, MMC0 gate
+ * + reset at CCU +0x84c with PF0..PF5 function 2 at PIO +0xb4.  Open both
+ * the way the SPL does so the flat view shows the live peripherals.
+ */
+static void program_spl_gates(QTestState *qts)
+{
+    qtest_writel(qts, 0x03001000 + 0x90c, 0x1);
+    qtest_writel(qts, 0x03001000 + 0x90c, 0x10001);
+    qtest_writel(qts, 0x03001000 + 0x84c, 0x1);
+    qtest_writel(qts, 0x03001000 + 0x84c, 0x10001);
+    qtest_writel(qts, 0x0300b000 + 0x28, 0x220);
+    qtest_writel(qts, 0x0300b000 + 0xb4, 0x00222222);
+}
