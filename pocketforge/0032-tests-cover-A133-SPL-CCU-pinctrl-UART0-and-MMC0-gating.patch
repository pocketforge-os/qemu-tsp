+static void enable_mmc0(QTestState *qts)
+{
+    qtest_writel(qts, 0x03001000 + 0x830, 0x80000000);
+    qtest_writel(qts, 0x03001000 + 0x84c, 0x1);
+    qtest_writel(qts, 0x03001000 + 0x84c, 0x10001);
+    g_assert_cmphex(qtest_readl(qts, 0x03001000 + 0x84c), ==, 0x10001);
+    qtest_writel(qts, 0x0300b000 + 0x0b4, 0x00222222);
+    qtest_writel(qts, 0x0300b000 + 0x0c8, 0xaaa);
+    qtest_writel(qts, 0x0300b000 + 0x0d0, 0x555);
+}
