diff --git a/tests/qtest/pocketforge-a133-mmio-map-test.c b/tests/qtest/pocketforge-a133-mmio-map-test.c
index ce1d45a4..db24f597 100644
--- a/tests/qtest/pocketforge-a133-mmio-map-test.c
+++ b/tests/qtest/pocketforge-a133-mmio-map-test.c
@@ -10,10 +10,18 @@
 #include "qobject/qlist.h"
 #include "standard-headers/linux/virtio_ids.h"
 #include "standard-headers/linux/virtio_mmio.h"
+#include <libfdt.h>
 
 #define PF_A133_RENDER_MMIO_BASE 0x0a000000
+#define PF_A133_RENDER_MMIO_SIZE 0x200
+#define PF_A133_RENDER_MMIO_IRQ 150
 #define PF_A133_RENDER_HOSTMEM_BASE 0x10000000
 #define PF_A133_RENDER_HOSTMEM_SIZE 0x10000000
+#define PF_A133_APPLICATION_MMIO_BASE 0x0a000200
+#define PF_A133_APPLICATION_MMIO_SIZE 0x200
+#define PF_A133_APPLICATION_MMIO_IRQ 151
+#define PF_A133_APPLICATION_BUS "pfvd-app-serial.0"
+#define PF_A133_REAL_MAX_SPI 143
 
 typedef struct ExpectedRegion {
     const char *name;
@@ -354,6 +362,177 @@ static void test_render_accelerator_contract(void)
     qtest_quit(qts);
 }
 
+static bool ranges_overlap(uint64_t base, uint64_t size,
+                           uint64_t other_base, uint64_t other_size)
+{
+    return base < other_base + other_size &&
+           other_base < base + size;
+}
+
+static bool application_window_is_free(uint64_t base, uint64_t size)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(expected_regions); i++) {
+        if (ranges_overlap(base, size, expected_regions[i].base,
+                           expected_regions[i].size)) {
+            return false;
+        }
+    }
+    return !ranges_overlap(base, size, PF_A133_RENDER_MMIO_BASE,
+                           PF_A133_RENDER_MMIO_SIZE) &&
+           !ranges_overlap(base, size, PF_A133_RENDER_HOSTMEM_BASE,
+                           PF_A133_RENDER_HOSTMEM_SIZE);
+}
+
+static bool application_irq_is_free(unsigned int irq)
+{
+    return irq > PF_A133_REAL_MAX_SPI && irq != PF_A133_RENDER_MMIO_IRQ;
+}
+
+static char *create_minimal_dtb(void)
+{
+    g_autoptr(GError) error = NULL;
+    g_autofree char *path = NULL;
+    uint8_t blob[4096] = { 0 };
+    int fd;
+    int root;
+
+    fd = g_file_open_tmp("pf-a133-input-XXXXXX", &path, &error);
+    g_assert_no_error(error);
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+
+    g_assert_cmpint(fdt_create_empty_tree(blob, sizeof(blob)), ==, 0);
+    root = fdt_path_offset(blob, "/");
+    g_assert_cmpint(root, >=, 0);
+    g_assert_cmpint(fdt_setprop_u32(blob, root, "#address-cells", 2), ==, 0);
+    g_assert_cmpint(fdt_setprop_u32(blob, root, "#size-cells", 2), ==, 0);
+    g_assert_true(g_file_set_contents(path, (char *)blob,
+                                      fdt_totalsize(blob), &error));
+    g_assert_no_error(error);
+
+    return g_steal_pointer(&path);
+}
+
+static char *create_temp_path(void)
+{
+    g_autoptr(GError) error = NULL;
+    char *path = NULL;
+    int fd = g_file_open_tmp("pf-a133-output-XXXXXX", &path, &error);
+
+    g_assert_no_error(error);
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    return path;
+}
+
+static void assert_application_dtb_node(const char *dtb_path)
+{
+    g_autoptr(GError) error = NULL;
+    g_autofree char *blob = NULL;
+    const fdt32_t *cells;
+    const char *compatible;
+    gsize length;
+    int node;
+    int property_length;
+
+    g_assert_true(g_file_get_contents(dtb_path, &blob, &length, &error));
+    g_assert_no_error(error);
+    g_assert_cmpint(fdt_check_header(blob), ==, 0);
+
+    node = fdt_path_offset(blob, "/virtio_mmio@a000200");
+    g_assert_cmpint(node, >=, 0);
+
+    compatible = fdt_getprop(blob, node, "compatible", &property_length);
+    g_assert_nonnull(compatible);
+    g_assert_cmpint(property_length, ==, sizeof("virtio,mmio"));
+    g_assert_cmpstr(compatible, ==, "virtio,mmio");
+
+    cells = fdt_getprop(blob, node, "reg", &property_length);
+    g_assert_nonnull(cells);
+    g_assert_cmpint(property_length, ==, 4 * sizeof(*cells));
+    g_assert_cmphex(fdt32_to_cpu(cells[0]), ==, 0);
+    g_assert_cmphex(fdt32_to_cpu(cells[1]), ==,
+                    PF_A133_APPLICATION_MMIO_BASE);
+    g_assert_cmphex(fdt32_to_cpu(cells[2]), ==, 0);
+    g_assert_cmphex(fdt32_to_cpu(cells[3]), ==,
+                    PF_A133_APPLICATION_MMIO_SIZE);
+
+    cells = fdt_getprop(blob, node, "interrupts", &property_length);
+    g_assert_nonnull(cells);
+    g_assert_cmpint(property_length, ==, 3 * sizeof(*cells));
+    g_assert_cmphex(fdt32_to_cpu(cells[0]), ==, 0);
+    g_assert_cmphex(fdt32_to_cpu(cells[1]), ==,
+                    PF_A133_APPLICATION_MMIO_IRQ);
+    g_assert_cmphex(fdt32_to_cpu(cells[2]), ==, 1);
+
+    g_assert_nonnull(fdt_getprop(blob, node, "dma-coherent",
+                                 &property_length));
+    g_assert_cmpint(property_length, ==, 0);
+}
+
+static void test_application_transport_contract(void)
+{
+    g_autofree char *input_dtb = create_minimal_dtb();
+    g_autofree char *output_dtb = create_temp_path();
+    g_autofree char *args = NULL;
+    g_autofree char *map = NULL;
+    QTestState *qts;
+    QDict *dtb_args;
+    QDict *error;
+
+    /* The accepted window is free; the negative control overlaps the GPU. */
+    g_assert_true(application_window_is_free(PF_A133_APPLICATION_MMIO_BASE,
+                                             PF_A133_APPLICATION_MMIO_SIZE));
+    g_assert_false(application_window_is_free(
+        PF_A133_RENDER_MMIO_BASE + PF_A133_RENDER_MMIO_SIZE / 2,
+        PF_A133_APPLICATION_MMIO_SIZE));
+    g_assert_true(application_irq_is_free(PF_A133_APPLICATION_MMIO_IRQ));
+    g_assert_false(application_irq_is_free(PF_A133_RENDER_MMIO_IRQ));
+
+    args = g_strdup_printf(
+        "-machine pocketforge-a133 -nodefaults -display none "
+        "-dtb %s -chardev null,id=bulk", input_dtb);
+    qts = qtest_init(args);
+
+    g_assert_cmphex(qtest_readl(qts, PF_A133_APPLICATION_MMIO_BASE +
+                                VIRTIO_MMIO_MAGIC_VALUE), ==, 0x74726976);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_APPLICATION_MMIO_BASE +
+                                VIRTIO_MMIO_VERSION), ==, 2);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_APPLICATION_MMIO_BASE +
+                                VIRTIO_MMIO_DEVICE_ID), ==,
+                    VIRTIO_ID_CONSOLE);
+
+    map = qtest_hmp(qts, "info mtree");
+    g_assert_nonnull(strstr(map,
+        "000000000a000200-000000000a0003ff (prio 0, i/o): virtio-mmio"));
+
+    qtest_qmp_assert_success(
+        qts,
+        "{ 'execute': 'device_add', 'arguments': {"
+        " 'driver': 'virtserialport', 'id': 'bulk-port',"
+        " 'bus': '" PF_A133_APPLICATION_BUS "',"
+        " 'chardev': 'bulk', 'name': 'pfvd.app-bulk' } }");
+
+    error = qtest_qmp_assert_failure_ref(
+        qts,
+        "{ 'execute': 'device_add', 'arguments': {"
+        " 'driver': 'virtio-serial-device', 'id': 'extra-controller' } }");
+    g_assert_nonnull(strstr(qdict_get_str(error, "desc"), "virtio-bus"));
+    qobject_unref(error);
+
+    dtb_args = qdict_new();
+    qdict_put_str(dtb_args, "filename", output_dtb);
+    qtest_qmp_assert_success(
+        qts, "{ 'execute': 'dumpdtb', 'arguments': %p }", dtb_args);
+    assert_application_dtb_node(output_dtb);
+
+    qtest_quit(qts);
+    g_assert_cmpint(g_remove(input_dtb), ==, 0);
+    g_assert_cmpint(g_remove(output_dtb), ==, 0);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
@@ -369,6 +548,8 @@ int main(int argc, char **argv)
                    test_ccu_pll_lock_contract);
     qtest_add_func("/pocketforge-a133-mmio/render-accelerator-contract",
                    test_render_accelerator_contract);
+    qtest_add_func("/pocketforge-a133-mmio/application-transport-contract",
+                   test_application_transport_contract);
 
     return g_test_run();
 }
