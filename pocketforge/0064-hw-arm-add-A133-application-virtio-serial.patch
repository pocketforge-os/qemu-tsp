 tests/qtest/meson.build                      |   1 +
 tests/qtest/pocketforge-a133-input-test.c    |  10 +-
 tests/qtest/pocketforge-a133-mmio-map-test.c | 181 +++++++++++++++++++
 4 files changed, 238 insertions(+), 10 deletions(-)

