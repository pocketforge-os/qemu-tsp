 #define PF_A133_RENDER_MMIO_BASE     0x0a000000
 #define PF_A133_RENDER_MMIO_SIZE     0x200
 #define PF_A133_RENDER_MMIO_IRQ      150
+#define PF_A133_APPLICATION_MMIO_BASE 0x0a000200
+#define PF_A133_APPLICATION_MMIO_SIZE 0x200
+#define PF_A133_APPLICATION_MMIO_IRQ  151
+#define PF_A133_APPLICATION_BUS       "pfvd-app-serial.0"
 #define PF_A133_RENDER_HOSTMEM_BASE  0x10000000
 #define PF_A133_RENDER_HOSTMEM_SIZE  (256 * MiB)
 
@@ -1037,23 +1042,58 @@ static void pocketforge_a133_create_render_accelerator(
     object_unref(OBJECT(gpu));
