-static void pocketforge_a133_modify_dtb(const struct arm_boot_info *binfo,
-                                        void *fdt)
+static void pocketforge_a133_create_application_transport(
+    MachineState *machine, qemu_irq irq)
+{
+    DeviceState *transport = qdev_new(TYPE_VIRTIO_MMIO);
+    DeviceState *serial = qdev_new(TYPE_VIRTIO_SERIAL);
+    g_autofree char *bus_name = g_strdup(PF_A133_APPLICATION_BUS);
+
+    qdev_prop_set_bit(transport, "force-legacy", false);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(transport), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(transport), 0,
+                    PF_A133_APPLICATION_MMIO_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(transport), 0, irq);
+
+    /*
+     * Keep the controller machine-owned and the child bus name independent
+     * of command-line device ordering.  pfvd supplies exactly one
+     * virtserialport on this stable bus; no second controller is needed.
+     */
+    virtio_device_set_child_bus_name(VIRTIO_DEVICE(serial), bus_name);
+    object_property_add_child(OBJECT(machine),
+                              "pocketforge-application-serial",
+                              OBJECT(serial));
+    qdev_realize(serial, BUS(&VIRTIO_MMIO(transport)->bus), &error_fatal);
+    object_unref(OBJECT(serial));
+}
+
+static void pocketforge_a133_add_virtio_mmio_dtb_node(
+    void *fdt, hwaddr base, hwaddr size, int irq)
 {
     g_autofree char *node = g_strdup_printf("/virtio_mmio@%" PRIx64,
-                                             (uint64_t)PF_A133_RENDER_MMIO_BASE);
+                                             (uint64_t)base);
 
     qemu_fdt_add_subnode(fdt, node);
     qemu_fdt_setprop_string(fdt, node, "compatible", "virtio,mmio");
-    qemu_fdt_setprop_sized_cells(fdt, node, "reg",
-                                 2, PF_A133_RENDER_MMIO_BASE,
-                                 2, PF_A133_RENDER_MMIO_SIZE);
+    qemu_fdt_setprop_sized_cells(fdt, node, "reg", 2, base, 2, size);
     qemu_fdt_setprop_cells(fdt, node, "interrupts",
-                           GIC_FDT_IRQ_TYPE_SPI, PF_A133_RENDER_MMIO_IRQ,
+                           GIC_FDT_IRQ_TYPE_SPI, irq,
                            GIC_FDT_IRQ_FLAGS_EDGE_LO_HI);
     qemu_fdt_setprop(fdt, node, "dma-coherent", NULL, 0);
 }
 
+static void pocketforge_a133_modify_dtb(const struct arm_boot_info *binfo,
+                                        void *fdt)
+{
+    pocketforge_a133_add_virtio_mmio_dtb_node(
+        fdt, PF_A133_RENDER_MMIO_BASE, PF_A133_RENDER_MMIO_SIZE,
+        PF_A133_RENDER_MMIO_IRQ);
+    pocketforge_a133_add_virtio_mmio_dtb_node(
+        fdt, PF_A133_APPLICATION_MMIO_BASE, PF_A133_APPLICATION_MMIO_SIZE,
+        PF_A133_APPLICATION_MMIO_IRQ);
+}
+
 static void pocketforge_a133_init(MachineState *machine)
 {
     PocketForgeA133MachineState *s = POCKETFORGE_A133_MACHINE(machine);
@@ -1153,6 +1193,8 @@ static void pocketforge_a133_init(MachineState *machine)
     pocketforge_a133_create_ccu_pio(s, machine);
     pocketforge_a133_create_render_accelerator(
         machine, pic[PF_A133_RENDER_MMIO_IRQ]);
+    pocketforge_a133_create_application_transport(
+        machine, pic[PF_A133_APPLICATION_MMIO_IRQ]);
 
     binfo->ram_size = machine->ram_size;
     binfo->board_id = -1; /* device-tree boot only, no ATAGS board id */
