+static void test_pek_irq_path_and_masked_negative(void)
+{
+    QDict *response;
+
+    g_assert_cmphex(R_INTC_READ(R_INTC_CTRL), ==, 0);
+    g_assert_cmphex(R_INTC_READ(R_INTC_ENABLE), ==, 0);
+    g_assert_cmphex(R_INTC_READ(R_INTC_PENDING), ==, 0);
+
+    /* Negative control: a disabled PMIC mask makes the device inactive. */
+    qtest_writel(global_qtest, R_INTC_BASE + R_INTC_ENABLE, 1);
+    response = power_send(1);
+    assert_qmp_error(response, POWER_KEY_INACTIVE);
+    g_assert_cmphex(axp717_read(AXP717_IRQ1_STATE), ==, 0);
+    g_assert_cmphex(R_INTC_READ(R_INTC_PENDING), ==, 0);
+
+    axp717_write(AXP717_IRQ1_EN, AXP717_PEK_RISE | AXP717_PEK_FALL);
+    assert_qmp_success(power_send(1));
+    g_assert_cmphex(axp717_read(AXP717_IRQ1_STATE), ==, AXP717_PEK_FALL);
+    g_assert_cmphex(R_INTC_READ(R_INTC_PENDING), ==, 1);
+
+    /*
+     * The latch must acknowledge once even while the active-low PMIC line is
+     * asserted.  Re-latching without a new edge starves the QMP main loop.
+     */
+    qtest_writel(global_qtest, R_INTC_BASE + R_INTC_PENDING, 1);
+    g_assert_cmphex(R_INTC_READ(R_INTC_PENDING), ==, 0);
+
+    /* PMIC W1C deasserts its level; NMI pending has its own W1C latch. */
+    axp717_write(AXP717_IRQ1_STATE, AXP717_PEK_FALL);
+    qtest_writel(global_qtest, R_INTC_BASE + R_INTC_PENDING, 1);
+    g_assert_cmphex(axp717_read(AXP717_IRQ1_STATE), ==, 0);
+    g_assert_cmphex(R_INTC_READ(R_INTC_PENDING), ==, 0);
+
+    /* A short release sets rising-edge and short-duration status together. */
+    qtest_clock_step(global_qtest, 100 * 1000 * 1000);
+    assert_qmp_success(power_send(0));
+    g_assert_cmphex(axp717_read(AXP717_IRQ1_STATE), ==,
+                    AXP717_PEK_RISE | AXP717_PEK_SHORT);
+    axp717_write(AXP717_IRQ1_STATE, 0xff);
+    qtest_writel(global_qtest, R_INTC_BASE + R_INTC_PENDING, 1);
+
+    /* A held key is classified long, while Linux still sees one release. */
+    assert_qmp_success(power_send(1));
+    axp717_write(AXP717_IRQ1_STATE, AXP717_PEK_FALL);
+    qtest_writel(global_qtest, R_INTC_BASE + R_INTC_PENDING, 1);
+    qtest_clock_step(global_qtest, 2 * 1000 * 1000 * 1000LL);
+    assert_qmp_success(power_send(0));
+    g_assert_cmphex(axp717_read(AXP717_IRQ1_STATE), ==,
+                    AXP717_PEK_RISE | AXP717_PEK_LONG);
+}
