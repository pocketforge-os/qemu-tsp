+static void test_power_key_query_and_negative_control(void)
+{
+    QTestState *qts = qtest_init("-machine pocketforge-a133 -nodefaults");
+    QDict *response = qtest_qmp(qts,
+        "{ 'execute': 'query-pocketforge-input' }");
+    QDict *device = query_device_by_id(response, "power-key");
+
+    g_assert_cmpstr(qdict_get_str(device, "name"), ==, "axp20x-pek");
+    g_assert_cmpint(qdict_get_int(device, "bustype"), ==, 0);
+    g_assert_cmpint(qdict_get_int(device, "vendor"), ==, 0);
+    g_assert_cmpint(qdict_get_int(device, "product"), ==, 0);
+    g_assert_cmpint(qdict_get_int(device, "version"), ==, 0);
+    g_assert_false(qdict_get_bool(device, "ready"));
+    g_assert_true(query_has_code(device, EV_SYN, SYN_REPORT));
+    g_assert_true(query_has_code(device, EV_KEY, KEY_POWER));
+    g_assert_false(query_has_code(device, EV_SW, SW_LID));
+    qobject_unref(response);
+
+    response = qtest_qmp(qts,
+        "{ 'execute': 'pocketforge-input-send', 'arguments': {"
+        " 'device': 'power-key', 'events': ["
+        " { 'type': %d, 'code': %d, 'value': 1 },"
+        " { 'type': 0, 'code': 0, 'value': 0 } ] } }",
+        EV_SW, SW_LID);
+    assert_error_prefix(response,
+        "pocketforge-input: reason=invalid-parameter index=0:");
+    qobject_unref(response);
+    qtest_quit(qts);
+}
