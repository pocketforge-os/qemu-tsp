+#define AXP717_IRQ1_EN      0x41
+#define AXP717_IRQ1_STATE   0x49
+#define AXP717_PEK_RISE     0x01
+#define AXP717_PEK_FALL     0x02
+#define AXP717_PEK_LONG     0x04
+#define AXP717_PEK_SHORT    0x08
+#define POWER_KEY_INACTIVE "PocketForge input device 'power-key' is not active"
