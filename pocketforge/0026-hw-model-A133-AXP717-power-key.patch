 typedef struct AXP2xxClass {
@@ -168,9 +174,9 @@ static void axp221_reset_enter(AXP2xxI2CState *s, ResetType type)
  * The AXP717 subtype is deliberately only a software-visible register bank.
  * It models IRQ enable 0x40..0x44, W1C IRQ status 0x48..0x4c, regulator
  * enable 0x80, and regulator voltage/enable controls 0x83..0x9f.  Those
- * values only report prior guest writes: they are not hardware measurements.
- * Unmodelled registers read as zero and ignore writes.  The model generates
- * no PMIC events and has no interrupt output.
+ * values report prior guest writes and the modeled PEK edge/duration status;
+ * they are not hardware measurements. Unmodelled registers read as zero and
+ * ignore writes. Enabled status bits drive the PMIC interrupt output.
  */
 static bool axp717_reg_is_modelled(uint8_t reg)
 {
@@ -184,6 +190,17 @@ static uint8_t axp717_read(AXP2xxI2CState *s, uint8_t reg)
     return axp717_reg_is_modelled(reg) ? s->regs[reg] : 0;
 }
 
+static void axp717_update_irq(AXP2xxI2CState *s)
+{
+    unsigned int i;
+    bool level = false;
+
+    for (i = 0; i < 5; i++) {
+        level |= (s->regs[0x40 + i] & s->regs[0x48 + i]) != 0;
+    }
+    qemu_set_irq(s->irq, level);
+}
+
 static void axp717_write(AXP2xxI2CState *s, uint8_t reg, uint8_t value)
 {
     if (reg >= 0x48 && reg <= 0x4c) {
@@ -191,6 +208,10 @@ static void axp717_write(AXP2xxI2CState *s, uint8_t reg, uint8_t value)
     } else if (axp717_reg_is_modelled(reg)) {
         s->regs[reg] = value;
     }
+    if ((reg >= 0x40 && reg <= 0x44) ||
+        (reg >= 0x48 && reg <= 0x4c)) {
+        axp717_update_irq(s);
+    }
 }
 
 static void axp717_reset_enter(AXP2xxI2CState *s, ResetType type)
@@ -198,6 +219,41 @@ static void axp717_reset_enter(AXP2xxI2CState *s, ResetType type)
     memset(s->regs, 0, NR_REGS);
     s->ptr = 0;
     s->count = 0;
+    s->pek_pressed = false;
+    s->pek_press_ns = 0;
+    qemu_set_irq(s->irq, 0);
+}
+
+void axp717_pek_set(DeviceState *dev, bool pressed)
+{
+    AXP2xxI2CState *s = AXP2XX(dev);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    g_assert(object_dynamic_cast(OBJECT(dev), TYPE_AXP717_PMU));
+    g_assert(pressed != s->pek_pressed);
+    s->pek_pressed = pressed;
+    if (pressed) {
+        s->pek_press_ns = now;
+        s->regs[0x49] |= BIT(1); /* PEK falling edge */
+    } else {
+        s->regs[0x49] |= BIT(0); /* PEK rising edge */
+        /*
+         * AXP717 reports duration alongside the release edge.  One second
+         * separates its short and long classifications; Linux consumes only
+         * the two edge resources for KEY_POWER.
+         */
+        s->regs[0x49] |= now - s->pek_press_ns >= NANOSECONDS_PER_SECOND ?
+                         BIT(2) : BIT(3);
+    }
+    axp717_update_irq(s);
+}
+
+bool axp717_pek_is_ready(DeviceState *dev)
+{
+    AXP2xxI2CState *s = AXP2XX(dev);
+
+    return object_dynamic_cast(OBJECT(dev), TYPE_AXP717_PMU) &&
+           (s->regs[0x41] & (BIT(0) | BIT(1))) == (BIT(0) | BIT(1));
 }
 
