+static void pocketforge_a133_power_key_send(
+    PocketForgeA133MachineState *s, PocketForgeInputEventList *events,
+    Error **errp)
+{
+    PocketForgeInputEventList *item;
+    bool held = s->power_key_held;
+    bool report_has_event = false;
+    size_t count = 0;
+    size_t index = 0;
+
+    for (item = events; item; item = item->next) {
+        PocketForgeInputEvent *event = item->value;
+
+        count++;
+        if (count > PF_A133_INPUT_BATCH_MAX) {
+            error_setg(errp, "pocketforge-input: reason=resource-busy: "
+                       "batch exceeds %u events", PF_A133_INPUT_BATCH_MAX);
+            return;
+        }
+        if (event->type == EV_SYN && event->code == SYN_REPORT &&
+            event->value == 0) {
+            if (!report_has_event) {
+                error_setg(errp, "pocketforge-input: "
+                           "reason=invalid-parameter index=%zu: "
+                           "empty input report", index);
+                return;
+            }
+            report_has_event = false;
+        } else if (event->type != EV_KEY || event->code != KEY_POWER ||
+                   (event->value != 0 && event->value != 1)) {
+            error_setg(errp, "pocketforge-input: "
+                       "reason=invalid-parameter index=%zu: "
+                       "event is not advertised by power-key", index);
+            return;
+        } else if (!!event->value == held) {
+            error_setg(errp, "pocketforge-input: "
+                       "reason=invalid-parameter index=%zu: "
+                       "duplicate press or release-before-press", index);
+            return;
+        } else {
+            held = event->value;
+            report_has_event = true;
+        }
+        index++;
+    }
+    if (!count || report_has_event) {
+        error_setg(errp, "pocketforge-input: "
+                   "reason=invalid-parameter index=%zu: "
+                   "batch must end with SYN_REPORT", index);
+        return;
+    }
+    if (!s->pmic || !axp717_pek_is_ready(s->pmic) ||
+        !(s->r_intc_enable & 1)) {
+        error_set(errp, ERROR_CLASS_DEVICE_NOT_ACTIVE,
+                  "PocketForge input device 'power-key' is not active");
+        return;
+    }
+
+    for (item = events; item; item = item->next) {
+        PocketForgeInputEvent *event = item->value;
+
+        if (event->type == EV_KEY) {
+            axp717_pek_set(s->pmic, event->value);
+        }
+    }
+    s->power_key_held = held;
+}
