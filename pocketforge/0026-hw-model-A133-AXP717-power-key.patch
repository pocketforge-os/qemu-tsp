+static void pocketforge_a133_r_intc_update(PocketForgeA133MachineState *s)
+{
+    qemu_set_irq(s->r_intc_parent_irq,
+                 (s->r_intc_enable & s->r_intc_pending & 1) != 0);
+}
+
+static uint64_t pocketforge_a133_r_intc_read(void *opaque, hwaddr offset,
+                                             unsigned size)
+{
+    PocketForgeA133MachineState *s = opaque;
+
+    switch (offset) {
+    case 0x0:
+        return s->r_intc_ctrl;
+    case 0x4:
+        return s->r_intc_enable;
+    case 0x8:
+        return s->r_intc_pending;
+    default:
+        return 0;
+    }
+}
+
+static void pocketforge_a133_r_intc_write(void *opaque, hwaddr offset,
+                                          uint64_t value, unsigned size)
+{
+    PocketForgeA133MachineState *s = opaque;
+
+    switch (offset) {
+    case 0x0:
+        s->r_intc_ctrl = value & 3;
+        break;
+    case 0x4:
+        s->r_intc_enable = value & 1;
+        break;
+    case 0x8:
+        s->r_intc_pending &= ~(value & 1);
+        break;
+    }
+    pocketforge_a133_r_intc_update(s);
+}
+
+static const MemoryRegionOps pocketforge_a133_r_intc_ops = {
+    .read = pocketforge_a133_r_intc_read,
+    .write = pocketforge_a133_r_intc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void pocketforge_a133_r_intc_set(void *opaque, int n, int level)
+{
+    PocketForgeA133MachineState *s = opaque;
+
+    s->r_intc_source = level;
+    if (level) {
+        s->r_intc_pending |= 1;
+    }
+    pocketforge_a133_r_intc_update(s);
+}
+
+static qemu_irq pocketforge_a133_create_r_intc(
+    PocketForgeA133MachineState *s, qemu_irq parent_irq)
+{
+    s->r_intc_parent_irq = parent_irq;
+    memory_region_init_io(&s->r_intc_mmio, OBJECT(s),
+                          &pocketforge_a133_r_intc_ops, s,
+                          "pocketforge-a133.r_intc", PF_A133_R_INTC_SIZE);
+    memory_region_add_subregion(get_system_memory(), PF_A133_R_INTC_BASE,
+                                &s->r_intc_mmio);
+    return qemu_allocate_irq(pocketforge_a133_r_intc_set, s, 0);
+}
