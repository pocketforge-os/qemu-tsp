diff --git a/hw/misc/pocketforge_a100_r_pio.c b/hw/misc/pocketforge_a100_r_pio.c
new file mode 100644
index 0000000..5a00088
--- /dev/null
+++ b/hw/misc/pocketforge_a100_r_pio.c
@@ -0,0 +1,215 @@
+/*
+ * PocketForge A100 R_PIO model used by the A133 handheld.
+ *
+ * The release DT wires gpio-keys-hall to active-low PL9 with a pull-up.
+ * This model implements the A100 R_PIO cells used by the mainline sunxi
+ * pinctrl/GPIO driver: bank-L mux/data and its interrupt config, control,
+ * W1C status and debounce registers.  The external line resets open/high.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/pocketforge_a100_r_pio.h"
+#include "hw/irq.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+
+#define R_PIO_NUM_REGS (PF_A100_R_PIO_SIZE / sizeof(uint32_t))
+#define PL_CFG1         0x004
+#define PL_DATA         0x010
+#define PL_IRQ_CFG1     0x204
+#define PL_IRQ_CTRL     0x210
+#define PL_IRQ_STATUS   0x214
+#define PL_IRQ_DEBOUNCE 0x218
+#define PL9_BIT         BIT(9)
+#define PL9_SHIFT       4
+#define PL9_FUNC_IRQ    6
+
+struct PfA100RPioState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t regs[R_PIO_NUM_REGS];
+    bool lid_closed;
+};
+
+static void pf_a100_r_pio_update_irq(PfA100RPioState *s)
+{
+    qemu_set_irq(s->irq,
+                 (s->regs[PL_IRQ_CTRL / 4] &
+                  s->regs[PL_IRQ_STATUS / 4] & PL9_BIT) != 0);
+}
+
+static bool pf_a100_r_pio_pl9_irq_muxed(PfA100RPioState *s)
+{
+    return ((s->regs[PL_CFG1 / 4] >> PL9_SHIFT) & 0xf) == PL9_FUNC_IRQ;
+}
+
+static uint64_t pf_a100_r_pio_read(void *opaque, hwaddr offset,
+                                   unsigned size)
+{
+    PfA100RPioState *s = opaque;
+    uint32_t value;
+
+    if (offset >= PF_A100_R_PIO_SIZE || (offset & 3)) {
+        return 0;
+    }
+    value = s->regs[offset / 4];
+    if (offset == PL_DATA) {
+        value &= ~PL9_BIT;
+        if (!s->lid_closed) {
+            value |= PL9_BIT;
+        }
+    }
+    return value;
+}
+
+static void pf_a100_r_pio_write(void *opaque, hwaddr offset,
+                                uint64_t value, unsigned size)
+{
+    PfA100RPioState *s = opaque;
+
+    if (offset >= PF_A100_R_PIO_SIZE || (offset & 3)) {
+        return;
+    }
+    switch (offset) {
+    case PL_IRQ_STATUS:
+        s->regs[offset / 4] &= ~(value & PL9_BIT);
+        break;
+    case PL_IRQ_CTRL:
+        s->regs[offset / 4] = value & PL9_BIT;
+        break;
+    case PL_DATA:
+        /* PL9 is an external input; retain the other bank-L GPIO bits. */
+        s->regs[offset / 4] = value & ~PL9_BIT;
+        break;
+    case PL_CFG1:
+    case PL_IRQ_CFG1:
+    case PL_IRQ_DEBOUNCE:
+        s->regs[offset / 4] = value;
+        break;
+    default:
+        s->regs[offset / 4] = value;
+        break;
+    }
+    pf_a100_r_pio_update_irq(s);
+}
+
+static const MemoryRegionOps pf_a100_r_pio_ops = {
+    .read = pf_a100_r_pio_read,
+    .write = pf_a100_r_pio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+void pf_a100_r_pio_set_lid(PfA100RPioState *s, bool closed)
+{
+    bool old_high = !s->lid_closed;
+    bool new_high = !closed;
+    uint32_t trigger;
+    bool match = false;
+
+    if (s->lid_closed == closed) {
+        return;
+    }
+    s->lid_closed = closed;
+    trigger = (s->regs[PL_IRQ_CFG1 / 4] >> PL9_SHIFT) & 0xf;
+    switch (trigger) {
+    case 0: /* positive edge */
+        match = !old_high && new_high;
+        break;
+    case 1: /* negative edge */
+        match = old_high && !new_high;
+        break;
+    case 2: /* high level */
+        match = new_high;
+        break;
+    case 3: /* low level */
+        match = !new_high;
+        break;
+    case 4: /* both edges */
+        match = true;
+        break;
+    }
+    if (match && pf_a100_r_pio_pl9_irq_muxed(s)) {
+        s->regs[PL_IRQ_STATUS / 4] |= PL9_BIT;
+    }
+    pf_a100_r_pio_update_irq(s);
+}
+
+static void pf_a100_r_pio_reset(DeviceState *dev)
+{
+    PfA100RPioState *s = POCKETFORGE_A100_R_PIO(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->lid_closed = false;
+    qemu_set_irq(s->irq, 0);
+}
+
+static int pf_a100_r_pio_post_load(void *opaque, int version_id)
+{
+    PfA100RPioState *s = opaque;
+
+    pf_a100_r_pio_update_irq(s);
+    return 0;
+}
+
+static const VMStateDescription vmstate_pf_a100_r_pio = {
+    .name = TYPE_POCKETFORGE_A100_R_PIO,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = pf_a100_r_pio_post_load,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, PfA100RPioState, R_PIO_NUM_REGS),
+        VMSTATE_BOOL(lid_closed, PfA100RPioState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void pf_a100_r_pio_init(Object *obj)
+{
+    PfA100RPioState *s = POCKETFORGE_A100_R_PIO(obj);
+
+    memory_region_init_io(&s->iomem, obj, &pf_a100_r_pio_ops, s,
+                          "pocketforge-a133.r_pio", PF_A100_R_PIO_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+}
+
+static void pf_a100_r_pio_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->reset = pf_a100_r_pio_reset;
+    dc->vmsd = &vmstate_pf_a100_r_pio;
+}
+
+static const TypeInfo pf_a100_r_pio_info = {
+    .name = TYPE_POCKETFORGE_A100_R_PIO,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(PfA100RPioState),
+    .instance_init = pf_a100_r_pio_init,
+    .class_init = pf_a100_r_pio_class_init,
+};
+
+static void pf_a100_r_pio_register_types(void)
+{
+    type_register_static(&pf_a100_r_pio_info);
+}
+
+type_init(pf_a100_r_pio_register_types)
+
+DeviceState *pocketforge_a100_r_pio_create(hwaddr addr, qemu_irq irq)
+{
+    DeviceState *dev = qdev_new(TYPE_POCKETFORGE_A100_R_PIO);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, addr);
+    sysbus_connect_irq(sbd, 0, irq);
+    return dev;
+}
