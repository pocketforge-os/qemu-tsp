+        return;
+    }
     if (!s->input_device) {
         error_set(errp, ERROR_CLASS_DEVICE_NOT_FOUND,
                   "PocketForge input device 'gamepad' is disabled");
diff --git a/hw/misc/axp2xx.c b/hw/misc/axp2xx.c
index fbea78e..34dae30 100644
--- a/hw/misc/axp2xx.c
+++ b/hw/misc/axp2xx.c
@@ -37,6 +37,7 @@
 #include "hw/misc/axp2xx.h"
 #include "migration/vmstate.h"
 #include "qemu/timer.h"
+#include "sysemu/runstate.h"
 
 #define TYPE_AXP2XX     "axp2xx_pmu"
 #define TYPE_AXP209_PMU "axp209_pmu"
@@ -57,7 +58,11 @@ typedef struct AXP2xxI2CState {
     uint8_t count;          /* counter used for tx/rx */
     qemu_irq irq;
     bool pek_pressed;
+    bool pek_long_reported;
+    bool pek_offlevel_fired;
     int64_t pek_press_ns;
+    QEMUTimer *pek_irq_timer;
+    QEMUTimer *pek_off_timer;
 } AXP2xxI2CState;
 
 typedef struct AXP2xxClass {
@@ -172,15 +177,17 @@ static void axp221_reset_enter(AXP2xxI2CState *s, ResetType type)
 
 /*
  * The AXP717 subtype is deliberately only a software-visible register bank.
- * It models IRQ enable 0x40..0x44, W1C IRQ status 0x48..0x4c, regulator
- * enable 0x80, and regulator voltage/enable controls 0x83..0x9f.  Those
+ * It models PEK timing/power controls 0x22/0x26/0x27, IRQ enable
+ * 0x40..0x44, W1C IRQ status 0x48..0x4c, regulator enable 0x80, and
+ * regulator voltage/enable controls 0x83..0x9f.  Those
  * values report prior guest writes and the modeled PEK edge/duration status;
  * they are not hardware measurements. Unmodelled registers read as zero and
  * ignore writes. Enabled status bits drive the PMIC interrupt output.
  */
 static bool axp717_reg_is_modelled(uint8_t reg)
 {
-    return (reg >= 0x40 && reg <= 0x44) ||
+    return reg == 0x22 || reg == 0x26 || reg == 0x27 ||
+           (reg >= 0x40 && reg <= 0x44) ||
            (reg >= 0x48 && reg <= 0x4c) || reg == 0x80 ||
            (reg >= 0x83 && reg <= 0x9f);
 }
@@ -201,10 +208,115 @@ static void axp717_update_irq(AXP2xxI2CState *s)
     qemu_set_irq(s->irq, level);
 }
 
+#define AXP717_PWROFF_EN             0x22
+#define AXP717_PEK_LEVEL             0x26
+#define AXP717_SOFT_POWEROFF         0x27
+#define AXP717_PEK_IRQ_STATE         0x49
+#define AXP717_PWROFF_EN_OFFLEVEL    BIT(1)
+#define AXP717_PWROFF_EN_RESTART     BIT(0)
+#define AXP717_PEK_RISE              BIT(0)
+#define AXP717_PEK_FALL              BIT(1)
+#define AXP717_PEK_LONG              BIT(2)
+#define AXP717_PEK_SHORT             BIT(3)
+
+/*
+ * ShutdownCause has no power-loss value in QEMU 8.2.  A user-operated hard
+ * power control is closest to the existing host UI cause and, importantly,
+ * remains distinct from the guest-shutdown cause used by REG27[0].
+ */
+#define AXP717_OFFLEVEL_SHUTDOWN_CAUSE SHUTDOWN_CAUSE_HOST_UI
+
+static int64_t axp717_irqlevel_ns(AXP2xxI2CState *s)
+{
+    static const int64_t ns[] = {
+        NANOSECONDS_PER_SECOND,
+        NANOSECONDS_PER_SECOND + NANOSECONDS_PER_SECOND / 2,
+        2 * NANOSECONDS_PER_SECOND,
+        2 * NANOSECONDS_PER_SECOND + NANOSECONDS_PER_SECOND / 2,
+    };
+
+    return ns[(s->regs[AXP717_PEK_LEVEL] >> 4) & 3];
+}
+
+static int64_t axp717_offlevel_ns(AXP2xxI2CState *s)
+{
+    static const int64_t ns[] = {
+        4 * NANOSECONDS_PER_SECOND,
+        6 * NANOSECONDS_PER_SECOND,
+        8 * NANOSECONDS_PER_SECOND,
+        10 * NANOSECONDS_PER_SECOND,
+    };
+
+    return ns[(s->regs[AXP717_PEK_LEVEL] >> 2) & 3];
+}
+
+static void axp717_pek_long_expired(void *opaque)
+{
+    AXP2xxI2CState *s = opaque;
+
+    if (!s->pek_pressed || s->pek_long_reported) {
+        return;
+    }
+    s->pek_long_reported = true;
+    s->regs[AXP717_PEK_IRQ_STATE] |= AXP717_PEK_LONG;
+    axp717_update_irq(s);
+}
+
+static void axp717_pek_off_expired(void *opaque)
+{
+    AXP2xxI2CState *s = opaque;
+
+    if (!s->pek_pressed || s->pek_offlevel_fired ||
+        !(s->regs[AXP717_PWROFF_EN] & AXP717_PWROFF_EN_OFFLEVEL)) {
+        return;
+    }
+    s->pek_offlevel_fired = true;
+    if (s->regs[AXP717_PWROFF_EN] & AXP717_PWROFF_EN_RESTART) {
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    } else {
+        qemu_system_shutdown_request(AXP717_OFFLEVEL_SHUTDOWN_CAUSE);
+    }
+}
+
+static void axp717_pek_reschedule(AXP2xxI2CState *s)
+{
+    if (!s->pek_pressed) {
+        timer_del(s->pek_irq_timer);
+        timer_del(s->pek_off_timer);
+        return;
+    }
+    if (!s->pek_long_reported) {
+        timer_mod_ns(s->pek_irq_timer,
+                     s->pek_press_ns + axp717_irqlevel_ns(s));
+    }
+    if (!s->pek_offlevel_fired &&
+        (s->regs[AXP717_PWROFF_EN] & AXP717_PWROFF_EN_OFFLEVEL)) {
+        timer_mod_ns(s->pek_off_timer,
+                     s->pek_press_ns + axp717_offlevel_ns(s));
+    } else {
+        timer_del(s->pek_off_timer);
+    }
+}
+
 static void axp717_write(AXP2xxI2CState *s, uint8_t reg, uint8_t value)
 {
     if (reg >= 0x48 && reg <= 0x4c) {
         s->regs[reg] &= ~value;
+    } else if (reg == AXP717_PWROFF_EN) {
+        /* Bit 2 is reserved-high; bits 3, 1 and 0 are writable. */
+        s->regs[reg] = BIT(2) | (value & (BIT(3) | BIT(1) | BIT(0)));
+        axp717_pek_reschedule(s);
+    } else if (reg == AXP717_PEK_LEVEL) {
+        s->regs[reg] = value & 0x3f;
+        axp717_pek_reschedule(s);
+    } else if (reg == AXP717_SOFT_POWEROFF) {
+        /* REG27 bits 1 and 0 are write-one actions and self-clear. */
+        s->regs[reg] = BIT(2) | (value & BIT(3));
+        if (value & BIT(1)) {
+            qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+        } else if (value & BIT(0)) {
+            qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+        }
     } else if (axp717_reg_is_modelled(reg)) {
         s->regs[reg] = value;
     }
@@ -217,10 +329,18 @@ static void axp717_write(AXP2xxI2CState *s, uint8_t reg, uint8_t value)
 static void axp717_reset_enter(AXP2xxI2CState *s, ResetType type)
 {
     memset(s->regs, 0, NR_REGS);
+    /* AXP717 v1.2 POR: REG22=0x04, REG26=0x16, REG27=0x04. */
+    s->regs[AXP717_PWROFF_EN] = BIT(2);
+    s->regs[AXP717_PEK_LEVEL] = 0x16;
+    s->regs[AXP717_SOFT_POWEROFF] = BIT(2);
     s->ptr = 0;
     s->count = 0;
     s->pek_pressed = false;
+    s->pek_long_reported = false;
+    s->pek_offlevel_fired = false;
     s->pek_press_ns = 0;
+    timer_del(s->pek_irq_timer);
+    timer_del(s->pek_off_timer);
     qemu_set_irq(s->irq, 0);
 }
 
@@ -234,16 +354,17 @@ void axp717_pek_set(DeviceState *dev, bool pressed)
     s->pek_pressed = pressed;
     if (pressed) {
         s->pek_press_ns = now;
-        s->regs[0x49] |= BIT(1); /* PEK falling edge */
+        s->pek_long_reported = false;
+        s->pek_offlevel_fired = false;
+        s->regs[AXP717_PEK_IRQ_STATE] |= AXP717_PEK_FALL;
+        axp717_pek_reschedule(s);
     } else {
-        s->regs[0x49] |= BIT(0); /* PEK rising edge */
-        /*
-         * AXP717 reports duration alongside the release edge.  One second
-         * separates its short and long classifications; Linux consumes only
-         * the two edge resources for KEY_POWER.
-         */
-        s->regs[0x49] |= now - s->pek_press_ns >= NANOSECONDS_PER_SECOND ?
-                         BIT(2) : BIT(3);
+        timer_del(s->pek_irq_timer);
+        timer_del(s->pek_off_timer);
+        s->regs[AXP717_PEK_IRQ_STATE] |= AXP717_PEK_RISE;
+        if (!s->pek_long_reported) {
+            s->regs[AXP717_PEK_IRQ_STATE] |= AXP717_PEK_SHORT;
+        }
     }
     axp717_update_irq(s);
 }
@@ -323,6 +444,12 @@ static int axp2xx_post_load(void *opaque, int version_id)
     AXP2xxI2CState *s = opaque;
 
     if (object_dynamic_cast(OBJECT(s), TYPE_AXP717_PMU)) {
+        if (version_id < 3) {
+            s->pek_long_reported =
+                (s->regs[AXP717_PEK_IRQ_STATE] & AXP717_PEK_LONG) != 0;
+            s->pek_offlevel_fired = false;
+            axp717_pek_reschedule(s);
+        }
         axp717_update_irq(s);
     }
     return 0;
@@ -339,6 +466,10 @@ static const VMStateDescription vmstate_axp2xx = {
         VMSTATE_UINT8(count, AXP2xxI2CState),
         VMSTATE_BOOL_V(pek_pressed, AXP2xxI2CState, 2),
         VMSTATE_INT64_V(pek_press_ns, AXP2xxI2CState, 2),
+        VMSTATE_BOOL_V(pek_long_reported, AXP2xxI2CState, 3),
+        VMSTATE_BOOL_V(pek_offlevel_fired, AXP2xxI2CState, 3),
+        VMSTATE_TIMER_PTR_V(pek_irq_timer, AXP2xxI2CState, 3),
+        VMSTATE_TIMER_PTR_V(pek_off_timer, AXP2xxI2CState, 3),
         VMSTATE_END_OF_LIST()
     }
 };
@@ -361,6 +492,18 @@ static void axp2xx_init(Object *obj)
     AXP2xxI2CState *s = AXP2XX(obj);
 
     qdev_init_gpio_out(DEVICE(obj), &s->irq, 1);
+    s->pek_irq_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                    axp717_pek_long_expired, s);
+    s->pek_off_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                    axp717_pek_off_expired, s);
+}
+
+static void axp2xx_finalize(Object *obj)
+{
+    AXP2xxI2CState *s = AXP2XX(obj);
+
+    timer_free(s->pek_irq_timer);
+    timer_free(s->pek_off_timer);
 }
 
 static const TypeInfo axp2xx_info = {
@@ -368,6 +511,7 @@ static const TypeInfo axp2xx_info = {
     .parent = TYPE_I2C_SLAVE,
     .instance_size = sizeof(AXP2xxI2CState),
     .instance_init = axp2xx_init,
+    .instance_finalize = axp2xx_finalize,
     .class_size = sizeof(AXP2xxClass),
     .class_init = axp2xx_class_init,
     .abstract = true,
