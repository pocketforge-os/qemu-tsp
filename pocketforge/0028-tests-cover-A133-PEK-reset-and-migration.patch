+static void test_pek_reset_clears_machine_state(void)
+{
+    QDict *response;
+
+    axp717_write(AXP717_IRQ1_STATE, 0xff);
+    qtest_writel(global_qtest, R_INTC_BASE + R_INTC_CTRL, 3);
+    qtest_writel(global_qtest, R_INTC_BASE + R_INTC_ENABLE, 1);
+    axp717_write(AXP717_IRQ1_EN, AXP717_PEK_RISE | AXP717_PEK_FALL);
+    assert_qmp_success(power_send(1));
+    g_assert_cmphex(R_INTC_READ(R_INTC_PENDING), ==, 1);
+
+    qtest_qmp_assert_success(global_qtest, "{ 'execute': 'system_reset' }");
+    qtest_qmp_eventwait(global_qtest, "RESET");
+    g_assert_cmphex(R_INTC_READ(R_INTC_CTRL), ==, 0);
+    g_assert_cmphex(R_INTC_READ(R_INTC_ENABLE), ==, 0);
+    g_assert_cmphex(R_INTC_READ(R_INTC_PENDING), ==, 0);
+    g_assert_cmphex(axp717_read(AXP717_IRQ1_EN), ==, 0);
+    g_assert_cmphex(axp717_read(AXP717_IRQ1_STATE), ==, 0);
+
+    /* Negative control: reset also forgets the host-side held state. */
+    response = power_send(0);
+    assert_qmp_error(response,
+                     "pocketforge-input: reason=invalid-parameter index=0:");
+
+    /* Positive control: a fresh press/release works after reconfiguration. */
+    qtest_writel(global_qtest, R_INTC_BASE + R_INTC_ENABLE, 1);
+    axp717_write(AXP717_IRQ1_EN, AXP717_PEK_RISE | AXP717_PEK_FALL);
+    assert_qmp_success(power_send(1));
+    assert_qmp_success(power_send(0));
+}
+
+static void test_pek_migration(bool pressed)
+{
+    g_autofree char *tmpdir = NULL;
+    g_autofree char *socket_path = NULL;
+    g_autofree char *uri = NULL;
+    QTestState *from;
+    QTestState *to;
+    QDict *response;
+
+    tmpdir = g_dir_make_tmp("pocketforge-a133-migration-XXXXXX", NULL);
+    g_assert_nonnull(tmpdir);
+    socket_path = g_build_filename(tmpdir, "migration.sock", NULL);
+    uri = g_strdup_printf("unix:%s", socket_path);
+
+    from = qtest_init("-machine pocketforge-a133,pocketforge-display=off");
+    to = qtest_init("-machine pocketforge-a133,pocketforge-display=off "
+                    "-incoming defer");
+
+    qtest_writel(from, R_INTC_BASE + R_INTC_CTRL, 3);
+    qtest_writel(from, R_INTC_BASE + R_INTC_ENABLE, 1);
+    /* Program the PMIC through QOM-independent guest I2C in the main tests. */
+    qtest_writel(from, R_I2C0_BASE + TWI_CNTR,
+                 CNTR_BUS_ENABLE | CNTR_START);
+    g_assert_cmphex(qtest_readl(from, R_I2C0_BASE + TWI_STAT), ==, STAT_START);
+    qtest_writel(from, R_I2C0_BASE + TWI_DATA, 0x34 << 1);
+    g_assert_cmphex(qtest_readl(from, R_I2C0_BASE + TWI_STAT), ==,
+                    STAT_ADDR_WR_ACK);
+    qtest_writel(from, R_I2C0_BASE + TWI_DATA, AXP717_IRQ1_EN);
+    g_assert_cmphex(qtest_readl(from, R_I2C0_BASE + TWI_STAT), ==,
+                    STAT_DATA_TX_ACK);
+    qtest_writel(from, R_I2C0_BASE + TWI_DATA,
+                 AXP717_PEK_RISE | AXP717_PEK_FALL);
+    g_assert_cmphex(qtest_readl(from, R_I2C0_BASE + TWI_STAT), ==,
+                    STAT_DATA_TX_ACK);
+    qtest_writel(from, R_I2C0_BASE + TWI_CNTR,
+                 CNTR_BUS_ENABLE | CNTR_STOP);
+    if (pressed) {
+        assert_qmp_success(power_send_on(from, 1));
+        g_assert_cmphex(r_intc_read(from, R_INTC_PENDING), ==, 1);
+    }
+
+    migrate_incoming_qmp(to, uri, "{}");
+    migrate_qmp(from, uri, "{}");
+    wait_for_migration_complete(from);
+    wait_for_migration_complete(to);
+
+    g_assert_cmphex(r_intc_read(to, R_INTC_CTRL), ==, 3);
+    g_assert_cmphex(r_intc_read(to, R_INTC_ENABLE), ==, 1);
+    g_assert_cmphex(r_intc_read(to, R_INTC_PENDING), ==, pressed ? 1 : 0);
+
+    /* Negative and positive controls prove the held state migrated too. */
+    response = power_send_on(to, pressed ? 1 : 0);
+    assert_qmp_error(response,
+                     "pocketforge-input: reason=invalid-parameter index=0:");
+    assert_qmp_success(power_send_on(to, pressed ? 0 : 1));
+    if (!pressed) {
+        assert_qmp_success(power_send_on(to, 0));
+    }
+
+    qtest_quit(to);
+    qtest_quit(from);
+    g_assert_cmpint(g_remove(socket_path), ==, -1);
+    g_assert_cmpint(errno, ==, ENOENT);
+    g_assert_cmpint(g_rmdir(tmpdir), ==, 0);
+}
+
+static void test_pek_migration_idle(void)
+{
+    test_pek_migration(false);
+}
+
+static void test_pek_migration_pressed_pending(void)
+{
+    test_pek_migration(true);
+}
