+                         (const uint8_t[]) { 0x10, 0x20, 0x30, 0x40 });
+    assert_native_format(qts, &test, 4,
+                         (const uint8_t[]) { 0x11, 0x21, 0x31, 0x00 },
+                         (const uint8_t[]) { 0x11, 0x21, 0x31, 0x00 });
+    assert_native_format(qts, &test, 5,
+                         (const uint8_t[]) { 0x32, 0x22, 0x12, 0x00 },
+                         (const uint8_t[]) { 0x12, 0x22, 0x32, 0x00 });
+
