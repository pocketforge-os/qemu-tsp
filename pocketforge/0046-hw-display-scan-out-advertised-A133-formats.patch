diff --git a/tests/qtest/pocketforge-a133-display-test.c b/tests/qtest/pocketforge-a133-display-test.c
index 4fb68f4..6dc7154 100644
--- a/tests/qtest/pocketforge-a133-display-test.c
+++ b/tests/qtest/pocketforge-a133-display-test.c
@@ -56,6 +56,7 @@ typedef struct DisplayTest {
     guint update_format;
     gsize update_bytes;
     uint8_t update_pixel[4];
+    bool format_timed_out;
 } DisplayTest;
 
 enum {
@@ -175,6 +176,8 @@ static gboolean handle_scanout(QemuDBusDisplay1Listener *object,
     memcpy(test->first, pixels, sizeof(test->first));
     memcpy(test->last, pixels + test->bytes - sizeof(test->last),
            sizeof(test->last));
+    test->got_update = true;
+    memcpy(test->update_pixel, pixels, sizeof(test->update_pixel));
     g_main_loop_quit(test->loop);
     return DBUS_METHOD_INVOCATION_HANDLED;
 }
@@ -238,6 +241,40 @@ static gpointer server_thread(gpointer data)
     return p2p_from_fd(GPOINTER_TO_INT(data));
 }
 
+static gboolean format_deadline(gpointer opaque)
+{
+    DisplayTest *test = opaque;
+
+    test->format_timed_out = true;
+    g_main_loop_quit(test->loop);
+    return G_SOURCE_REMOVE;
+}
+
+static void assert_native_format(QTestState *qts, DisplayTest *test,
+                                 unsigned int format,
+                                 const uint8_t input[4],
+                                 const uint8_t expected[4])
+{
+    guint deadline_id;
+
+    g_test_message("checking DE2 format %u", format);
+    test->got_update = false;
+    test->format_timed_out = false;
+    qtest_memwrite(qts, PF_FB_ADDRESS, input, 4);
+    qtest_writel(qts, PF_MIXER_BASE + PF_MIXER_UI2 + PF_UI_ATTR,
+                 0xff000001 | (format << 8));
+    qtest_writel(qts, PF_MIXER_BASE + PF_MIXER_DBUFF, BIT(0));
+    deadline_id = g_timeout_add_seconds(1, format_deadline, test);
+    g_main_loop_run(test->loop);
+    if (!test->format_timed_out) {
+        g_source_remove(deadline_id);
+    }
+    g_assert_false(test->format_timed_out);
+    g_assert_true(test->got_update);
+    g_assert_cmpmem(test->update_pixel, sizeof(test->update_pixel),
+                    expected, 4);
+}
+
 static void test_native_scanout(void)
 {
     g_autoptr(GError) err = NULL;
@@ -308,6 +345,17 @@ static void test_native_scanout(void)
     g_assert_cmpuint(test.first[3], ==, 0x00);
     g_assert_cmpint(memcmp(test.first, test.last, sizeof(test.first)), !=, 0);
 
+    /* All formats advertised by query-pocketforge-display must scan out. */
+    assert_native_format(qts, &test, 0,
