+static void test_pek_irqlevel_boundaries(void)
+{
+    static const int64_t thresholds_ns[] = {
+        1000 * 1000 * 1000LL,
+        1500 * 1000 * 1000LL,
+        2000 * 1000 * 1000LL,
+        2500 * 1000 * 1000LL,
+    };
+    unsigned int setting;
+
+    g_assert_cmphex(axp717_read(AXP717_PWROFF_EN), ==, 0x04);
+    g_assert_cmphex(axp717_read(AXP717_IRQ_OFFLEVEL), ==, 0x16);
+    g_assert_cmphex(axp717_read(AXP717_SOFT_POWEROFF), ==, 0x04);
+    power_path_enable_on(global_qtest, AXP717_PEK_LONG);
+
+    for (setting = 0; setting < ARRAY_SIZE(thresholds_ns); setting++) {
+        QDict *response;
+
+        axp717_write(AXP717_IRQ_OFFLEVEL,
+                     (setting << 4) | 0x06);
+        assert_qmp_success(power_send(1));
+        axp717_write(AXP717_IRQ1_STATE, 0xff);
+
+        qtest_clock_step(global_qtest, thresholds_ns[setting] - 1);
+        g_assert_cmphex(axp717_read(AXP717_IRQ1_STATE) & AXP717_PEK_LONG,
+                        ==, 0);
+        qtest_clock_step(global_qtest, 1);
+        g_assert_cmphex(axp717_read(AXP717_IRQ1_STATE) & AXP717_PEK_LONG,
+                        ==, AXP717_PEK_LONG);
+
+        axp717_write(AXP717_IRQ1_STATE, 0xff);
+        assert_qmp_success(power_send(0));
+        g_assert_cmphex(axp717_read(AXP717_IRQ1_STATE), ==,
+                        AXP717_PEK_RISE);
+
+        /* Release-before-press remains a negative control each cycle. */
+        response = power_send(0);
+        assert_qmp_error(response,
+            "pocketforge-input: reason=invalid-parameter index=0:");
+        axp717_write(AXP717_IRQ1_STATE, 0xff);
+    }
+}
