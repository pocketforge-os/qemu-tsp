+static void test_lid_default_open_and_edges(void)
+{
+    QTestState *qts = qtest_init("-machine pocketforge-a133 -nodefaults");
+    QDict *response = qtest_qmp(qts,
+        "{ 'execute': 'query-pocketforge-input' }");
+    QDict *device = query_device_by_id(response, "lid-switch");
+
+    g_assert_cmpstr(qdict_get_str(device, "name"), ==, "gpio-keys-hall");
+    g_assert_cmpint(qdict_get_int(device, "bustype"), ==, BUS_HOST);
+    g_assert_cmpint(qdict_get_int(device, "vendor"), ==, 0x0001);
+    g_assert_cmpint(qdict_get_int(device, "product"), ==, 0x0001);
+    g_assert_cmpint(qdict_get_int(device, "version"), ==, 0x0100);
+    g_assert_true(qdict_get_bool(device, "ready"));
+    g_assert_true(query_has_code(device, EV_SYN, SYN_REPORT));
+    g_assert_true(query_has_code(device, EV_SW, SW_LID));
+    g_assert_false(query_has_code(device, EV_KEY, KEY_POWER));
+    qobject_unref(response);
+
+    /* Active-low PL9 is pulled high/open from reset. */
+    g_assert_cmphex(qtest_readl(qts, PF_R_PIO_BASE + PF_R_PIO_PL_DATA) &
+                    PF_R_PIO_PL9, ==, PF_R_PIO_PL9);
+    g_assert_cmphex(qtest_readl(qts, PF_R_PIO_BASE + PF_R_PIO_IRQ_STATUS),
+                    ==, 0);
+
+    qtest_writel(qts, PF_R_PIO_BASE + PF_R_PIO_PL_CFG1,
+                 PF_R_PIO_FUNC_IRQ << PF_R_PIO_PL9_SHIFT);
+    qtest_writel(qts, PF_R_PIO_BASE + PF_R_PIO_IRQ_CFG1,
+                 PF_R_PIO_IRQ_BOTH << PF_R_PIO_PL9_SHIFT);
+    qtest_writel(qts, PF_R_PIO_BASE + PF_R_PIO_IRQ_CTRL, PF_R_PIO_PL9);
+
+    /* Invalid capabilities fail before delivery and leave the line open. */
+    response = lid_send(qts, EV_KEY, KEY_POWER, 1);
+    assert_error_prefix(response,
+        "pocketforge-input: reason=invalid-parameter index=0:");
+    qobject_unref(response);
+    g_assert_cmphex(qtest_readl(qts, PF_R_PIO_BASE + PF_R_PIO_PL_DATA) &
+                    PF_R_PIO_PL9, ==, PF_R_PIO_PL9);
+
+    response = lid_send(qts, EV_SW, SW_LID, 1);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    g_assert_cmphex(qtest_readl(qts, PF_R_PIO_BASE + PF_R_PIO_PL_DATA) &
+                    PF_R_PIO_PL9, ==, 0);
+    g_assert_cmphex(qtest_readl(qts, PF_R_PIO_BASE + PF_R_PIO_IRQ_STATUS),
+                    ==, PF_R_PIO_PL9);
+
+    qtest_writel(qts, PF_R_PIO_BASE + PF_R_PIO_IRQ_STATUS, PF_R_PIO_PL9);
+    g_assert_cmphex(qtest_readl(qts, PF_R_PIO_BASE + PF_R_PIO_IRQ_STATUS),
+                    ==, 0);
+
+    /* Duplicate CLOSED is idempotent and must not invent an edge. */
+    response = lid_send(qts, EV_SW, SW_LID, 1);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    g_assert_cmphex(qtest_readl(qts, PF_R_PIO_BASE + PF_R_PIO_IRQ_STATUS),
+                    ==, 0);
+
+    response = lid_send(qts, EV_SW, SW_LID, 0);
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+    g_assert_cmphex(qtest_readl(qts, PF_R_PIO_BASE + PF_R_PIO_PL_DATA) &
+                    PF_R_PIO_PL9, ==, PF_R_PIO_PL9);
+    g_assert_cmphex(qtest_readl(qts, PF_R_PIO_BASE + PF_R_PIO_IRQ_STATUS),
+                    ==, PF_R_PIO_PL9);
+
+    qtest_quit(qts);
+}
