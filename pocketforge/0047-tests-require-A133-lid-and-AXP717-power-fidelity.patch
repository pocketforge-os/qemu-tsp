+static void test_pek_offlevel_force_poweroff(void)
+{
+    QTestState *qts = qtest_init(
+        "-machine pocketforge-a133,pocketforge-display=off -no-shutdown");
+    ShutdownEvents events = {NULL};
+
+    qtest_qmp_set_event_callback(qts, count_shutdown_events, &events);
+    power_path_enable_on(qts, AXP717_PEK_LONG);
+
+    /* POR bit 1 is clear: OFFLEVEL is gated off even after six seconds. */
+    g_assert_cmphex(axp717_read_on(qts, AXP717_PWROFF_EN), ==, 0x04);
+    assert_qmp_success(power_send_on(qts, 1));
+    qtest_clock_step(qts, 6 * 1000 * 1000 * 1000LL);
+    qmp_flush_events(qts);
+    g_assert_cmpuint(events.count, ==, 0);
+    assert_qmp_success(power_send_on(qts, 0));
+    axp717_write_on(qts, AXP717_IRQ1_STATE, 0xff);
+
+    /* Enable PWRON>OFFLEVEL, whose POR-selected threshold is six seconds. */
+    axp717_write_on(qts, AXP717_PWROFF_EN, 0x06);
+    assert_qmp_success(power_send_on(qts, 1));
+    axp717_write_on(qts, AXP717_IRQ1_STATE, 0xff);
+
+    qtest_clock_step(qts, 1500 * 1000 * 1000LL);
+    g_assert_cmphex(axp717_read_on(qts, AXP717_IRQ1_STATE) &
+                    AXP717_PEK_LONG, ==, AXP717_PEK_LONG);
+    qmp_flush_events(qts);
+    g_assert_cmpuint(events.count, ==, 0);
+
+    qtest_clock_step(qts, 4500 * 1000 * 1000LL - 1);
+    qmp_flush_events(qts);
+    g_assert_cmpuint(events.count, ==, 0);
+    qtest_clock_step(qts, 1);
+    qmp_flush_events(qts);
+    g_assert_cmpuint(events.count, ==, 1);
+    g_assert_false(events.guest);
+    g_assert_cmpstr(events.reason, ==, "host-ui");
+
+    /* Continuing and advancing time cannot emit a second shutdown. */
+    qtest_qmp_assert_success(qts, "{ 'execute': 'cont' }");
+    qtest_clock_step(qts, 6 * 1000 * 1000 * 1000LL);
+    qmp_flush_events(qts);
+    g_assert_cmpuint(events.count, ==, 1);
+
+    g_free(events.reason);
+    qtest_quit(qts);
+}
+
+static void test_axp717_soft_poweroff_exit(void)
+{
+    QTestState *qts = qtest_init(
+        "-machine pocketforge-a133,pocketforge-display=off -no-shutdown");
+    ShutdownEvents events = {NULL};
+
+    qtest_qmp_set_event_callback(qts, count_shutdown_events, &events);
+    axp717_write_on(qts, AXP717_SOFT_POWEROFF, 0x04);
+    qmp_flush_events(qts);
+    g_assert_cmpuint(events.count, ==, 0);
+
+    axp717_write_on(qts, AXP717_SOFT_POWEROFF, 0x05);
+    qmp_flush_events(qts);
+    g_assert_cmpuint(events.count, ==, 1);
+    g_assert_true(events.guest);
+    g_assert_cmpstr(events.reason, ==, "guest-shutdown");
+    g_free(events.reason);
+    qtest_quit(qts);
+
+    /* Without -no-shutdown the exact same guest I2C write exits QEMU. */
+    qts = qtest_init("-machine pocketforge-a133,pocketforge-display=off");
+    axp717_write_on(qts, AXP717_SOFT_POWEROFF, 0x05);
+    qtest_wait_qemu(qts);
+    qtest_quit(qts);
+}
