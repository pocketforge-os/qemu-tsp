+typedef struct ShutdownEvents {
+    unsigned int count;
+    bool guest;
+    char *reason;
+} ShutdownEvents;
+
+static bool count_shutdown_events(QTestState *qts, const char *name,
+                                  QDict *event, void *opaque)
+{
+    ShutdownEvents *events = opaque;
+    QDict *data;
+
+    if (strcmp(name, "SHUTDOWN")) {
+        return false;
+    }
+    data = qdict_get_qdict(event, "data");
+    events->count++;
+    events->guest = qdict_get_bool(data, "guest");
+    g_free(events->reason);
+    events->reason = g_strdup(qdict_get_str(data, "reason"));
+    return true;
+}
+
+static void qmp_flush_events(QTestState *qts)
+{
+    QDict *response = qtest_qmp(qts, "{ 'execute': 'query-status' }");
+
+    g_assert_nonnull(qdict_get(response, "return"));
+    qobject_unref(response);
+}
