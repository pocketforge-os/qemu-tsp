From: "pocketforge-agent[bot]"
 <299760760+pocketforge-agent[bot]@users.noreply.github.com>
Date: Wed, 14 Oct 2026 00:05:15 -0400
Subject: [PATCH 55/56] tests: require A133 render accelerator topology

Cover the fixed virtio-mmio transport and host-visible window, the absence of PCI and synthetic scanouts, and preservation of the single native D-Bus console.\n\nAssisted-by: LLM
---
 tests/qtest/pocketforge-a133-display-test.c  | 12 ++++
 tests/qtest/pocketforge-a133-mmio-map-test.c | 66 ++++++++++++++++++++
 2 files changed, 78 insertions(+)

diff --git a/tests/qtest/pocketforge-a133-display-test.c b/tests/qtest/pocketforge-a133-display-test.c
index 6827567..0af9bcf 100644
--- a/tests/qtest/pocketforge-a133-display-test.c
+++ b/tests/qtest/pocketforge-a133-display-test.c
@@ -285,8 +285,10 @@ static void test_native_scanout(void)
     g_autoptr(GError) err = NULL;
     g_autoptr(GDBusConnection) conn = NULL;
     g_autoptr(QemuDBusDisplay1ConsoleProxy) console = NULL;
+    g_autoptr(QemuDBusDisplay1VMProxy) vm = NULL;
     g_autoptr(GUnixFDList) fd_list = NULL;
     g_autoptr(GMainLoop) loop = NULL;
+    GVariant *console_ids;
     QTestState *qts;
     QDict *response;
     QDict *info;
@@ -308,6 +310,16 @@ static void test_native_scanout(void)
     conn = p2p_from_fd(dbus_pair[0]);
     g_dbus_connection_start_message_processing(conn);
 
+    vm = QEMU_DBUS_DISPLAY1_VM_PROXY(
+        qemu_dbus_display1_vm_proxy_new_sync(
+            conn, G_DBUS_PROXY_FLAGS_NONE, NULL,
+            DBUS_DISPLAY1_ROOT "/VM", NULL, &err));
+    g_assert_no_error(err);
+    console_ids = qemu_dbus_display1_vm_get_console_ids(
+        QEMU_DBUS_DISPLAY1_VM(vm));
+    g_assert_nonnull(console_ids);
+    g_assert_cmpuint(g_variant_n_children(console_ids), ==, 1);
+
     response = qtest_qmp(qts,
                          "{ 'execute': 'query-pocketforge-display' }");
     info = qdict_get_qdict(response, "return");
diff --git a/tests/qtest/pocketforge-a133-mmio-map-test.c b/tests/qtest/pocketforge-a133-mmio-map-test.c
index 4bf76e1..84234dc 100644
--- a/tests/qtest/pocketforge-a133-mmio-map-test.c
+++ b/tests/qtest/pocketforge-a133-mmio-map-test.c
@@ -6,6 +6,14 @@
 
 #include "qemu/osdep.h"
 #include "libqtest.h"
+#include "qobject/qdict.h"
+#include "qobject/qlist.h"
+#include "standard-headers/linux/virtio_ids.h"
+#include "standard-headers/linux/virtio_mmio.h"
+
+#define PF_A133_RENDER_MMIO_BASE 0x0a000000
+#define PF_A133_RENDER_HOSTMEM_BASE 0x10000000
+#define PF_A133_RENDER_HOSTMEM_SIZE 0x10000000
 
 typedef struct ExpectedRegion {
     const char *name;
@@ -283,6 +291,62 @@ static void test_ccu_pll_lock_contract(void)
     qtest_quit(qts);
 }
 
+static void test_render_accelerator_contract(void)
+{
+    QTestState *qts = mmio_start();
+    g_autofree char *map = NULL;
+    QDict *response;
+    QList *pci_buses;
+
+    /* The A133 gains one modern MMIO render accelerator, never PCI. */
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_MAGIC_VALUE), ==, 0x74726976);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_VERSION), ==, 2);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_DEVICE_ID), ==,
+                    VIRTIO_ID_GPU);
+
+    qtest_writel(qts, PF_A133_RENDER_MMIO_BASE + VIRTIO_MMIO_SHM_SEL, 1);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_LOW), ==,
+                    PF_A133_RENDER_HOSTMEM_SIZE);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_HIGH), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_BASE_LOW), ==,
+                    PF_A133_RENDER_HOSTMEM_BASE);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_BASE_HIGH), ==, 0);
+
+    /* Unknown selectors remain the required all-ones negative control. */
+    qtest_writel(qts, PF_A133_RENDER_MMIO_BASE + VIRTIO_MMIO_SHM_SEL, 2);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_LOW), ==, UINT32_MAX);
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_HIGH), ==, UINT32_MAX);
+
+    /* virtio_gpu_config.num_scanouts is zero: no connector or console. */
+    g_assert_cmphex(qtest_readl(qts, PF_A133_RENDER_MMIO_BASE +
+                                VIRTIO_MMIO_CONFIG + 8), ==, 0);
+
+    map = qtest_hmp(qts, "info mtree -f");
+    g_assert_nonnull(strstr(map,
+        "0000000010000000-000000001fffffff (prio 0, i/o): "
+        "virtio-shmem-1"));
+    g_assert_nonnull(strstr(map,
+        "000000000a000000-000000000a0001ff (prio 0, i/o): virtio-mmio"));
+
+    response = qtest_qmp(qts, "{ 'execute': 'query-pci' }");
+    g_assert_null(qdict_get(response, "error"));
+    pci_buses = qdict_get_qlist(response, "return");
+    g_assert_nonnull(pci_buses);
+    g_assert_cmpuint(qlist_size(pci_buses), ==, 0);
+    qobject_unref(response);
+
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
@@ -296,6 +360,8 @@ int main(int argc, char **argv)
                    test_uart_model_contract);
     qtest_add_func("/pocketforge-a133-mmio/ccu-pll-lock-contract",
                    test_ccu_pll_lock_contract);
+    qtest_add_func("/pocketforge-a133-mmio/render-accelerator-contract",
+                   test_render_accelerator_contract);
 
     return g_test_run();
 }
