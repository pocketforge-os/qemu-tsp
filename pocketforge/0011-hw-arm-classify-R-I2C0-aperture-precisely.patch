index b58cbde..fc0c9ee 100644
--- a/hw/arm/pocketforge_a133.c
+++ b/hw/arm/pocketforge_a133.c
@@ -47,8 +47,8 @@
  * README already flagged this), the SoC syscon/version block, the DE2
  * display pipeline (TCON-TOP/mixer0/TCON-LCD0, still probed+bound by the
  * real DT even though rendering is replaced by the virtio-gpu graft
- * below), SID/eFuse, R-domain pinctrl + I2C0 (the AXP717 PMIC bus -- see
- * (3) below), PWM, the thermal sensor, and the full USB stack (MUSB/PHY/
+ * below), SID/eFuse, R-domain pinctrl, PWM, the thermal sensor, and the
+ * full USB stack (MUSB/PHY/
  * enabled EHCI1/OHCI1 -- D10's original deferred cost, never functionally
  * modeled, only register-backed so probe doesn't hard-abort; the disabled
  * EHCI0/OHCI0 nodes are deliberately absent). Full
@@ -59,13 +59,12 @@
  * pocketforge_a133_create_virtio_mmio()/pocketforge_a133_modify_dtb()
  * below for how a from-scratch machine loading a REAL, unmodified DT (no
  * auto-generated FDT like -M virt has) still makes virtio-mmio
- * discoverable. (3) the regulator-less/PMIC-absence graceful-degradation
- * path (Phase B's other carried item) is independently confirmed reachable
- * and non-wedging by this same boot: with r_i2c0 stubbed, the AXP717
- * driver binds, its register read/irq-chip setup times out through the
- * i2c core's own bounded jiffies timeout (~2s), and probe fails cleanly
- * with -110 -- no hang, no abort, boot proceeds straight through to
- * userspace. CI wiring (Phase D) remains out of scope. The GE8300 silicon
+ * discoverable. (3) R-I2C0 now uses QEMU's sun6i controller, and the AXP717
+ * exposes only the bounded IRQ/regulator register bank needed by the
+ * mainline MFD and regulator drivers. It synthesizes no PMIC events or
+ * interrupts. Only the register-free tail of the DT's 0x400-byte R-I2C0
+ * reservation remains a stub. CI wiring (Phase D) remains out of scope.
+ * The GE8300 silicon
  * GPU / PowerVR blob is never modeled (aspirational) -- display output is
  * entirely the open virtio-gpu graft (virgl/llvmpipe on the host side).
  *
@@ -114,7 +113,6 @@ OBJECT_DECLARE_SIMPLE_TYPE(PocketForgeA133MachineState,
 
 struct PocketForgeA133MachineState {
     MachineState parent_obj;
-    MemoryRegion r_i2c0_container;
     I2CBus *r_i2c0_bus;
     bool input;
 };
@@ -498,15 +496,16 @@ static void pocketforge_a133_create_r_i2c0(PocketForgeA133MachineState *s,
     SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
 
     sysbus_realize_and_unref(sbd, &error_fatal);
-    memory_region_init(&s->r_i2c0_container, OBJECT(s),
-                       "pocketforge-a133.r_i2c0", PF_A133_R_I2C0_SIZE);
-    memory_region_add_subregion(&s->r_i2c0_container, 0,
-                                sysbus_mmio_get_region(sbd, 0));
-    memory_region_add_subregion(get_system_memory(), PF_A133_R_I2C0_BASE,
-                                &s->r_i2c0_container);
+    sysbus_mmio_map(sbd, 0, PF_A133_R_I2C0_BASE);
     sysbus_connect_irq(sbd, 0, irq);
     s->r_i2c0_bus = AW_I2C(dev)->bus;
     i2c_slave_create_simple(s->r_i2c0_bus, "axp717_pmu", 0x34);
+
+    /* The DT reserves 0x400 bytes; the sun6i register bank ends at 0x23. */
+    pocketforge_a133_mmio_stub_create(
+        "pocketforge-a133.r_i2c0.reserved",
+        PF_A133_R_I2C0_BASE + AW_I2C_MEM_SIZE,
+        PF_A133_R_I2C0_SIZE - AW_I2C_MEM_SIZE);
 }
 
