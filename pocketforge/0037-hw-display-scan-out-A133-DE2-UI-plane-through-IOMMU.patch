From b2aed317f616341949aa277b7f0d29c5a8718fd3 Mon Sep 17 00:00:00 2001
From: PocketForge Maintainers <maintainers@pocketforge.invalid>
Date: Tue, 13 Oct 2026 19:22:00 +0000
Subject: [PATCH 37/50] hw/display: scan out A133 DE2 UI plane through IOMMU

Create the native 720x1280 QemuConsole, decode the A100 primary UI channel
on mixer double-buffer commits, translate its IOVA page by page, and copy
the XR24 frame into the standard QEMU display surface used by D-Bus.


Rebase resolutions:
- Display API: port console creation and damage updates to qemu_graphic_console_create() and qemu_console_update().


Assisted-by: LLM

diff --git a/hw/arm/pocketforge_a133.c b/hw/arm/pocketforge_a133.c
index 52e8d2ec54..db904c6915 100644
--- a/hw/arm/pocketforge_a133.c
+++ b/hw/arm/pocketforge_a133.c
@@ -1161,7 +1161,8 @@ static void pocketforge_a133_init(MachineState *machine)
 
     pocketforge_a133_create_sram(s, sysmem);
     pocketforge_a133_create_mmio_stubs();
-    s->native_display = pocketforge_a133_display_create();
+    s->native_display = pocketforge_a133_display_create(
+        !strcmp(s->display, "hardware"));
     pocketforge_a133_create_r_i2c0(
         s, pic[113], pocketforge_a133_create_r_intc(s, pic[103]));
     qemu_register_reset(pocketforge_a133_power_reset, s);
@@ -1528,10 +1529,11 @@ PocketForgeDisplayInfo *pocketforge_a133_query_display(Error **errp)
     QAPI_LIST_APPEND(format_tail, g_strdup("XB24"));
     QAPI_LIST_APPEND(format_tail, g_strdup("AR24"));
 
-    if (!s->gpu || !s->gpu->scanout[0].con) {
+    if (!pocketforge_a133_display_console(s->native_display)) {
         return info;
     }
-    surface = qemu_console_surface(s->gpu->scanout[0].con);
+    surface = qemu_console_surface(
+        pocketforge_a133_display_console(s->native_display));
     if (!surface) {
         return info;
     }
diff --git a/hw/display/pocketforge_a133_display.c b/hw/display/pocketforge_a133_display.c
index 73972a0330..b5796b5820 100644
--- a/hw/display/pocketforge_a133_display.c
+++ b/hw/display/pocketforge_a133_display.c
@@ -11,6 +11,8 @@
 #include "hw/display/pocketforge_a133_display.h"
 #include "system/address-spaces.h"
 #include "hw/core/qdev-properties.h"
+#include "ui/console.h"
+#include "ui/surface.h"
 
 #define PF_IOMMU_BASE      0x030f0000
 #define PF_IOMMU_SIZE      0x10000
@@ -33,6 +35,15 @@
 #define PF_DSI_INST_ST     BIT(0)
 #define PF_TCON_CPU_IF     0x60
 #define PF_TCON_TRI_START  BIT(1)
+#define PF_MIXER_OFFSET    0x100000
+#define PF_MIXER_DBUFF     (PF_MIXER_OFFSET + 0x8)
+#define PF_MIXER_UI2       (PF_MIXER_OFFSET + 0x4000)
+#define PF_UI_ATTR         (PF_MIXER_UI2 + 0x0)
+#define PF_UI_SIZE         (PF_MIXER_UI2 + 0x4)
+#define PF_UI_PITCH        (PF_MIXER_UI2 + 0xc)
+#define PF_UI_LADDR        (PF_MIXER_UI2 + 0x10)
+#define PF_NATIVE_WIDTH    720
+#define PF_NATIVE_HEIGHT   1280
 
 typedef enum PfDisplayBankKind {
     PF_BANK_IOMMU,
@@ -49,13 +60,18 @@ typedef struct PfDisplayBank {
     uint32_t *regs;
     uint32_t size;
     PfDisplayBankKind kind;
+    struct PocketForgeA133DisplayState *display;
 } PfDisplayBank;
 
 struct PocketForgeA133DisplayState {
     SysBusDevice parent_obj;
     PfDisplayBank bank[PF_BANK_COUNT];
+    QemuConsole *console;
+    bool enabled;
 };
 
+static void pf_display_scanout(PocketForgeA133DisplayState *s);
+
 static uint64_t pf_display_read(void *opaque, hwaddr offset, unsigned size)
 {
     PfDisplayBank *bank = opaque;
@@ -89,6 +105,12 @@ static void pf_display_write(void *opaque, hwaddr offset, uint64_t value,
             bank->regs[offset / 4] = 0;
         }
         break;
+    case PF_BANK_DE2:
+        if (offset == PF_MIXER_DBUFF && (value & BIT(0))) {
+            pf_display_scanout(bank->display);
+            bank->regs[offset / 4] = 0;
+        }
+        break;
     case PF_BANK_DSI:
         if (offset == PF_DSI_BASIC_CTL0) {
             bank->regs[offset / 4] &= ~PF_DSI_INST_ST;
@@ -165,6 +187,59 @@ bool pocketforge_a133_display_iova_read(PocketForgeA133DisplayState *s,
     return true;
 }
 
+static void pf_display_scanout(PocketForgeA133DisplayState *s)
+{
+    PfDisplayBank *de2 = &s->bank[PF_BANK_DE2];
+    DisplaySurface *surface;
+    uint32_t attr, size, pitch, laddr;
+    unsigned int width, height, format, y;
+    uint8_t *destination;
+
+    if (!s->console) {
+        return;
+    }
+    attr = de2->regs[PF_UI_ATTR / 4];
+    size = de2->regs[PF_UI_SIZE / 4];
+    pitch = de2->regs[PF_UI_PITCH / 4];
+    laddr = de2->regs[PF_UI_LADDR / 4];
+    width = (size & 0xffff) + 1;
+    height = (size >> 16) + 1;
+    format = (attr >> 8) & 0x1f;
+
+    if (!(attr & BIT(0)) || width != PF_NATIVE_WIDTH ||
+        height != PF_NATIVE_HEIGHT || pitch < width * 4 ||
+        (format != 0 && format != 4)) {
+        return;
+    }
+
+    surface = qemu_console_surface(s->console);
+    destination = surface_data(surface);
+    for (y = 0; y < height; y++) {
+        if (!pocketforge_a133_display_iova_read(
+                s, laddr + y * pitch,
+                destination + y * surface_stride(surface), width * 4)) {
+            return;
+        }
+    }
+    qemu_console_update(s->console, 0, 0, width, height);
+}
+
+static void pf_display_invalidate(void *opaque)
+{
+    pf_display_scanout(opaque);
+}
+
+static bool pf_display_gfx_update(void *opaque)
+{
+    pf_display_scanout(opaque);
+    return true;
+}
+
+static const GraphicHwOps pf_display_hw_ops = {
+    .invalidate = pf_display_invalidate,
+    .gfx_update = pf_display_gfx_update,
+};
+
 static void pf_display_reset(DeviceState *dev)
 {
     PocketForgeA133DisplayState *s = POCKETFORGE_A133_DISPLAY(dev);
@@ -197,12 +272,18 @@ static void pf_display_realize(DeviceState *dev, Error **errp)
         PfDisplayBank *bank = &s->bank[i];
 
         bank->kind = i;
+        bank->display = s;
         bank->size = sizes[i];
         bank->regs = g_new0(uint32_t, bank->size / sizeof(uint32_t));
         memory_region_init_io(&bank->mr, OBJECT(s), &pf_display_ops, bank,
                               names[i], bank->size);
         sysbus_init_mmio(sbd, &bank->mr);
     }
+    if (s->enabled) {
+        s->console = qemu_graphic_console_create(dev, 0,
+                                                 &pf_display_hw_ops, s);
+        qemu_console_resize(s->console, PF_NATIVE_WIDTH, PF_NATIVE_HEIGHT);
+    }
 }
 
 static void pf_display_unrealize(DeviceState *dev)
@@ -216,6 +297,10 @@ static void pf_display_unrealize(DeviceState *dev)
     }
 }
 
+static const Property pf_display_properties[] = {
+    DEFINE_PROP_BOOL("enabled", PocketForgeA133DisplayState, enabled, true),
+};
+
 static void pf_display_class_init(ObjectClass *klass, const void *data)
 {
     DeviceClass *dc = DEVICE_CLASS(klass);
@@ -224,6 +309,8 @@ static void pf_display_class_init(ObjectClass *klass, const void *data)
     dc->unrealize = pf_display_unrealize;
     device_class_set_legacy_reset(dc, pf_display_reset);
     dc->desc = "PocketForge A133 native display pipeline";
+    set_bit(DEVICE_CATEGORY_DISPLAY, dc->categories);
+    device_class_set_props(dc, pf_display_properties);
 }
 
 static const TypeInfo pf_display_type_info = {
@@ -240,7 +327,7 @@ static void pf_display_register_types(void)
 
 type_init(pf_display_register_types)
 
-PocketForgeA133DisplayState *pocketforge_a133_display_create(void)
+PocketForgeA133DisplayState *pocketforge_a133_display_create(bool enabled)
 {
     static const hwaddr bases[PF_BANK_COUNT] = {
         PF_IOMMU_BASE, PF_DE2_BASE, PF_DSI_BASE, PF_DPHY_BASE,
@@ -250,9 +337,16 @@ PocketForgeA133DisplayState *pocketforge_a133_display_create(void)
     SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
     unsigned int i;
 
+    qdev_prop_set_bit(dev, "enabled", enabled);
     sysbus_realize_and_unref(sbd, &error_fatal);
     for (i = 0; i < PF_BANK_COUNT; i++) {
         sysbus_mmio_map(sbd, i, bases[i]);
     }
     return POCKETFORGE_A133_DISPLAY(dev);
 }
+
+QemuConsole *pocketforge_a133_display_console(
+    PocketForgeA133DisplayState *s)
+{
+    return s ? s->console : NULL;
+}
