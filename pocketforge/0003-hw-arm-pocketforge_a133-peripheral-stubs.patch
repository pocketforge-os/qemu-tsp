@@ -0,0 +1,55 @@
+/*
+ * PocketForge OS -M pocketforge-a133 generic RAM-backed MMIO peripheral stub
+ *
+ * PocketForge OS addition (qemu-tsp fork): Phase B of Odyssey L3 deliverable
+ * -2 (tsp-mc9m.41.925.2.2). A single reusable device model for the several
+ * A133 peripherals whose real drivers only need to probe past init without
+ * wedging -- r_intc/NMI, CCU, R-CCU, main pinctrl, and the watchdog. Each
+ * instance is a plain byte-addressable RAM region behind a device's real MMIO
+ * base/size (from the committed sun50i-a100.dtsi): a write stores the value,
+ * a read returns whatever was last stored there (0 after reset/at boot,
+ * matching the real hardware's un-programmed-register state well enough for
+ * a driver that never depends on a specific POR value). No interrupt output,
+ * no side effects, no register-specific behavior -- deliberately not a real
+ * model of any of these IPs. See docs/pocketforge-a133-peripheral-stubs.md
+ * for the register audit that justifies "plain RAM suffices" per stub.
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms and conditions of the GNU General Public License,
+ * version 2 or later, as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef HW_POCKETFORGE_A133_MMIO_STUB_H
+#define HW_POCKETFORGE_A133_MMIO_STUB_H
+
+#include "hw/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_POCKETFORGE_A133_MMIO_STUB "pocketforge-a133-mmio-stub"
+OBJECT_DECLARE_SIMPLE_TYPE(PfA133MmioStubState, POCKETFORGE_A133_MMIO_STUB)
+
+struct PfA133MmioStubState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint8_t *storage;
+    uint32_t size;
+    char *mmio_name;
+};
+
+/*
+ * Create and map a RAM-backed register-file stub of `size` bytes at `addr`.
+ * `name` is used only for the MemoryRegion's debug name (e.g. in `info mtree`).
+ */
+DeviceState *pocketforge_a133_mmio_stub_create(const char *name, hwaddr addr,
+                                               uint32_t size);
+
+#endif /* HW_POCKETFORGE_A133_MMIO_STUB_H */
