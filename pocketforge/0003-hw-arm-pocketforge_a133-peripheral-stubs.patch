diff --git a/hw/misc/pocketforge_a133_mmio_stub.c b/hw/misc/pocketforge_a133_mmio_stub.c
new file mode 100644
index 0000000..233ee5f
--- /dev/null
+++ b/hw/misc/pocketforge_a133_mmio_stub.c
@@ -0,0 +1,128 @@
+/*
+ * PocketForge OS -M pocketforge-a133 generic RAM-backed MMIO peripheral stub
+ *
+ * See include/hw/misc/pocketforge_a133_mmio_stub.h for the rationale. This
+ * device backs r_intc/NMI, CCU, R-CCU, main pinctrl (&pio), and the watchdog
+ * on the -M pocketforge-a133 machine (Phase B, tsp-mc9m.41.925.2.2): plain
+ * byte-addressable RAM, no side effects.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/pocketforge_a133_mmio_stub.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+
+DeviceState *pocketforge_a133_mmio_stub_create(const char *name, hwaddr addr,
+                                               uint32_t size)
+{
+    DeviceState *dev;
+    SysBusDevice *s;
+    PfA133MmioStubState *ss;
+
+    dev = qdev_new(TYPE_POCKETFORGE_A133_MMIO_STUB);
+    ss = POCKETFORGE_A133_MMIO_STUB(dev);
+    ss->size = size;
+    ss->mmio_name = g_strdup(name);
+    s = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(s, &error_fatal);
+    sysbus_mmio_map(s, 0, addr);
+
+    return dev;
+}
+
+static uint64_t pf_a133_mmio_stub_read(void *opaque, hwaddr offset,
+                                       unsigned size)
+{
+    PfA133MmioStubState *s = opaque;
+    uint64_t val = 0;
+
+    if (offset + size > s->size) {
+        return 0;
+    }
+    memcpy(&val, s->storage + offset, size);
+    return val;
+}
+
+static void pf_a133_mmio_stub_write(void *opaque, hwaddr offset,
+                                    uint64_t value, unsigned size)
+{
+    PfA133MmioStubState *s = opaque;
+
+    if (offset + size > s->size) {
+        return;
+    }
+    memcpy(s->storage + offset, &value, size);
+}
+
+static const MemoryRegionOps pf_a133_mmio_stub_ops = {
+    .read = pf_a133_mmio_stub_read,
+    .write = pf_a133_mmio_stub_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 8,
+    .impl.min_access_size = 1,
+    .impl.max_access_size = 8,
+};
+
+static void pf_a133_mmio_stub_reset(DeviceState *dev)
+{
+    PfA133MmioStubState *s = POCKETFORGE_A133_MMIO_STUB(dev);
+
+    memset(s->storage, 0, s->size);
+}
+
+static void pf_a133_mmio_stub_realize(DeviceState *dev, Error **errp)
+{
+    PfA133MmioStubState *s = POCKETFORGE_A133_MMIO_STUB(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    if (s->size == 0) {
+        error_setg(errp, "pocketforge-a133-mmio-stub: size must be set "
+                         "before realize");
+        return;
+    }
+
+    s->storage = g_malloc0(s->size);
+    memory_region_init_io(&s->iomem, OBJECT(s), &pf_a133_mmio_stub_ops, s,
+                          s->mmio_name ? s->mmio_name
+                                       : TYPE_POCKETFORGE_A133_MMIO_STUB,
+                          s->size);
+    sysbus_init_mmio(sbd, &s->iomem);
+}
+
+static void pf_a133_mmio_stub_unrealize(DeviceState *dev)
+{
+    PfA133MmioStubState *s = POCKETFORGE_A133_MMIO_STUB(dev);
+
+    g_free(s->storage);
+    s->storage = NULL;
+    g_free(s->mmio_name);
+    s->mmio_name = NULL;
+}
+
+static void pf_a133_mmio_stub_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = pf_a133_mmio_stub_realize;
+    dc->unrealize = pf_a133_mmio_stub_unrealize;
+    dc->reset = pf_a133_mmio_stub_reset;
+    /* Internal wiring only (machine-instantiated); no user-creatable bus. */
+    dc->user_creatable = false;
+}
+
+static const TypeInfo pf_a133_mmio_stub_info = {
+    .name          = TYPE_POCKETFORGE_A133_MMIO_STUB,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(PfA133MmioStubState),
+    .class_init    = pf_a133_mmio_stub_class_init,
+};
+
+static void pf_a133_mmio_stub_register_types(void)
+{
+    type_register_static(&pf_a133_mmio_stub_info);
+}
+
+type_init(pf_a133_mmio_stub_register_types)
