@@ -0,0 +1,69 @@
+/*
+ * Synopsys DesignWare APB UART ("snps,dw-apb-uart") emulation
+ *
+ * PocketForge OS addition (qemu-tsp fork): this IP is the real console UART
+ * on the Allwinner A133 (sun50i-a100 family) -- NOT PL011. It is register-
+ * compatible with a 16550A for the first 8 registers (index 0-7, DLAB-banked
+ * like any 8250 clone) but adds DesignWare-specific status/control registers
+ * above that, most importantly the UART Status Register (USR) at register
+ * index 0x1f (byte offset 0x7c when reg-shift=2 / reg-io-width=4, exactly as
+ * the real device tree declares it). USR bit1 (UART_USR_TFNF, "transmit FIFO
+ * not full") and bit2 (UART_USR_TFE, "transmit FIFO empty") are read by the
+ * upstream 8250_dw runtime driver (drivers/tty/serial/8250/8250_dw.c) during
+ * probe/IRQ handling; leaving USR unbacked is the exact silent-hang footgun
+ * infra-104's 2026-07-26 scoping pass flagged for this bring-up.
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms and conditions of the GNU General Public License,
+ * version 2 or later, as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef HW_DW_APB_UART_H
+#define HW_DW_APB_UART_H
+
+#include "hw/sysbus.h"
+#include "chardev/char-fe.h"
+#include "qom/object.h"
+
+#define TYPE_DW_APB_UART "dw-apb-uart"
+OBJECT_DECLARE_SIMPLE_TYPE(DWApbUartState, DW_APB_UART)
+
+/* Depth of the emulated receive FIFO (real IP is usually 16 or 64 deep). */
+#define DW_APB_UART_FIFO_DEPTH 16
+
+struct DWApbUartState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+
+    /* 8250-compatible core registers (register index, not byte offset). */
+    uint8_t ier;
+    uint8_t iir;
+    uint8_t fcr;
+    uint8_t lcr;
+    uint8_t mcr;
+    uint8_t lsr;
+    uint8_t msr;
+    uint8_t scr;
+    uint8_t dll;
+    uint8_t dlm;
+
+    uint8_t read_fifo[DW_APB_UART_FIFO_DEPTH];
+    int read_pos;
+    int read_count;
+
+    CharBackend chr;
+    qemu_irq irq;
+};
+
+DeviceState *dw_apb_uart_create(hwaddr addr, qemu_irq irq, Chardev *chr);
+
+#endif /* HW_DW_APB_UART_H */
