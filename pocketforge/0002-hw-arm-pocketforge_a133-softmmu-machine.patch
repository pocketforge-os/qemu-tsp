diff --git a/hw/char/dw_apb_uart.c b/hw/char/dw_apb_uart.c
new file mode 100644
index 0000000..2f69f17
--- /dev/null
+++ b/hw/char/dw_apb_uart.c
@@ -0,0 +1,374 @@
+/*
+ * Synopsys DesignWare APB UART ("snps,dw-apb-uart") emulation
+ *
+ * PocketForge OS addition (qemu-tsp fork), tsp-mc9m.41.925.2.1.
+ *
+ * Register-compatible with a 16550A for the first 8 (DLAB-banked) registers;
+ * this model adds the DesignWare UART Status Register (USR) at register
+ * index 0x1f, byte offset 0x7c with reg-shift=2/reg-io-width=4 (matching the
+ * real sun50i-a100.dtsi uart0 node exactly). USR is what the upstream
+ * 8250_dw driver polls for busy/FIFO status; the TX path here is modeled as
+ * an instantaneous sink (each THR write is flushed straight to the chardev
+ * backend, like hw/char/pl011.c's UARTDR write), so USR always reports
+ * "not busy, TX FIFO empty" -- this is deliberately conservative: readers
+ * that spin on USR bit1 (TFNF) or bit2 (TFE) before writing/reconfiguring
+ * see them permanently set rather than the unbounded silent hang infra-104
+ * named as this bring-up's #1 footgun.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/char/dw_apb_uart.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "migration/vmstate.h"
+#include "chardev/char-fe.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+DeviceState *dw_apb_uart_create(hwaddr addr, qemu_irq irq, Chardev *chr)
+{
+    DeviceState *dev;
+    SysBusDevice *s;
+
+    dev = qdev_new(TYPE_DW_APB_UART);
+    s = SYS_BUS_DEVICE(dev);
+    qdev_prop_set_chr(dev, "chardev", chr);
+    sysbus_realize_and_unref(s, &error_fatal);
+    sysbus_mmio_map(s, 0, addr);
+    sysbus_connect_irq(s, 0, irq);
+
+    return dev;
+}
+
+/* 8250-compatible register indices (offset = index << 2, reg-shift=2). */
+#define DW_UART_REG_RBR_THR_DLL  0x00
+#define DW_UART_REG_IER_DLM      0x01
+#define DW_UART_REG_IIR_FCR      0x02
+#define DW_UART_REG_LCR          0x03
+#define DW_UART_REG_MCR          0x04
+#define DW_UART_REG_LSR          0x05
+#define DW_UART_REG_MSR          0x06
+#define DW_UART_REG_SCR          0x07
+#define DW_UART_REG_USR          0x1f  /* DesignWare-specific */
+
+#define DW_UART_MMIO_SIZE        0x100 /* covers every DT-declared offset */
+
+/* LCR */
+#define UART_LCR_DLAB   0x80
+
+/* IER */
+#define UART_IER_RDI    0x01 /* enable "receiver data available" irq */
+#define UART_IER_THRI   0x02 /* enable "THR empty" irq */
+
+/* IIR */
+#define UART_IIR_NO_INT 0x01
+#define UART_IIR_THRI   0x02
+#define UART_IIR_RDI    0x04
+
+/* LSR */
+#define UART_LSR_DR     0x01 /* receiver data ready */
+#define UART_LSR_THRE   0x20 /* transmit holding register empty */
+#define UART_LSR_TEMT   0x40 /* transmitter (+shift reg) empty */
+
+/* MSR -- report a permanently "cable connected" loopback-free link so
+ * nothing that gates on modem status (CTS/DSR/DCD) wedges waiting for it. */
+#define UART_MSR_DEFAULT (0x80 | 0x20 | 0x10) /* DCD | DSR | CTS */
+
+/* USR (UART Status Register) -- the offset-0x7c register infra-104 flagged.
+ * bit0 UART_BUSY, bit1 TFNF (TX FIFO not full), bit2 TFE (TX FIFO empty),
+ * bit3 RFNE (RX FIFO not empty), bit4 RFF (RX FIFO full). */
+#define DW_UART_USR_BUSY 0x01
+#define DW_UART_USR_TFNF 0x02
+#define DW_UART_USR_TFE  0x04
+#define DW_UART_USR_RFNE 0x08
+#define DW_UART_USR_RFF  0x10
+
+static void dw_apb_uart_update_irq(DWApbUartState *s)
+{
+    bool pending = false;
+
+    if ((s->ier & UART_IER_RDI) && (s->lsr & UART_LSR_DR)) {
+        pending = true;
+    }
+    if ((s->ier & UART_IER_THRI) && (s->lsr & UART_LSR_THRE)) {
+        pending = true;
+    }
+
+    s->iir = pending
+        ? ((s->ier & UART_IER_RDI) && (s->lsr & UART_LSR_DR)
+           ? UART_IIR_RDI : UART_IIR_THRI)
+        : UART_IIR_NO_INT;
+
+    qemu_set_irq(s->irq, pending);
+}
+
+static void dw_apb_uart_update_lsr(DWApbUartState *s)
+{
+    /* TX is modeled as an instantaneous sink -- always empty. */
+    s->lsr = UART_LSR_THRE | UART_LSR_TEMT;
+    if (s->read_count > 0) {
+        s->lsr |= UART_LSR_DR;
+    }
+}
+
+static uint64_t dw_apb_uart_read(void *opaque, hwaddr offset, unsigned size)
+{
+    DWApbUartState *s = opaque;
+    uint64_t r = 0;
+
+    switch (offset >> 2) {
+    case DW_UART_REG_RBR_THR_DLL:
+        if (s->lcr & UART_LCR_DLAB) {
+            r = s->dll;
+            break;
+        }
+        if (s->read_count > 0) {
+            r = s->read_fifo[s->read_pos];
+            s->read_pos = (s->read_pos + 1) % DW_APB_UART_FIFO_DEPTH;
+            s->read_count--;
+            dw_apb_uart_update_lsr(s);
+            dw_apb_uart_update_irq(s);
+            qemu_chr_fe_accept_input(&s->chr);
+        }
+        break;
+    case DW_UART_REG_IER_DLM:
+        r = (s->lcr & UART_LCR_DLAB) ? s->dlm : s->ier;
+        break;
+    case DW_UART_REG_IIR_FCR:
+        r = s->iir | 0xc0; /* report FIFOs enabled/functioning */
+        break;
+    case DW_UART_REG_LCR:
+        r = s->lcr;
+        break;
+    case DW_UART_REG_MCR:
+        r = s->mcr;
+        break;
+    case DW_UART_REG_LSR:
+        r = s->lsr;
+        break;
+    case DW_UART_REG_MSR:
+        r = s->msr;
+        break;
+    case DW_UART_REG_SCR:
+        r = s->scr;
+        break;
+    case DW_UART_REG_USR:
+        r = DW_UART_USR_TFNF | DW_UART_USR_TFE;
+        if (s->read_count > 0) {
+            r |= DW_UART_USR_RFNE;
+        }
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP,
+                      "dw-apb-uart: unimplemented read reg 0x%02x\n",
+                      (unsigned)(offset >> 2));
+        break;
+    }
+
+    return r;
+}
+
+static void dw_apb_uart_write(void *opaque, hwaddr offset,
+                              uint64_t value, unsigned size)
+{
+    DWApbUartState *s = opaque;
+    unsigned char ch;
+
+    switch (offset >> 2) {
+    case DW_UART_REG_RBR_THR_DLL:
+        if (s->lcr & UART_LCR_DLAB) {
+            s->dll = value;
+            break;
+        }
+        ch = value;
+        /* Synchronous flush, matching hw/char/pl011.c's UARTDR write. */
+        qemu_chr_fe_write_all(&s->chr, &ch, 1);
+        dw_apb_uart_update_lsr(s);
+        dw_apb_uart_update_irq(s);
+        break;
+    case DW_UART_REG_IER_DLM:
+        if (s->lcr & UART_LCR_DLAB) {
+            s->dlm = value;
+        } else {
+            s->ier = value & 0x0f;
+            dw_apb_uart_update_irq(s);
+        }
+        break;
+    case DW_UART_REG_IIR_FCR:
+        s->fcr = value;
+        if (value & 0x02) { /* XFR: reset xmit FIFO -- nothing buffered */
+        }
+        if (value & 0x04) { /* RFR: reset recv FIFO */
+            s->read_pos = 0;
+            s->read_count = 0;
+            dw_apb_uart_update_lsr(s);
+            /*
+             * If an RDI interrupt was asserted before the reset, LSR.DR
+             * just cleared but iir/the physical IRQ line were never
+             * recomputed -- recompute here or a pending RDI would latch
+             * high forever (Codex review, tsp-mc9m.41.925.2.1 round 1).
+             */
+            dw_apb_uart_update_irq(s);
+        }
+        break;
+    case DW_UART_REG_LCR:
+        s->lcr = value;
+        break;
+    case DW_UART_REG_MCR:
+        s->mcr = value;
+        break;
+    case DW_UART_REG_LSR:
+    case DW_UART_REG_MSR:
+        /* Read-only in the real IP; writes are ignored. */
+        break;
+    case DW_UART_REG_SCR:
+        s->scr = value;
+        break;
+    case DW_UART_REG_USR:
+        /* Read-only status register; writes are ignored. */
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP,
+                      "dw-apb-uart: unimplemented write reg 0x%02x\n",
+                      (unsigned)(offset >> 2));
+        break;
+    }
+}
+
+static int dw_apb_uart_can_receive(void *opaque)
+{
+    DWApbUartState *s = opaque;
+
+    return s->read_count < DW_APB_UART_FIFO_DEPTH;
+}
+
+static void dw_apb_uart_receive(void *opaque, const uint8_t *buf, int size)
+{
+    DWApbUartState *s = opaque;
+    int slot;
+
+    if (s->read_count >= DW_APB_UART_FIFO_DEPTH) {
+        return;
+    }
+    slot = (s->read_pos + s->read_count) % DW_APB_UART_FIFO_DEPTH;
+    s->read_fifo[slot] = buf[0];
+    s->read_count++;
+    dw_apb_uart_update_lsr(s);
+    dw_apb_uart_update_irq(s);
+}
+
+static void dw_apb_uart_event(void *opaque, QEMUChrEvent event)
+{
+    /* Break/other chardev events: nothing DW-specific to model for boot. */
+}
+
+static const MemoryRegionOps dw_apb_uart_ops = {
+    .read = dw_apb_uart_read,
+    .write = dw_apb_uart_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static void dw_apb_uart_reset(DeviceState *dev)
+{
+    DWApbUartState *s = DW_APB_UART(dev);
+
+    s->ier = 0;
+    s->iir = UART_IIR_NO_INT;
+    s->fcr = 0;
+    s->lcr = 0;
+    s->mcr = 0;
+    s->msr = UART_MSR_DEFAULT;
+    s->scr = 0;
+    s->dll = 0;
+    s->dlm = 0;
+    s->read_pos = 0;
+    s->read_count = 0;
+    dw_apb_uart_update_lsr(s);
+    /*
+     * ier is cleared above, so this recomputes pending=false and drives
+     * the GIC input low -- without it, a reset while RDI/THRI was
+     * asserted would leave the physical IRQ line stuck high (Codex
+     * review, tsp-mc9m.41.925.2.1 round 1).
+     */
+    dw_apb_uart_update_irq(s);
+}
+
+static void dw_apb_uart_realize(DeviceState *dev, Error **errp)
+{
+    DWApbUartState *s = DW_APB_UART(dev);
+
+    qemu_chr_fe_set_handlers(&s->chr, dw_apb_uart_can_receive,
+                             dw_apb_uart_receive, dw_apb_uart_event,
+                             NULL, s, NULL, true);
+}
+
+static void dw_apb_uart_init(Object *obj)
+{
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    DWApbUartState *s = DW_APB_UART(obj);
+
+    memory_region_init_io(&s->iomem, OBJECT(s), &dw_apb_uart_ops, s,
+                          TYPE_DW_APB_UART, DW_UART_MMIO_SIZE);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static const VMStateDescription vmstate_dw_apb_uart = {
+    .name = TYPE_DW_APB_UART,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT8(ier, DWApbUartState),
+        VMSTATE_UINT8(iir, DWApbUartState),
+        VMSTATE_UINT8(fcr, DWApbUartState),
+        VMSTATE_UINT8(lcr, DWApbUartState),
+        VMSTATE_UINT8(mcr, DWApbUartState),
+        VMSTATE_UINT8(lsr, DWApbUartState),
+        VMSTATE_UINT8(msr, DWApbUartState),
+        VMSTATE_UINT8(scr, DWApbUartState),
+        VMSTATE_UINT8(dll, DWApbUartState),
+        VMSTATE_UINT8(dlm, DWApbUartState),
+        VMSTATE_UINT8_ARRAY(read_fifo, DWApbUartState, DW_APB_UART_FIFO_DEPTH),
+        VMSTATE_INT32(read_pos, DWApbUartState),
+        VMSTATE_INT32(read_count, DWApbUartState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static Property dw_apb_uart_properties[] = {
+    DEFINE_PROP_CHR("chardev", DWApbUartState, chr),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void dw_apb_uart_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = dw_apb_uart_realize;
+    dc->reset = dw_apb_uart_reset;
+    dc->vmsd = &vmstate_dw_apb_uart;
+    device_class_set_props(dc, dw_apb_uart_properties);
+}
+
+static const TypeInfo dw_apb_uart_info = {
+    .name          = TYPE_DW_APB_UART,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(DWApbUartState),
+    .instance_init = dw_apb_uart_init,
+    .class_init    = dw_apb_uart_class_init,
+};
+
+static void dw_apb_uart_register_types(void)
+{
+    type_register_static(&dw_apb_uart_info);
+}
