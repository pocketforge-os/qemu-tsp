diff --git a/hw/arm/pocketforge_a133.c b/hw/arm/pocketforge_a133.c
new file mode 100644
index 0000000..aa1d63c
--- /dev/null
+++ b/hw/arm/pocketforge_a133.c
@@ -0,0 +1,196 @@
+/*
+ * PocketForge OS -M pocketforge-a133 QEMU softmmu machine
+ *
+ * From-scratch board model for the Allwinner A133 (sun50i-a100 family, as
+ * used on the TrimUI Smart Pro base unit) added to qemu-tsp, PocketForge's
+ * fork of upstream qemu-user (v8.2.2 pin). Phase A of Odyssey L3 deliverable
+ * -2 (tsp-mc9m.41.925.2.1): the KEYSTONE piece that boots our real kernel +
+ * real committed device tree to earlycon output. Upstream QEMU has never
+ * carried a sun50i (64-bit Allwinner) board -- only the 32-bit A10/H3/R40
+ * families -- so this is a genuinely new machine model, not an extension of
+ * an existing one.
+ *
+ * Modeled (generic, already correct in QEMU): 4x Cortex-A53, GIC-400
+ * (GICv2 + virtualization extensions, exactly matching the real DT's 4
+ * register regions), the ARM generic architected timer, and QEMU's internal
+ * PSCI/SMC conduit (brings up secondary CPUs and absorbs vendor SiP SMC
+ * calls with no firmware image required).
+ *
+ * Modeled (new work, the keystone): the DW-APB UART0 console
+ * (hw/char/dw_apb_uart.c) at the exact address/IRQ the real DT declares.
+ *
+ * Deliberately NOT modeled in Phase A (later phases, see
+ * tsp-mc9m.41.925.2's phased plan): CCU/R-CCU/pinctrl/watchdog stubs
+ * (Phase B), virtio-gpu/input graft (Phase C), CI wiring (Phase D). A boot
+ * that reaches earlycon output and then hangs at clock/pinctrl probe is the
+ * EXPECTED and CORRECT Phase-A outcome -- that hang is Phase B's job.
+ *
+ * The real, unmodified sun50i-a133-pocketforge-tsp.dtb is loaded verbatim
+ * via -dtb; this machine does not synthesize or auto-generate a device
+ * tree (unlike -M virt). QEMU's own arm_load_kernel()/load_dtb() still
+ * performs the same routine /memory + /chosen(bootargs, initrd) fixups any
+ * real bootloader (e.g. our U-Boot) would apply -- that is not DT
+ * synthesis, it is standard boot-time DT preparation.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qapi/error.h"
+#include "cpu.h"
+#include "hw/arm/boot.h"
+#include "hw/arm/bsa.h"
+#include "hw/boards.h"
+#include "hw/char/dw_apb_uart.h"
+#include "hw/intc/arm_gic.h"
+#include "hw/intc/arm_gic_common.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "exec/address-spaces.h"
+#include "sysemu/sysemu.h"
+#include "qemu/module.h"
+#include "chardev/char.h"
+
+/*
+ * Addresses/IRQ taken verbatim from the real device tree
+ * (arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi, kernel-sunxi-6.x
+ * @ device/a133): the "gic" and "uart0" nodes.
+ */
+#define PF_A133_GIC_DIST_BASE   0x03021000
+#define PF_A133_GIC_CPU_BASE    0x03022000
+#define PF_A133_GIC_HYP_BASE    0x03024000
+#define PF_A133_GIC_VCPU_BASE   0x03026000
+
+#define PF_A133_UART0_BASE      0x05000000
+#define PF_A133_UART0_IRQ       0 /* GIC_SPI 0 */
+
+#define PF_A133_RAM_BASE        0x40000000
+
+#define PF_A133_NUM_CPUS        4
+#define PF_A133_NUM_SPI         224 /* real DT's highest GIC_SPI is 143 */
+
+static void pocketforge_a133_create_gic(MachineState *machine, qemu_irq *pic)
+{
+    DeviceState *gicdev;
+    SysBusDevice *gicbusdev;
+    int i;
+
+    gicdev = qdev_new(gic_class_name());
+    qdev_prop_set_uint32(gicdev, "revision", 2);
+    qdev_prop_set_uint32(gicdev, "num-cpu", PF_A133_NUM_CPUS);
+    qdev_prop_set_uint32(gicdev, "num-irq", PF_A133_NUM_SPI + 32);
+    qdev_prop_set_bit(gicdev, "has-security-extensions", false);
+    qdev_prop_set_bit(gicdev, "has-virtualization-extensions", true);
+
+    gicbusdev = SYS_BUS_DEVICE(gicdev);
+    sysbus_realize_and_unref(gicbusdev, &error_fatal);
+    sysbus_mmio_map(gicbusdev, 0, PF_A133_GIC_DIST_BASE);
+    sysbus_mmio_map(gicbusdev, 1, PF_A133_GIC_CPU_BASE);
+    sysbus_mmio_map(gicbusdev, 2, PF_A133_GIC_HYP_BASE);
+    sysbus_mmio_map(gicbusdev, 3, PF_A133_GIC_VCPU_BASE);
+
+    /*
+     * Wire each CPU's architected-timer outputs to its banked GIC PPI
+     * inputs. The PPI numbers below (13/14/11/10, i.e. the BSA constants)
+     * are the ARM-architecture-mandated assignment -- they are what the
+     * real DT's "timer" node uses too, so this wiring matches real
+     * hardware exactly, not just -M virt convention.
+     */
+    for (i = 0; i < PF_A133_NUM_CPUS; i++) {
+        DeviceState *cpudev = DEVICE(qemu_get_cpu(i));
+        int intidbase = PF_A133_NUM_SPI + i * GIC_INTERNAL;
+        const int timer_irq[] = {
+            [GTIMER_PHYS] = ARCH_TIMER_NS_EL1_IRQ,
+            [GTIMER_VIRT] = ARCH_TIMER_VIRT_IRQ,
+            [GTIMER_HYP]  = ARCH_TIMER_NS_EL2_IRQ,
+            [GTIMER_SEC]  = ARCH_TIMER_S_EL1_IRQ,
+        };
+        unsigned irq;
+
+        for (irq = 0; irq < ARRAY_SIZE(timer_irq); irq++) {
+            qdev_connect_gpio_out(cpudev, irq,
+                                  qdev_get_gpio_in(gicdev,
+                                                   intidbase + timer_irq[irq]));
+        }
+
+        sysbus_connect_irq(gicbusdev, i,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_IRQ));
+        sysbus_connect_irq(gicbusdev, i + PF_A133_NUM_CPUS,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_FIQ));
+        sysbus_connect_irq(gicbusdev, i + 2 * PF_A133_NUM_CPUS,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_VIRQ));
+        sysbus_connect_irq(gicbusdev, i + 3 * PF_A133_NUM_CPUS,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_VFIQ));
+    }
+
+    for (i = 0; i < PF_A133_NUM_SPI; i++) {
+        pic[i] = qdev_get_gpio_in(gicdev, i);
+    }
+}
+
+static void pocketforge_a133_init(MachineState *machine)
+{
+    MemoryRegion *sysmem = get_system_memory();
+    qemu_irq pic[PF_A133_NUM_SPI];
+    struct arm_boot_info *binfo = g_new0(struct arm_boot_info, 1);
+    int n;
+
+    for (n = 0; n < PF_A133_NUM_CPUS; n++) {
+        Object *cpuobj = object_new(machine->cpu_type);
+
+        /*
+         * No EL3 firmware exists in this boot flow: QEMU's own PSCI/SMC
+         * conduit (armed below via binfo->psci_conduit) intercepts SMC
+         * calls directly instead, which requires EL3 NOT be modeled.
+         */
+        object_property_set_bool(cpuobj, "has_el3", false, &error_fatal);
+
+        qdev_realize(DEVICE(cpuobj), NULL, &error_fatal);
+        object_unref(cpuobj);
+    }
+
+    /*
+     * machine->ram is already allocated by generic machine-core init from
+     * mc->default_ram_size/default_ram_id (or -m); do NOT also call
+     * memory_region_init_ram() here, or the reused default_ram_id string
+     * collides ("RAMBlock ... already registered, abort!").
+     */
+    memory_region_add_subregion(sysmem, PF_A133_RAM_BASE, machine->ram);
+
+    pocketforge_a133_create_gic(machine, pic);
+
+    dw_apb_uart_create(PF_A133_UART0_BASE, pic[PF_A133_UART0_IRQ],
+                       serial_hd(0));
+
+    binfo->ram_size = machine->ram_size;
+    binfo->board_id = -1; /* device-tree boot only, no ATAGS board id */
+    binfo->loader_start = PF_A133_RAM_BASE;
+    binfo->dtb_filename = machine->dtb;
+    binfo->psci_conduit = QEMU_PSCI_CONDUIT_SMC;
+    arm_load_kernel(ARM_CPU(first_cpu), machine, binfo);
+}
+
+static void pocketforge_a133_machine_init(MachineClass *mc)
+{
+    static const char * const valid_cpu_types[] = {
+        ARM_CPU_TYPE_NAME("cortex-a53"),
+        NULL
+    };
+
+    mc->desc = "PocketForge OS A133 fidelity-CI machine "
+               "(real kernel + real DT, DW-APB UART earlycon)";
+    mc->init = pocketforge_a133_init;
+    mc->max_cpus = PF_A133_NUM_CPUS;
+    mc->min_cpus = PF_A133_NUM_CPUS;
+    mc->default_cpus = PF_A133_NUM_CPUS;
+    mc->valid_cpu_types = valid_cpu_types;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("cortex-a53");
+    mc->default_ram_size = 1 * GiB;
+    mc->default_ram_id = "pocketforge-a133.ram";
+    mc->no_cdrom = true;
+    mc->no_floppy = true;
+    mc->no_parallel = true;
+}
+
+DEFINE_MACHINE("pocketforge-a133", pocketforge_a133_machine_init)
