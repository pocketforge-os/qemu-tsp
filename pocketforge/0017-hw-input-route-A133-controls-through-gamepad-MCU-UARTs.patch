diff --git a/hw/char/dw_apb_uart.c b/hw/char/dw_apb_uart.c
index b507f07..26a1239 100644
--- a/hw/char/dw_apb_uart.c
+++ b/hw/char/dw_apb_uart.c
@@ -115,6 +115,45 @@ static void dw_apb_uart_update_lsr(DWApbUartState *s)
     }
 }
 
+bool dw_apb_uart_is_configured(DWApbUartState *s)
+{
+    return !(s->lcr & UART_LCR_DLAB) && (s->lcr & 0x3f) == 0x03 &&
+           (s->dll || s->dlm);
+}
+
+size_t dw_apb_uart_receive_bytes(DWApbUartState *s,
+                                 const uint8_t *buf, size_t size)
+{
+    size_t accepted = 0;
+
+    while (accepted < size && s->read_count < DW_APB_UART_FIFO_DEPTH) {
+        int slot = (s->read_pos + s->read_count) % DW_APB_UART_FIFO_DEPTH;
+
+        s->read_fifo[slot] = buf[accepted++];
+        s->read_count++;
+    }
+    dw_apb_uart_update_lsr(s);
+    dw_apb_uart_update_irq(s);
+    return accepted;
+}
+
+void dw_apb_uart_set_rx_ready(DWApbUartState *s,
+                              DWApbUartRxReady callback, void *opaque)
+{
+    s->rx_ready = callback;
+    s->rx_ready_opaque = opaque;
+    if (callback) {
+        callback(opaque, false);
+    }
+}
+
+static void dw_apb_uart_notify_rx_ready(DWApbUartState *s, bool reset)
+{
+    if (s->rx_ready) {
+        s->rx_ready(s->rx_ready_opaque, reset);
+    }
+}
+
 static uint64_t dw_apb_uart_read(void *opaque, hwaddr offset, unsigned size)
 {
     DWApbUartState *s = opaque;
@@ -133,6 +172,7 @@ static uint64_t dw_apb_uart_read(void *opaque, hwaddr offset, unsigned size)
             dw_apb_uart_update_lsr(s);
             dw_apb_uart_update_irq(s);
             qemu_chr_fe_accept_input(&s->chr);
+            dw_apb_uart_notify_rx_ready(s, false);
         }
         break;
     case DW_UART_REG_IER_DLM:
@@ -182,6 +222,7 @@ static void dw_apb_uart_write(void *opaque, hwaddr offset,
     case DW_UART_REG_RBR_THR_DLL:
         if (s->lcr & UART_LCR_DLAB) {
             s->dll = value;
+            dw_apb_uart_notify_rx_ready(s, false);
             break;
         }
         ch = value;
@@ -193,9 +234,11 @@ static void dw_apb_uart_write(void *opaque, hwaddr offset,
     case DW_UART_REG_IER_DLM:
         if (s->lcr & UART_LCR_DLAB) {
             s->dlm = value;
+            dw_apb_uart_notify_rx_ready(s, false);
         } else {
             s->ier = value & 0x0f;
             dw_apb_uart_update_irq(s);
+            dw_apb_uart_notify_rx_ready(s, false);
         }
         break;
     case DW_UART_REG_IIR_FCR:
@@ -219,12 +262,14 @@ static void dw_apb_uart_write(void *opaque, hwaddr offset,
              * high forever (Codex review, tsp-mc9m.41.925.2.1 round 1).
              */
             dw_apb_uart_update_irq(s);
+            dw_apb_uart_notify_rx_ready(s, true);
         }
         if (value & 0x04) { /* XFIFOR: reset transmit FIFO -- nothing buffered */
         }
         break;
     case DW_UART_REG_LCR:
         s->lcr = value;
+        dw_apb_uart_notify_rx_ready(s, false);
         break;
     case DW_UART_REG_MCR:
         s->mcr = value;
@@ -257,16 +302,8 @@ static int dw_apb_uart_can_receive(void *opaque)
 static void dw_apb_uart_receive(void *opaque, const uint8_t *buf, int size)
 {
     DWApbUartState *s = opaque;
-    int slot;
 
-    if (s->read_count >= DW_APB_UART_FIFO_DEPTH) {
-        return;
-    }
-    slot = (s->read_pos + s->read_count) % DW_APB_UART_FIFO_DEPTH;
-    s->read_fifo[slot] = buf[0];
-    s->read_count++;
-    dw_apb_uart_update_lsr(s);
-    dw_apb_uart_update_irq(s);
+    dw_apb_uart_receive_bytes(s, buf, size);
 }
 
 static void dw_apb_uart_event(void *opaque, QEMUChrEvent event)
@@ -307,6 +344,7 @@ static void dw_apb_uart_reset(DeviceState *dev)
      * review, tsp-mc9m.41.925.2.1 round 1).
      */
     dw_apb_uart_update_irq(s);
+    dw_apb_uart_notify_rx_ready(s, true);
 }
 
