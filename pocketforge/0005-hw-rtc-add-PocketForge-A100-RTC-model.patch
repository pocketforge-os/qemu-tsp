+/*
+ * PocketForge A100/A133 RTC clock-control model
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_RTC_POCKETFORGE_A100_RTC_H
+#define HW_RTC_POCKETFORGE_A100_RTC_H
+
+#include "hw/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_POCKETFORGE_A100_RTC "pocketforge-a100-rtc"
+OBJECT_DECLARE_SIMPLE_TYPE(PocketForgeA100RtcState, POCKETFORGE_A100_RTC)
+
+#define POCKETFORGE_A100_RTC_MMIO_SIZE 0x400
+
+struct PocketForgeA100RtcState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint32_t losc_ctrl;
+    uint32_t iosc_32k_clk_div;
+    uint32_t iosc_clk_cali;
+    uint32_t losc_out_gating;
+    uint32_t dcxo_ctrl;
+};
+
+DeviceState *pocketforge_a100_rtc_create(hwaddr addr);
+
+#endif /* HW_RTC_POCKETFORGE_A100_RTC_H */
