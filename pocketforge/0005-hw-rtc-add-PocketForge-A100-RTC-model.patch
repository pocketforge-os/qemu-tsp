diff --git a/hw/rtc/pocketforge_a100_rtc.c b/hw/rtc/pocketforge_a100_rtc.c
new file mode 100644
index 0000000..587a4f3
--- /dev/null
+++ b/hw/rtc/pocketforge_a100_rtc.c
@@ -0,0 +1,150 @@
+/*
+ * PocketForge A100/A133 RTC clock-control model
+ *
+ * This intentionally models only the clock-control registers used by the
+ * pinned Linux sun6i RTC CCU driver.  The rest of the exact 0x400-byte RTC
+ * aperture is read-as-zero/write-ignored.  In particular, this is not a
+ * timekeeping or alarm implementation.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/rtc/pocketforge_a100_rtc.h"
+#include "qapi/error.h"
+#include "qemu/bitops.h"
+#include "qemu/module.h"
+
+#define RTC_LOSC_CTRL          0x000
+#define RTC_IOSC_32K_CLK_DIV   0x008
+#define RTC_IOSC_CLK_CALI      0x00c
+#define RTC_LOSC_OUT_GATING    0x060
+#define RTC_DCXO_CTRL          0x160
+
+#define RTC_LOSC_CTRL_KEY      0x16aa0000
+#define RTC_LOSC_CTRL_KEY_MASK 0xffff0000
+#define RTC_LOSC_CTRL_MASK     (BIT(0) | BIT(1) | BIT(4))
+#define RTC_IOSC_DIV_MASK      0x1f
+#define RTC_LOSC_OUT_MASK      (BIT(0) | (0x3 << 1) | BIT(16))
+#define RTC_DCXO_CTRL_MASK     BIT(0)
+
+DeviceState *pocketforge_a100_rtc_create(hwaddr addr)
+{
+    DeviceState *dev = qdev_new(TYPE_POCKETFORGE_A100_RTC);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, addr);
+
+    return dev;
+}
+
+static uint64_t pocketforge_a100_rtc_read(void *opaque, hwaddr offset,
+                                          unsigned size)
+{
+    PocketForgeA100RtcState *s = opaque;
+
+    (void)size;
+
+    switch (offset) {
+    case RTC_LOSC_CTRL:
+        /* The write key is never observable on reads. */
+        return s->losc_ctrl;
+    case RTC_IOSC_32K_CLK_DIV:
+        return s->iosc_32k_clk_div;
+    case RTC_IOSC_CLK_CALI:
+        return s->iosc_clk_cali;
+    case RTC_LOSC_OUT_GATING:
+        return s->losc_out_gating;
+    case RTC_DCXO_CTRL:
+        return s->dcxo_ctrl;
+    default:
+        return 0;
+    }
+}
+
+static void pocketforge_a100_rtc_write(void *opaque, hwaddr offset,
+                                       uint64_t value, unsigned size)
+{
+    PocketForgeA100RtcState *s = opaque;
+    uint32_t val = value;
+
+    (void)size;
+
+    switch (offset) {
+    case RTC_LOSC_CTRL:
+        if ((val & RTC_LOSC_CTRL_KEY_MASK) == RTC_LOSC_CTRL_KEY) {
+            s->losc_ctrl = val & RTC_LOSC_CTRL_MASK;
+        }
+        break;
+    case RTC_IOSC_32K_CLK_DIV:
+        s->iosc_32k_clk_div = val & RTC_IOSC_DIV_MASK;
+        break;
+    case RTC_IOSC_CLK_CALI:
+        s->iosc_clk_cali = val;
+        break;
+    case RTC_LOSC_OUT_GATING:
+        s->losc_out_gating = val & RTC_LOSC_OUT_MASK;
+        break;
+    case RTC_DCXO_CTRL:
+        s->dcxo_ctrl = val & RTC_DCXO_CTRL_MASK;
+        break;
+    default:
+        break;
+    }
+}
+
+static const MemoryRegionOps pocketforge_a100_rtc_ops = {
+    .read = pocketforge_a100_rtc_read,
+    .write = pocketforge_a100_rtc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static void pocketforge_a100_rtc_reset(DeviceState *dev)
+{
+    PocketForgeA100RtcState *s = POCKETFORGE_A100_RTC(dev);
+
+    s->losc_ctrl = 0;
+    s->iosc_32k_clk_div = 0;
+    s->iosc_clk_cali = 0;
+    s->losc_out_gating = 0;
+    s->dcxo_ctrl = 0;
+}
+
+static void pocketforge_a100_rtc_init(Object *obj)
+{
+    PocketForgeA100RtcState *s = POCKETFORGE_A100_RTC(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &pocketforge_a100_rtc_ops, s,
+                          TYPE_POCKETFORGE_A100_RTC,
+                          POCKETFORGE_A100_RTC_MMIO_SIZE);
+    sysbus_init_mmio(sbd, &s->iomem);
+}
+
+static void pocketforge_a100_rtc_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->reset = pocketforge_a100_rtc_reset;
+    dc->user_creatable = false;
+}
+
+static const TypeInfo pocketforge_a100_rtc_info = {
+    .name = TYPE_POCKETFORGE_A100_RTC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(PocketForgeA100RtcState),
+    .instance_init = pocketforge_a100_rtc_init,
+    .class_init = pocketforge_a100_rtc_class_init,
+};
+
+static void pocketforge_a100_rtc_register_types(void)
+{
+    type_register_static(&pocketforge_a100_rtc_info);
+}
+
+type_init(pocketforge_a100_rtc_register_types)
