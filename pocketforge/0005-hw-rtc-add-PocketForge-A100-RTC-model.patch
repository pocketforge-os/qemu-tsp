diff --git a/tests/qtest/pocketforge-a100-rtc-test.c b/tests/qtest/pocketforge-a100-rtc-test.c
new file mode 100644
index 0000000..6e22c95
--- /dev/null
+++ b/tests/qtest/pocketforge-a100-rtc-test.c
@@ -0,0 +1,85 @@
+/*
+ * QTest coverage for the PocketForge A100/A133 RTC clock-control model
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+
+#define RTC_BASE              0x07000000
+#define RTC_SIZE              0x400
+#define RTC_LOSC_CTRL         0x000
+#define RTC_IOSC_32K_CLK_DIV  0x008
+#define RTC_IOSC_CLK_CALI     0x00c
+#define RTC_ALARM_COUNTER     0x020
+#define RTC_LOSC_OUT_GATING   0x060
+#define RTC_DCXO_CTRL         0x160
+
+static QTestState *rtc_start(void)
+{
+    return qtest_init("-machine pocketforge-a133 -nodefaults");
+}
+
+static void test_register_contract(void)
+{
+    QTestState *qts = rtc_start();
+
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_LOSC_CTRL), ==, 0);
+
+    /* LOSC_CTRL ignores keyless writes and never exposes its write key. */
+    qtest_writel(qts, RTC_BASE + RTC_LOSC_CTRL, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_LOSC_CTRL), ==, 0);
+    qtest_writel(qts, RTC_BASE + RTC_LOSC_CTRL, 0x16aa0013);
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_LOSC_CTRL), ==, 0x13);
+
+    qtest_writel(qts, RTC_BASE + RTC_IOSC_32K_CLK_DIV, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_IOSC_32K_CLK_DIV),
+                    ==, 0x1f);
+    qtest_writel(qts, RTC_BASE + RTC_IOSC_CLK_CALI, 0x81234567);
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_IOSC_CLK_CALI),
+                    ==, 0x81234567);
+    qtest_writel(qts, RTC_BASE + RTC_LOSC_OUT_GATING, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_LOSC_OUT_GATING),
+                    ==, 0x00010007);
+    qtest_writel(qts, RTC_BASE + RTC_DCXO_CTRL, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_DCXO_CTRL), ==, 1);
+
+    /* Alarm and every other unmodeled register are explicitly RAZ/WI. */
+    qtest_writel(qts, RTC_BASE + RTC_ALARM_COUNTER, 0xdeadbeef);
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_ALARM_COUNTER), ==, 0);
+    qtest_writel(qts, RTC_BASE + RTC_SIZE - 4, 0xdeadbeef);
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_SIZE - 4), ==, 0);
+
+    qtest_quit(qts);
+}
+
+static void test_reset_and_exact_extent(void)
+{
+    QTestState *qts = rtc_start();
+
+    qtest_writel(qts, RTC_BASE + RTC_IOSC_CLK_CALI, 0xa5a55a5a);
+
+    /* Adjacent unmapped writes must not alias into the exact 0x400 region. */
+    qtest_writel(qts, RTC_BASE - 4, 0xffffffff);
+    qtest_writel(qts, RTC_BASE + RTC_SIZE, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_IOSC_CLK_CALI),
+                    ==, 0xa5a55a5a);
+
+    qtest_qmp_assert_success(qts, "{ 'execute': 'system_reset' }");
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_cmphex(qtest_readl(qts, RTC_BASE + RTC_IOSC_CLK_CALI), ==, 0);
+
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/pocketforge-a100-rtc/register-contract",
+                   test_register_contract);
+    qtest_add_func("/pocketforge-a100-rtc/reset-and-exact-extent",
+                   test_reset_and_exact_extent);
+
+    return g_test_run();
+}
