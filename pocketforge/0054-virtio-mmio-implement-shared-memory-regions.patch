+/*
+ * Test device for transport-neutral virtio shared-memory regions
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/virtio/virtio.h"
+#include "standard-headers/linux/virtio_ids.h"
+
+#define TYPE_VIRTIO_SHMEM_TEST "virtio-shmem-test-device"
+OBJECT_DECLARE_SIMPLE_TYPE(VirtioShmemTest, VIRTIO_SHMEM_TEST)
+
+struct VirtioShmemTest {
+    VirtIODevice parent_obj;
+    uint64_t region_size;
+    uint8_t region_id;
+    bool duplicate_id;
+    MemoryRegion ram;
+    MemoryRegion *shmem;
+};
+
+static uint64_t virtio_shmem_test_get_features(VirtIODevice *vdev,
+                                                uint64_t features,
+                                                Error **errp)
+{
+    return features;
+}
+
+static void virtio_shmem_test_realize(DeviceState *dev, Error **errp)
+{
+    ERRP_GUARD();
+    VirtioShmemTest *s = VIRTIO_SHMEM_TEST(dev);
+    VirtIODevice *vdev = VIRTIO_DEVICE(dev);
+    VirtioSharedMemory *shmem;
+
+    /* Reuse a defined ID: the fixture only exercises transport state. */
+    virtio_init(vdev, VIRTIO_ID_RNG, 0);
+    shmem = virtio_new_shmem_region(vdev, s->region_id,
+                                    s->region_size, errp);
+    if (!shmem) {
+        virtio_cleanup(vdev);
+        return;
+    }
+    if (s->duplicate_id &&
+        !virtio_new_shmem_region(vdev, s->region_id,
+                                 s->region_size, errp)) {
+        virtio_cleanup(vdev);
+        return;
+    }
+
+    memory_region_init_ram(&s->ram, OBJECT(s), "virtio-shmem-test-ram",
+                           s->region_size, errp);
+    if (*errp) {
+        virtio_cleanup(vdev);
+        return;
+    }
+    memory_region_add_subregion(&shmem->mr, 0, &s->ram);
+    s->shmem = &shmem->mr;
+}
+
+static void virtio_shmem_test_unrealize(DeviceState *dev)
+{
+    VirtioShmemTest *s = VIRTIO_SHMEM_TEST(dev);
+
+    if (s->shmem) {
+        memory_region_del_subregion(s->shmem, &s->ram);
+        s->shmem = NULL;
+    }
+    virtio_cleanup(VIRTIO_DEVICE(dev));
+}
+
+static const Property virtio_shmem_test_properties[] = {
+    DEFINE_PROP_UINT64("region-size", VirtioShmemTest, region_size, 4096),
+    DEFINE_PROP_UINT8("region-id", VirtioShmemTest, region_id, 1),
+    DEFINE_PROP_BOOL("duplicate-id", VirtioShmemTest, duplicate_id, false),
+};
+
+static void virtio_shmem_test_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    VirtioDeviceClass *vdc = VIRTIO_DEVICE_CLASS(klass);
+
+    device_class_set_props(dc, virtio_shmem_test_properties);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+    vdc->realize = virtio_shmem_test_realize;
+    vdc->unrealize = virtio_shmem_test_unrealize;
+    vdc->get_features = virtio_shmem_test_get_features;
+}
+
+static const TypeInfo virtio_shmem_test_info = {
+    .name = TYPE_VIRTIO_SHMEM_TEST,
+    .parent = TYPE_VIRTIO_DEVICE,
+    .instance_size = sizeof(VirtioShmemTest),
+    .class_init = virtio_shmem_test_class_init,
+};
+
+static void virtio_shmem_test_register_types(void)
+{
+    type_register_static(&virtio_shmem_test_info);
+}
+
+type_init(virtio_shmem_test_register_types)
