+/*
+ * virtio-mmio shared-memory register tests
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include <glib/gstdio.h>
+#include "libqtest-single.h"
+#include "hw/pci/pci_regs.h"
+#include "qobject/qdict.h"
+#include "standard-headers/linux/virtio_ids.h"
+#include "standard-headers/linux/virtio_mmio.h"
+
+#define VIRT_MMIO_BASE 0x0a003e00
+#define GPU_HOSTMEM_SIZE (16 * 1024 * 1024)
+#define GPU_HOSTMEM_BASE 0x0e000000
+#define VIRT_PCIE_ECAM 0x4010000000ULL
+#define VIRT_GPU_PCI_CONFIG (VIRT_PCIE_ECAM + (1ULL << 15))
+
+#define GPU_ARGS "-M virt -cpu max -nodefaults -display none " \
+                 "-global virtio-mmio.force-legacy=false " \
+                 "-global virtio-mmio.shm-base=0x0e000000 " \
+                 "-device virtio-gpu-device,hostmem=16M"
+
+static void test_gpu_hostmem_registers(void)
+{
+    QTestState *qts;
+    g_autofree char *mtree = NULL;
+
+    qts = qtest_init(GPU_ARGS);
+
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_DEVICE_ID), ==,
+                    VIRTIO_ID_GPU);
+
+    qtest_writel(qts, VIRT_MMIO_BASE + VIRTIO_MMIO_SHM_SEL, 1);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_LOW), ==,
+                    GPU_HOSTMEM_SIZE);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_HIGH), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_BASE_LOW), ==,
+                    GPU_HOSTMEM_BASE);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_BASE_HIGH), ==, 0);
+    mtree = qtest_hmp(qts, "info mtree");
+    g_assert_nonnull(strstr(mtree,
+        "000000000e000000-000000000effffff (prio 0, i/o): "
+        "virtio-shmem-1"));
+
+    qtest_writel(qts, VIRT_MMIO_BASE + VIRTIO_MMIO_SHM_SEL, 2);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_LOW), ==,
+                    UINT32_MAX);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_HIGH), ==,
+                    UINT32_MAX);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_BASE_LOW), ==,
+                    UINT32_MAX);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_BASE_HIGH), ==,
+                    UINT32_MAX);
+
+    qtest_writel(qts, VIRT_MMIO_BASE + VIRTIO_MMIO_STATUS, 0);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_LOW), ==,
+                    UINT32_MAX);
+    qtest_writel(qts, VIRT_MMIO_BASE + VIRTIO_MMIO_SHM_SEL, 1);
+    g_assert_cmphex(qtest_readl(qts, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_LOW), ==,
+                    GPU_HOSTMEM_SIZE);
+
+    qtest_quit(qts);
+}
+
+static void test_shm_selector_migration(void)
+{
+    g_autoptr(GError) error = NULL;
+    g_autofree char *tmpdir = NULL;
+    g_autofree char *sock = NULL;
+    g_autofree char *uri = NULL;
+    QTestState *src;
+    QTestState *dst;
+    unsigned int i;
+
+    tmpdir = g_dir_make_tmp("virtio-mmio-shm.XXXXXX", &error);
+    g_assert_no_error(error);
+    sock = g_build_filename(tmpdir, "migration.sock", NULL);
+    uri = g_strdup_printf("unix:%s", sock);
+
+    src = qtest_init(GPU_ARGS);
+    dst = qtest_init(GPU_ARGS " -incoming defer");
+
+    g_assert_cmphex(qtest_readl(dst, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_LOW), ==,
+                    UINT32_MAX);
+    qtest_writel(src, VIRT_MMIO_BASE + VIRTIO_MMIO_SHM_SEL, 1);
+
+    qtest_qmp_assert_success(dst,
+        "{ 'execute': 'migrate-incoming', 'arguments': { 'uri': %s } }",
+        uri);
+    qtest_qmp_assert_success(src,
+        "{ 'execute': 'migrate', 'arguments': { 'uri': %s } }", uri);
+
+    for (i = 0; i < 500; i++) {
+        QDict *ret = qtest_qmp_assert_success_ref(
+            src, "{ 'execute': 'query-migrate' }");
+        const char *status = qdict_get_str(ret, "status");
+        bool completed = !strcmp(status, "completed");
+
+        g_assert_cmpstr(status, !=, "failed");
+        qobject_unref(ret);
+        if (completed) {
+            break;
+        }
+        g_usleep(10000);
+    }
+    g_assert_cmpuint(i, <, 500);
+    g_assert_cmphex(qtest_readl(dst, VIRT_MMIO_BASE +
+                                VIRTIO_MMIO_SHM_LEN_LOW), ==,
+                    GPU_HOSTMEM_SIZE);
+
+    qtest_quit(dst);
+    qtest_quit(src);
+    if (g_file_test(sock, G_FILE_TEST_EXISTS)) {
+        g_assert_cmpint(g_remove(sock), ==, 0);
+    }
+    g_assert_cmpint(g_rmdir(tmpdir), ==, 0);
+}
