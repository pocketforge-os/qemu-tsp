+static bool virtio_mmio_shmem_range_free(hwaddr base, uint64_t len,
+                                         Error **errp)
+{
+    MemoryRegion *sysmem = get_system_memory();
+
+    while (len) {
+        MemoryRegionSection section = memory_region_find(sysmem, base, len);
+        uint64_t size;
+
+        if (!section.mr) {
+            return true;
+        }
+        size = int128_get64(section.size);
+        if (memory_region_is_mapped(section.mr)) {
+            error_setg(errp, "virtio-mmio shared memory overlaps %s at "
+                       "0x%" HWADDR_PRIx,
+                       memory_region_name(section.mr), base);
+            memory_region_unref(section.mr);
+            return false;
+        }
+        memory_region_unref(section.mr);
+        if (!size) {
+            error_setg(errp, "cannot inspect virtio-mmio shared memory "
+                       "range at 0x%" HWADDR_PRIx, base);
+            return false;
+        }
+        base += size;
+        len -= size;
+    }
+    return true;
+}
+
+static void virtio_mmio_device_plugged(DeviceState *d, Error **errp)
+{
+    VirtIOMMIOProxy *proxy = VIRTIO_MMIO(d);
+    VirtIODevice *vdev = virtio_bus_get_device(&proxy->bus);
+    VirtioSharedMemory *shmem;
+    hwaddr addr = proxy->shm_base;
+    uint64_t total = 0;
+
+    if (QSIMPLEQ_EMPTY(&vdev->shmem_list)) {
+        return;
+    }
+    if (proxy->legacy) {
+        error_setg(errp, "virtio-mmio shared memory requires a modern device");
+        return;
+    }
+    if (addr == UINT64_MAX) {
+        error_setg(errp, "virtio-mmio shared memory requires shm-base");
+        return;
+    }
+    if (addr % qemu_real_host_page_size()) {
+        error_setg(errp, "virtio-mmio shm-base 0x%" HWADDR_PRIx
+                   " is not host-page aligned", addr);
+        return;
+    }
+
+    QSIMPLEQ_FOREACH(shmem, &vdev->shmem_list, entry) {
+        uint64_t size = memory_region_size(&shmem->mr);
+
+        if (size % qemu_real_host_page_size()) {
+            error_setg(errp, "virtio-mmio shared memory region %u size "
+                       "0x%" PRIx64 " is not host-page aligned",
+                       shmem->shmid, size);
+            return;
+        }
+        if (UINT64_MAX - total < size || UINT64_MAX - addr < total + size) {
+            error_setg(errp, "virtio-mmio shared memory range overflows");
+            return;
+        }
+        total += size;
+    }
+    if (!virtio_mmio_shmem_range_free(addr, total, errp)) {
+        return;
+    }
+
+    memory_region_transaction_begin();
+    QSIMPLEQ_FOREACH(shmem, &vdev->shmem_list, entry) {
+        memory_region_add_subregion(get_system_memory(), addr, &shmem->mr);
+        addr += memory_region_size(&shmem->mr);
+    }
+    memory_region_transaction_commit();
+    proxy->shm_mapped = true;
+}
+
+static void virtio_mmio_device_unplugged(DeviceState *d)
+{
+    VirtIOMMIOProxy *proxy = VIRTIO_MMIO(d);
+    VirtIODevice *vdev = virtio_bus_get_device(&proxy->bus);
+    VirtioSharedMemory *shmem;
+
+    if (!proxy->shm_mapped || !vdev) {
+        return;
+    }
+    memory_region_transaction_begin();
+    QSIMPLEQ_FOREACH(shmem, &vdev->shmem_list, entry) {
+        memory_region_del_subregion(get_system_memory(), &shmem->mr);
+    }
+    memory_region_transaction_commit();
+    proxy->shm_mapped = false;
+}
