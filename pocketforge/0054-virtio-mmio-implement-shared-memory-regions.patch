+static void test_gpu_pci_bar_unchanged(void)
+{
+    QTestState *qts;
+    uint32_t old_low;
+    uint32_t old_high;
+    uint32_t mask_low;
+    uint32_t mask_high;
+    uint64_t mask;
+    uint64_t size;
+
+    qts = qtest_init("-M virt -cpu max -nodefaults -display none "
+                     "-device virtio-gpu-pci,hostmem=16M");
+    old_low = qtest_readl(qts, VIRT_GPU_PCI_CONFIG + PCI_BASE_ADDRESS_4);
+    old_high = qtest_readl(qts, VIRT_GPU_PCI_CONFIG + PCI_BASE_ADDRESS_5);
+    qtest_writel(qts, VIRT_GPU_PCI_CONFIG + PCI_BASE_ADDRESS_4, UINT32_MAX);
+    qtest_writel(qts, VIRT_GPU_PCI_CONFIG + PCI_BASE_ADDRESS_5, UINT32_MAX);
+    mask_low = qtest_readl(qts, VIRT_GPU_PCI_CONFIG + PCI_BASE_ADDRESS_4);
+    mask_high = qtest_readl(qts, VIRT_GPU_PCI_CONFIG + PCI_BASE_ADDRESS_5);
+    qtest_writel(qts, VIRT_GPU_PCI_CONFIG + PCI_BASE_ADDRESS_4, old_low);
+    qtest_writel(qts, VIRT_GPU_PCI_CONFIG + PCI_BASE_ADDRESS_5, old_high);
+
+    g_assert_cmphex(mask_low & PCI_BASE_ADDRESS_MEM_TYPE_MASK, ==,
+                    PCI_BASE_ADDRESS_MEM_TYPE_64);
+    g_assert_cmphex(mask_low & PCI_BASE_ADDRESS_MEM_PREFETCH, ==,
+                    PCI_BASE_ADDRESS_MEM_PREFETCH);
+    mask = ((uint64_t)mask_high << 32) |
+           (mask_low & PCI_BASE_ADDRESS_MEM_MASK);
+    size = ~mask + 1;
+    g_assert_cmphex(size, ==, GPU_HOSTMEM_SIZE);
+    qtest_quit(qts);
+}
