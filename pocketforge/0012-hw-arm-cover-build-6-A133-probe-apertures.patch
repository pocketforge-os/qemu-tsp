     { "pocketforge-a133.musb",             0x05100000, 0x400 },
     { "pocketforge-a133.usbphy_ctrl",      0x05100400, 0x100 },
     { "pocketforge-a133.usbphy_pmu0",      0x05101800, 0x100 },
+    { "pocketforge-a133.ehci0",            0x05101000, 0x100 },
+    { "pocketforge-a133.ohci0",            0x05101400, 0x100 },
     { "pocketforge-a133.ehci1",            0x05200000, 0x100 },
     { "pocketforge-a133.ohci1",            0x05200400, 0x100 },
     { "pocketforge-a133.usbphy_pmu1",      0x05200800, 0x100 },
     { "pocketforge-a133.de2",              0x06000000, 0x400000 },
+    { "pocketforge-a133.g2d_clk",          0x06480000, 0x100 },
+    { "pocketforge-a133.g2d_rotate",       0x064a8000, 0x100 },
     { "pocketforge-a133.dsi",              0x06504000, 0x1000 },
     { "pocketforge-a133.dphy",             0x06505000, 0x1000 },
     { "pocketforge-a133.tcon_top",         0x06510000, 0x1000 },
